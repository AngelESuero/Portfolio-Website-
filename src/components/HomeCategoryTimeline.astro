---
import profile from '../data/profile';

type Project = {
  slug: string;
  data: {
    title: string;
    type?: string;
    year?: number | string;
  };
};

type Entry = {
  slug: string;
  data: {
    title: string;
    summary?: string;
    date?: string;
    medium?: string;
    type?: string;
    year?: number | string;
  };
};

type Signal = {
  headline: string;
  wave: string;
  kind: string;
  timingLabel: string;
  public: {
    implication: string;
  };
};

type Paper = {
  title: string;
  href: string;
  tags: string[];
};

type ElsewhereCard = {
  href: string;
  label: string;
  description: string;
};

type Props = {
  allProjects: Project[];
  recentWriting: Entry[];
  recentEntries: Entry[];
  recentSignals: Signal[];
  recentMusic: Entry[];
  papers: Paper[];
  archiveStats: { label: string; count: number; href: string }[];
  totalEntries: number;
  elsewhereCards: ElsewhereCard[];
  entryCountByMedium: Record<string, number>;
  mediumIcon: Record<string, string>;
  waveLabels: Record<string, string>;
};

const {
  allProjects,
  recentWriting,
  recentEntries,
  recentSignals,
  recentMusic,
  papers,
  archiveStats,
  totalEntries,
  elsewhereCards,
  entryCountByMedium,
  mediumIcon,
  waveLabels,
} = Astro.props as Props;

const projects = [...allProjects]
  .sort((a, b) => (Number(b.data.year ?? 0) - Number(a.data.year ?? 0)))
  .slice(0, 3);

const writing = [...recentWriting].slice(0, 3);
const archive = [...recentEntries].slice(0, 3);
const signals = [...recentSignals].slice(0, 3);
const music = [...recentMusic].slice(0, 3);

const bundles = [
  {
    id: 'who',
    side: 'left' as const,
    kicker: 'Who',
    title: 'Identity',
    summary: profile.location,
    count: `${profile.roles.length} roles`,
  },
  {
    id: 'work',
    side: 'right' as const,
    kicker: 'Work',
    title: 'Recent projects',
    summary: projects[0]?.data.title ? projects[0].data.title : 'Projects in motion',
    count: `${projects.length} projects`,
  },
  {
    id: 'writing',
    side: 'left' as const,
    kicker: 'Writing',
    title: 'Recent pieces',
    summary: writing[0]?.data.title ? writing[0].data.title : 'Recent pieces',
    count: `${writing.length} pieces`,
  },
  {
    id: 'archive',
    side: 'right' as const,
    kicker: 'Archive',
    title: 'Living record',
    summary: `${totalEntries} entries`,
    count: 'by medium',
  },
  {
    id: 'signals',
    side: 'left' as const,
    kicker: 'AGI Monitor',
    title: 'Active signals',
    summary: `${signals.length} live signals`,
    count: 'current wave',
  },
  {
    id: 'research',
    side: 'right' as const,
    kicker: 'Research',
    title: 'Papers',
    summary: `${papers.length} papers`,
    count: 'long form',
  },
  {
    id: 'sound',
    side: 'left' as const,
    kicker: 'Sound',
    title: 'Music archive',
    summary: `${entryCountByMedium.music || 0} music entries`,
    count: `${music.length} recent`,
  },
  {
    id: 'elsewhere',
    side: 'right' as const,
    kicker: 'Elsewhere',
    title: 'Other rooms',
    summary: `${elsewhereCards.length + 1} routes`,
    count: `${elsewhereCards.length + 1} links`,
  },
] as const;
---

<section class="home-categories" aria-label="Homepage categories">
  <div class="home-categories__rail" aria-hidden="true"></div>
  <ol class="home-categories__list" role="list">
    {bundles.map((bundle, index) => (
      <li class="home-categories__item" data-side={bundle.side}>
        <details class="home-categories__bundle">
          <summary class={`home-categories__summary home-categories__summary--${bundle.side}`}>
            <span class="home-categories__kicker">{bundle.kicker}</span>
            <span class="home-categories__title">{bundle.title}</span>
            <span class="home-categories__summaryText">{bundle.summary}</span>
            <span class="home-categories__count">{bundle.count}</span>
          </summary>

          <div class={`home-categories__panel home-categories__panel--${bundle.side}`}>
            {bundle.id === 'who' && (
              <>
                <p class="home-categories__body">
                  Newark-based music producer, visual storyteller, and community builder.
                </p>
                <div class="home-categories__chips">
                  {profile.roles.map((role) => <span class="home-categories__chip">{role}</span>)}
                </div>
                <a href="/about" class="home-categories__link">Full story →</a>
              </>
            )}

            {bundle.id === 'work' && (
              <>
                <ul class="home-categories__entries">
                  {projects.map((project) => (
                    <li class="home-categories__entry">
                      <a href={`/work/${project.slug}`} class="home-categories__entryLink">
                        <span class="home-categories__entryTitle">{project.data.title}</span>
                        <span class="home-categories__entryMeta">{project.data.type} · {project.data.year}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/work" class="home-categories__link">All projects →</a>
              </>
            )}

            {bundle.id === 'writing' && (
              <>
                <ul class="home-categories__entries">
                  {writing.map((entry) => (
                    <li class="home-categories__entry">
                      <a href={`/archive/writing/${entry.slug.split('/').pop()}`} class="home-categories__entryLink">
                        <span class="home-categories__entryTitle">{entry.data.title}</span>
                        {entry.data.summary && <span class="home-categories__entryMeta">{entry.data.summary}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/writing" class="home-categories__link">All writing →</a>
              </>
            )}

            {bundle.id === 'archive' && (
              <>
                <div class="home-categories__stats">
                  {archiveStats.map((stat) => (
                    <a href={stat.href} class="home-categories__stat">
                      <strong>{stat.count}</strong> {stat.label}
                    </a>
                  ))}
                </div>
                <ul class="home-categories__entries">
                  {archive.map((entry) => (
                    <li class="home-categories__entry">
                      <a href={`/archive/${entry.data.medium}/${entry.slug.split('/').pop()}`} class="home-categories__entryLink">
                        <span class="home-categories__entryTitle">{entry.data.title}</span>
                        <span class="home-categories__entryMeta">
                          {mediumIcon[entry.data.medium ?? ''] ?? '·'} {entry.data.medium} · {new Date(entry.data.date ?? Date.now()).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
                <a href="/archive" class="home-categories__link">All {totalEntries} entries →</a>
              </>
            )}

            {bundle.id === 'signals' && (
              <>
                <ul class="home-categories__entries">
                  {signals.map((item) => (
                    <li class="home-categories__signal">
                      <div class="home-categories__signalMeta">
                        <span>{waveLabels[item.wave] ?? item.wave}</span>
                        <span aria-hidden="true">·</span>
                        <span>{item.kind}</span>
                        <span aria-hidden="true">·</span>
                        <span>{item.timingLabel}</span>
                      </div>
                      <p class="home-categories__signalHeadline">{item.headline}</p>
                      <p class="home-categories__signalCopy">{item.public.implication}</p>
                    </li>
                  ))}
                </ul>
                <a href="/agi" class="home-categories__link">Full timeline →</a>
              </>
            )}

            {bundle.id === 'research' && (
              <>
                <ul class="home-categories__entries">
                  {papers.map((paper) => (
                    <li class="home-categories__entry">
                      <a href={paper.href} class="home-categories__entryLink" target="_blank" rel="noopener noreferrer">
                        <span class="home-categories__entryTitle">{paper.title}</span>
                        <span class="home-categories__entryMeta">{paper.tags.join(' · ')}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}

            {bundle.id === 'sound' && (
              <>
                <p class="home-categories__body">
                  The music archive holds beat tapes, session logs, and sound studies.
                </p>
                <ul class="home-categories__entries">
                  {music.map((entry) => (
                    <li class="home-categories__entry">
                      <a href={`/archive/music/${entry.slug.split('/').pop()}`} class="home-categories__entryLink">
                        <span class="home-categories__entryTitle">{entry.data.title}</span>
                        <span class="home-categories__entryMeta">{entry.data.summary ?? 'Music archive entry'}</span>
                      </a>
                    </li>
                  ))}
                </ul>
                <div class="home-categories__actions">
                  <a href="/archive/music" class="home-categories__link">Music archive →</a>
                  <button class="home-categories__button" onclick="document.querySelector('[data-music-bar-toggle]')?.click()" type="button">
                    Open player ♪
                  </button>
                </div>
              </>
            )}

            {bundle.id === 'elsewhere' && (
              <>
                <ul class="home-categories__entries">
                  {[...elsewhereCards, { href: '/contact', label: 'Contact', description: 'Reach out, collaborate, or correspond.' }].map((card) => (
                    <li class="home-categories__entry">
                      <a href={card.href} class="home-categories__entryLink">
                        <span class="home-categories__entryTitle">{card.label}</span>
                        <span class="home-categories__entryMeta">{card.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </>
            )}
          </div>
        </details>
      </li>
    ))}
  </ol>
</section>

<style>
  .home-categories {
    position: relative;
    max-width: 1040px;
    margin: clamp(0.55rem, 1.8vw, 1rem) auto 0;
    padding: clamp(0.4rem, 1vw, 0.75rem) clamp(1rem, 3vw, 1.6rem) 0;
  }

  .home-categories__rail {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 1px;
    transform: translateX(-0.5px);
    background:
      linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--tone-accent) 18%, var(--line2)) 12%,
        color-mix(in srgb, var(--tone-accent) 12%, var(--line2)) 88%,
        transparent
      );
    pointer-events: none;
    opacity: 0.78;
  }

  .home-categories__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.6rem, 1.3vw, 1rem);
  }

  .home-categories__item {
    display: grid;
  }

  .home-categories__bundle {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr);
    align-items: start;
  }

  .home-categories__bundle::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.98rem;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    transform: translateX(-50%);
    background: var(--tone-surface);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--tone-accent) 8%, transparent);
    z-index: 1;
  }

  .home-categories__summary {
    position: relative;
    display: grid;
    gap: 0.14rem;
    width: min(100%, 30rem);
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    text-align: inherit;
    cursor: pointer;
    list-style: none;
    appearance: none;
    outline: none;
  }

  .home-categories__summary::-webkit-details-marker {
    display: none;
  }

  .home-categories__summary--left,
  .home-categories__panel--left {
    grid-column: 1;
    justify-self: end;
    text-align: right;
    padding-right: clamp(0.35rem, 1vw, 0.8rem);
  }

  .home-categories__summary--right,
  .home-categories__panel--right {
    grid-column: 3;
    justify-self: start;
    text-align: left;
    padding-left: clamp(0.35rem, 1vw, 0.8rem);
  }

  .home-categories__kicker,
  .home-categories__title,
  .home-categories__summaryText,
  .home-categories__count,
  .home-categories__body {
    margin: 0;
  }

  .home-categories__kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tone-accent);
  }

  .home-categories__title {
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.14;
    color: color-mix(in srgb, var(--tone-accent-glow) 76%, white 24%);
  }

  .home-categories__summaryText {
    font-size: 0.8rem;
    line-height: 1.38;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    text-wrap: balance;
  }

  .home-categories__count {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 52%, var(--tone-muted) 48%);
  }

  .home-categories__summary:hover .home-categories__title,
  .home-categories__summary:focus-visible .home-categories__title {
    color: var(--tone-accent-glow);
  }

  .home-categories__panel {
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    transform: translateY(-2px);
    transition:
      max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
      opacity 0.28s ease,
      transform 0.28s ease;
  }

  .home-categories__bundle[open] .home-categories__panel {
    max-height: 80rem;
    opacity: 1;
    transform: translateY(0);
    margin-top: 0.26rem;
    padding-top: 0.32rem;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 14%, var(--line2));
  }

  .home-categories__body {
    font-size: 0.96rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    max-width: 40rem;
  }

  .home-categories__chips,
  .home-categories__stats,
  .home-categories__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .home-categories__chips {
    margin-top: 0.65rem;
  }

  .home-categories__chip,
  .home-categories__stat,
  .home-categories__button,
  .home-categories__link {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.38rem 0.65rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 16%, var(--line2));
    color: color-mix(in srgb, var(--tone-text) 90%, var(--tone-muted) 10%);
    text-decoration: none;
    background: transparent;
    font-size: 0.82rem;
  }

  .home-categories__chip {
    color: color-mix(in srgb, var(--tone-text) 82%, var(--tone-muted) 18%);
  }

  .home-categories__stat {
    gap: 0.35rem;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .home-categories__stat strong {
    font-family: var(--font-display);
    font-size: 0.92rem;
    color: var(--tone-accent-glow);
  }

  .home-categories__entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.3rem;
  }

  .home-categories__entry,
  .home-categories__signal {
    padding-top: 0.3rem;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
  }

  .home-categories__entryLink {
    display: grid;
    gap: 0.08rem;
    text-decoration: none;
    color: inherit;
  }

  .home-categories__entryTitle {
    font-size: 1rem;
    line-height: 1.34;
    color: color-mix(in srgb, var(--tone-text) 93%, white 7%);
  }

  .home-categories__entryMeta,
  .home-categories__signalMeta,
  .home-categories__signalCopy {
    font-size: 0.78rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--tone-text) 74%, var(--tone-muted) 26%);
  }

  .home-categories__signalMeta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .home-categories__signalHeadline {
    margin: 0.16rem 0 0;
    font-size: 0.98rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--tone-text) 94%, white 6%);
  }

  .home-categories__signalCopy {
    margin: 0.15rem 0 0;
  }

  .home-categories__link,
  .home-categories__button {
    margin-top: 0.55rem;
    border-color: color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    color: color-mix(in srgb, var(--tone-accent-glow) 78%, white 22%);
    cursor: pointer;
  }

  .home-categories__button:hover,
  .home-categories__button:focus-visible,
  .home-categories__link:hover,
  .home-categories__link:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 46%, var(--line2));
    color: var(--tone-accent-glow);
  }

  @media (max-width: 860px) {
    .home-categories {
      padding-inline: 1rem;
      margin-top: 0.35rem;
    }

    .home-categories__rail {
      left: 0.85rem;
      transform: none;
      opacity: 0.34;
    }

    .home-categories__bundle {
      grid-template-columns: 1rem minmax(0, 1fr);
    }

    .home-categories__summary--left,
    .home-categories__summary--right,
    .home-categories__panel--left,
    .home-categories__panel--right {
      grid-column: 2;
      justify-self: stretch;
      width: 100%;
      text-align: left;
      padding-left: 0;
      padding-right: 0;
    }

    .home-categories__bundle::before {
      left: 0.6rem;
      top: 0.88rem;
    }
  }
</style>
