---
import type { NewarkLaneConfig } from '../data/newark-lanes';

type Props = {
  lane: NewarkLaneConfig;
};

const { lane } = Astro.props as Props;
---

<section class="nwk-lane-shell" data-lane={lane.slug}>
  <header class="nwk-lane-shell__head">
    <p class="nwk-lane-shell__kicker">Working lane</p>
    <h2>{lane.tabLabel}</h2>
    <p class="nwk-lane-shell__lead">{lane.lead}</p>
    <p class="nwk-lane-shell__summary">{lane.summary}</p>
  </header>

  <div class="nwk-lane-shell__body">
    <aside class="nwk-lane-notes" aria-label={`${lane.tabLabel} expanded thoughts`}>
      <p class="nwk-lane-notes__label">Expanded thoughts</p>
      <div class="nwk-lane-notes__stack">
        {lane.notes.map((note, index) => (
          <details class:list={['nwk-thought', (note.open ?? index === 0) && 'is-open']} open={note.open ?? index === 0}>
            <summary class="nwk-thought__summary">
              <span class="nwk-thought__text">
                <span class="nwk-thought__title">{note.title}</span>
                <span class="nwk-thought__summary-copy">{note.summary}</span>
              </span>
              <span class="nwk-thought__indicator" aria-hidden="true"></span>
            </summary>
            <div class="nwk-thought__body">
              <p>{note.body}</p>
              {note.points?.length ? (
                <ul class="nwk-thought__points">
                  {note.points.map((point) => <li>{point}</li>)}
                </ul>
              ) : null}
            </div>
          </details>
        ))}
      </div>
    </aside>

    <div class="nwk-lane-shell__stream">
      <slot />
    </div>
  </div>
</section>
