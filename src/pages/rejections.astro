---
import BaseLayout from '../layouts/BaseLayout.astro';

const rejections = [
  { date: 'Mar 23, 2026', org: 'Disney / WABC', role: 'Part Time NABET Desk Assistant', outcome: 'Considering other candidates whose background and experience align more closely.' },
  { date: 'Mar 19, 2026', org: 'Education Law Center', role: 'Program Assistant at ELC', outcome: 'Moved forward with other candidates.' },
  { date: 'Mar 13, 2026', org: 'The New York Times', role: 'Puzzle Assistant, Digital', outcome: 'Position filled.' },
