];

const fellowship = { date: 'Dec 15, 2021', org: 'NYU Gallatin Global Fellowship in Human Rights', role: '2022 Fellowship Application', outcome: 'Forwarded rejection-related email.' };
---

<BaseLayout
  title="Rejection Log — a_e.s_"
  description="40 direct employer rejections, documented. Sony Music, Disney, NYT, Anthropic, OpenAI, NPR, and more."
  theme="archive"
  bodyClass="rejections-page"
  flatSurface={true}
  forceThemeMode="dark"
>
  <main class="rej-main">
    <section class="rej-header">
      <p class="rej-eyebrow">Application Record</p>
      <h1 class="rej-title">40 Rejections</h1>
      <p class="rej-subtitle">
        Direct employer rejections, sourced from the Gmail archive. Sony Music, Disney / WABC, The New York Times, Anthropic, OpenAI, NPR, PlayStation, Adobe, and 32 others. All documented. All real.
      </p>
      <div class="rej-stats">
        <div class="rej-stat">
          <span class="rej-stat__num">40</span>
          <span class="rej-stat__label">Direct rejections</span>
        </div>
        <div class="rej-stat">
          <span class="rej-stat__num">3</span>
          <span class="rej-stat__label">Years on record</span>
        </div>
        <div class="rej-stat">
          <span class="rej-stat__num">15+</span>
          <span class="rej-stat__label">Sony Music alone</span>
        </div>
      </div>
    </section>

    <section class="rej-table-wrap" aria-label="Rejection log">
      <table class="rej-table">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Organization</th>
            <th scope="col">Role</th>
            <th scope="col" class="rej-th--outcome">Outcome</th>
          </tr>
        </thead>
        <tbody>
          {rejections.map((r) => (
            <tr>
              <td class="rej-td--date">{r.date}</td>
              <td class="rej-td--org">{r.org}</td>
              <td class="rej-td--role">{r.role}</td>
              <td class="rej-td--outcome">{r.outcome}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section class="rej-appendix">
      <p class="rej-appendix__label">Appendix — Fellowship</p>
      <table class="rej-table rej-table--small">
        <thead>
          <tr>
            <th scope="col">Date</th>
            <th scope="col">Organization</th>
            <th scope="col">Role</th>
            <th scope="col" class="rej-th--outcome">Note</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td class="rej-td--date">{fellowship.date}</td>
            <td class="rej-td--org">{fellowship.org}</td>
            <td class="rej-td--role">{fellowship.role}</td>
            <td class="rej-td--outcome">{fellowship.outcome}</td>
          </tr>
        </tbody>
      </table>
    </section>
  </main>
</BaseLayout>

<style>
  .rej-main {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 3vw, 1.75rem) clamp(3rem, 6vw, 5rem);
  }

  .rej-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .rej-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.55);
  }

  .rej-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display, serif);
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--tone-accent-glow, #e8cfa0) 60%, white 40%);
  }

  .rej-subtitle {
    max-width: 52rem;
    margin: 0 0 2rem;
    font-size: clamp(0.92rem, 1.2vw, 1.02rem);
    line-height: 1.62;
    color: rgba(236, 227, 214, 0.72);
  }

  .rej-stats {
    display: flex;
    gap: clamp(1.5rem, 3vw, 2.5rem);
    flex-wrap: wrap;
  }

  .rej-stat {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .rej-stat__num {
    font-family: var(--font-display, serif);
    font-size: clamp(1.6rem, 2.8vw, 2.2rem);
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--tone-accent-glow, #e8cfa0) 70%, white 30%);
  }

  .rej-stat__label {
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.5);
  }

  .rej-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .rej-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(0.78rem, 0.95vw, 0.88rem);
  }

  .rej-table thead th {
    padding: 0.5rem 0.75rem 0.6rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.5);
    text-align: left;
    border-bottom: 1px solid rgba(230, 214, 191, 0.1);
  }

  .rej-table tbody tr {
    border-bottom: 1px solid rgba(230, 214, 191, 0.07);
    transition: background 0.15s ease;
  }

  .rej-table tbody tr:hover {
    background: rgba(230, 214, 191, 0.04);
  }

  .rej-table td {
    padding: 0.62rem 0.75rem;
    vertical-align: top;
    color: rgba(236, 227, 214, 0.82);
    line-height: 1.5;
  }

  .rej-td--date {
    white-space: nowrap;
    color: rgba(230, 214, 191, 0.5) !important;
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .rej-td--org {
    font-weight: 500;
    color: rgba(236, 227, 214, 0.92) !important;
    min-width: 10rem;
  }

  .rej-td--role {
    color: rgba(236, 227, 214, 0.78) !important;
  }

  .rej-td--outcome {
    color: rgba(230, 214, 191, 0.5) !important;
    font-size: 0.78rem;
    font-style: italic;
  }

  .rej-appendix {
    margin-top: clamp(2.5rem, 4vw, 3.5rem);
    padding-top: clamp(1.5rem, 2.5vw, 2rem);
    border-top: 1px solid rgba(230, 214, 191, 0.12);
  }

  .rej-appendix__label {
    margin: 0 0 1rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.45);
  }

  .rej-table--small {
    font-size: clamp(0.74rem, 0.9vw, 0.84rem);
  }
</style>
