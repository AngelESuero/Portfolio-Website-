  { date: 'Oct 11, 2024', org: 'Universal Music Group', role: 'Administrative Assistant, Production', outcome: 'Pursued other candidates; not selected to move forward.' },
  { date: 'Oct 4, 2024', org: 'Sony Music', role: 'International/US Admin Assistant', outcome: 'Application not selected for further consideration.' },
