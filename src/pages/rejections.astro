  { date: 'Mar 19, 2026', org: 'Education Law Center', role: 'Program Assistant at ELC', outcome: 'Moved forward with other candidates.' },
  { date: 'Mar 13, 2026', org: 'The New York Times', role: 'Puzzle Assistant, Digital', outcome: 'Position filled.' },
  { date: 'Mar 11, 2026', org: 'Anthropic', role: 'Product Support Specialist', outcome: 'Would not move forward in the interview process.' },
  { date: 'Feb 19, 2026', org: 'Sony Music', role: 'Associate Director, Creative – Alamo', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 19, 2026', org: 'Universal Music Group', role: 'Tech Support Analyst', outcome: 'Will no longer be filling the position.' },
  { date: 'Jan 27, 2026', org: 'OpenAI', role: 'IT Support Specialist', outcome: 'Would not move forward with candidacy.' },
  { date: 'Jan 26, 2026', org: 'Aquent', role: 'Instructional Writer', outcome: 'Not selected for the next step in the process.' },
  { date: 'Jan 25, 2026', org: 'Adobe', role: '2026 Intern, Experience Design', outcome: 'Decided not to move forward with the application.' },
  { date: 'Jan 22, 2026', org: 'PGIM', role: 'Associate, RFP Writer (Hybrid)', outcome: 'Chose other candidates whose experience was a stronger match.' },
  { date: 'Jan 14, 2026', org: 'Universal Music Group', role: 'Specialist, Content Creation', outcome: 'Pursued other candidates; not selected to move forward.' },
  { date: 'Jan 12, 2026', org: 'Santa Monica Studio', role: 'Sr Technical Producer (Contract)', outcome: 'Would not proceed with candidacy.' },
  { date: 'Jan 8, 2026', org: 'Wasserman', role: 'Content Creator', outcome: 'Did not have an appropriate position at this time.' },
  { date: 'Jul 15, 2025', org: 'Sony Music', role: 'Coordinator, Insights & Reporting', outcome: 'Application not selected for further consideration.' },
  { date: 'May 23, 2025', org: 'Bungie', role: 'Contract Marathon Associate Marketing Manager', outcome: 'Would not proceed because the position was closed.' },
  { date: 'Apr 30, 2025', org: 'PlayStation Global', role: 'Quest Designer (Contract)', outcome: 'Moved ahead with other candidates.' },
  { date: 'Apr 21, 2025', org: 'NPR', role: 'Producer II, Planet Money Summer School (Temporary)', outcome: 'Pursued other candidates.' },
  { date: 'Mar 3, 2025', org: 'Macmillan', role: 'Editorial Assistant, First Second and 23rd Street Books', outcome: 'Position filled.' },
  { date: 'Feb 18, 2025', org: 'PSEG', role: 'Temporary Credit & Collections Representative – Newark', outcome: 'Resume reviewed; moved ahead with other candidates.' },
  { date: 'Oct 11, 2024', org: 'Universal Music Group', role: 'Administrative Assistant, Production', outcome: 'Pursued other candidates; not selected to move forward.' },
  { date: 'Oct 4, 2024', org: 'Sony Music', role: 'International/US Admin Assistant', outcome: 'Application not selected for further consideration.' },
  { date: 'Sep 23, 2024', org: 'Sony Music', role: 'Coordinator, Fan Engagement – Columbia', outcome: 'Application not selected for further consideration.' },
  { date: 'Sep 6, 2024', org: 'PSEG', role: 'General Clerk', outcome: 'Decided not to fill the position at that time.' },
  { date: 'Aug 14, 2024', org: 'Sony Music', role: 'Coordinator, Artist & DSP Optimization', outcome: 'Application not selected for further consideration.' },
  { date: 'Aug 10, 2024', org: 'Sony Music', role: 'Label Copy Coordinator', outcome: 'Application not selected for further consideration.' },
  { date: 'Jul 23, 2024', org: 'Sony Music', role: 'Coordinator, Artist & DSP Optimization', outcome: 'Application not selected for further consideration.' },
  { date: 'Jul 10, 2024', org: 'PSEG', role: 'Utility Mechanic Apprentice – Oradell', outcome: 'Moved forward with other candidates.' },
  { date: 'Jul 9, 2024', org: 'Sony Music', role: 'Administrative Assistant (Records)', outcome: 'Application not selected for further consideration.' },
  { date: 'Jun 28, 2024', org: 'Sony Music', role: 'Artist Support Associate', outcome: 'Application not selected for further consideration.' },
  { date: 'Jun 21, 2024', org: 'Sony Music', role: 'Coordinator, Promotion', outcome: 'Application not selected for further consideration.' },
  { date: 'Jun 12, 2024', org: 'Swatch Group', role: 'Watchmaker / Watch Technician', outcome: 'Application was not selected.' },
  { date: 'Apr 11, 2024', org: 'Sony Music', role: 'Admin Assistant', outcome: 'Application not selected for further consideration.' },
  { date: 'Apr 11, 2024', org: 'Sony Music Entertainment', role: 'Administrative Assistant', outcome: 'Application not selected for further consideration.' },
  { date: 'Apr 1, 2024', org: 'Santander', role: 'Part Time Teller, Newark, NJ', outcome: 'Would not be moved forward; advanced with other candidates.' },
  { date: 'Mar 20, 2024', org: 'Sony Music', role: 'Artist Development Assistant (AWAL)', outcome: 'Application not selected for further consideration.' },
  { date: 'Mar 16, 2024', org: 'Sony Music', role: 'Administrative Assistant, A&R; Administration', outcome: 'Application not selected for further consideration.' },
  { date: 'Mar 15, 2024', org: 'Sony Music Entertainment US', role: 'Admin Assistant, Marketing', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 16, 2024', org: 'Sony Music Entertainment US', role: 'Creative Coordinator', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 16, 2024', org: 'Sony Music', role: 'Administrative Assistant, Video Production', outcome: 'Application not selected for further consideration.' },
  { date: 'May 5, 2023', org: 'Corporate Immigration Partners P.C.', role: 'Technical Writer – Remote', outcome: 'Employer moved to the next step; application not selected.' },
];

const inventorySummary = {
  searchDate: 'Mar 24, 2026',
  combinedClearApplications: 179,
  outboundMessages: 54,
  directRejections: rejections.length,
  reportHref: '/documents/combined-gmail-job-applications-inventory.pdf',
};
const explicitClosureShare = Math.round((inventorySummary.directRejections / inventorySummary.combinedClearApplications) * 100);
const countingRules = [
  'Included: job or internship applications where the employer and role were visible in the email record.',
  'Excluded: incomplete applications, duplicates, reminders, and non-employment email trails.',
  'Outreach: sent emails with attachments and clear job-search context were tracked separately.',
];
---

<BaseLayout
  title="Career Search Log — a_e.s_"
  description="179 clear applications, 54 outreach emails, and 40 explicit outcomes from a Gmail job-search archive."
  theme="archive"
  bodyClass="rejections-page"
  flatSurface={true}
  forceThemeMode="dark"
>
  <main class="rej-main">
    <section class="rej-header">
      <p class="rej-eyebrow">Career Search Record</p>
      <h1 class="rej-title">Career Search Log</h1>
      <p class="rej-subtitle">
        You put out {inventorySummary.combinedClearApplications} clear applications and {inventorySummary.outboundMessages} outreach emails. {inventorySummary.directRejections} of those attempts came back with an explicit outcome.
      </p>
      <div class="rej-link-row">
        <a class="rej-link" href={inventorySummary.reportHref}>Open source PDF</a>
      </div>
    </section>

    <section class="rej-ledgers" aria-label="Effort and returned responses">
      <article class="rej-panel rej-ledger">
        <p class="rej-section-label">Effort Recorded</p>
        <h2 class="rej-section-title">What went out</h2>

        <div class="rej-stat-grid">
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.combinedClearApplications}</span>
            <span class="rej-stat__label">Clear applications</span>
          </div>
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.outboundMessages}</span>
            <span class="rej-stat__label">Sent outreach emails</span>
          </div>
        </div>

        <p class="rej-ledger__note">Applications are the main effort. Outreach sits beside them as direct contact.</p>
      </article>

      <article class="rej-panel rej-ledger">
        <p class="rej-section-label">Responses Returned</p>
        <h2 class="rej-section-title">What came back</h2>

        <div class="rej-stat-grid">
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.directRejections}</span>
            <span class="rej-stat__label">Explicit outcomes</span>
          </div>
          <div class="rej-stat">
            <span class="rej-stat__num">{explicitClosureShare}%</span>
            <span class="rej-stat__label">Closure rate</span>
          </div>
        </div>

        <p class="rej-ledger__note">These are the returns that show what the effort produced.</p>
      </article>
    </section>

    <section class="rej-table-section" aria-label="Career search log">
      <div class="rej-section-head rej-section-head--table">
        <div>
          <p class="rej-section-label">Evidence</p>
          <h2 class="rej-section-title">The 40 explicit outcomes</h2>
        </div>
        <p class="rej-section-note">Most recent first. This is the direct record of what came back.</p>
      </div>

      <div class="rej-table-wrap">
        <table class="rej-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Organization</th>
              <th scope="col">Role</th>
              <th scope="col" class="rej-th--outcome">Outcome</th>
            </tr>
          </thead>
          <tbody>
            {rejections.map((record) => (
              <tr>
                <td class="rej-td--date">{record.date}</td>
                <td class="rej-td--org">{record.org}</td>
                <td class="rej-td--role">{record.role}</td>
                <td class="rej-td--outcome">{record.outcome}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="rej-notes" aria-label="Counting rules">
      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">How this was counted</summary>
        <div class="rej-disclosure__body">
          <ul class="rej-list">
            {countingRules.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="rej-appendix__footnote">The source PDF has the longer archive review if you want the extra context.</p>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

<style>
  .rej-main {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(2rem, 4vw, 3.25rem) clamp(1rem, 3vw, 1.6rem) clamp(3rem, 6vw, 5rem);
  }

  .rej-header {
    margin-bottom: clamp(1.5rem, 3vw, 2.2rem);
  }

  .rej-eyebrow {
    margin: 0 0 0.5rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.55);
  }

  .rej-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-display, serif);
    font-size: clamp(2.35rem, 4.8vw, 3.8rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: color-mix(in srgb, var(--tone-accent-glow, #e8cfa0) 60%, white 40%);
  }

  .rej-subtitle {
    max-width: 44rem;
    margin: 0;
    font-size: clamp(0.95rem, 1.2vw, 1.02rem);
    line-height: 1.62;
    color: rgba(236, 227, 214, 0.78);
  }

  .rej-link-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .rej-link {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    border: 1px solid rgba(230, 214, 191, 0.16);
    padding: 0.48rem 0.82rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: rgba(245, 239, 229, 0.92);
    text-decoration: none;
    background: rgba(255, 255, 255, 0.035);
    transition: background 0.15s ease, border-color 0.15s ease;
  }

  .rej-link:hover {
    background: rgba(255, 255, 255, 0.065);
    border-color: rgba(230, 214, 191, 0.28);
  }

  .rej-ledgers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .rej-table-section,
  .rej-notes {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .rej-panel,
  .rej-table-section,
  .rej-disclosure {
    border: 1px solid rgba(230, 214, 191, 0.12);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      rgba(12, 10, 8, 0.72);
    border-radius: 1.2rem;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }

  .rej-panel,
  .rej-table-section,
  .rej-ledger,
  .rej-disclosure {
    padding: 1.05rem 1.05rem 1.1rem;
  }

  .rej-section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .rej-section-head--table {
    margin-bottom: 0.75rem;
  }

  .rej-section-label,
  .rej-disclosure__summary {
    margin: 0;
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.48);
  }

  .rej-section-title {
    margin: 0.2rem 0 0;
    font-size: 1.08rem;
    line-height: 1.25;
    color: rgba(245, 239, 229, 0.95);
  }

  .rej-section-note,
  .rej-ledger__note,
  .rej-appendix__footnote,
  .rej-list li {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.6;
    color: rgba(236, 227, 214, 0.72);
  }

  .rej-section-note {
    max-width: 21rem;
    text-align: right;
  }

  .rej-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .rej-stat {
    padding: 0.9rem 0.95rem;
    border-radius: 1rem;
    border: 1px solid rgba(230, 214, 191, 0.1);
    background: rgba(255, 255, 255, 0.03);
  }

  .rej-stat__num {
    font-family: var(--font-display, serif);
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    line-height: 1;
    color: color-mix(in srgb, var(--tone-accent-glow, #e8cfa0) 72%, white 28%);
  }

  .rej-stat__label {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.48);
  }

  .rej-ledger__note {
    padding-top: 0.9rem;
    border-top: 1px solid rgba(230, 214, 191, 0.08);
  }

  .rej-table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    padding: 0.5rem 1rem 1rem;
  }

  .rej-table {
    width: 100%;
    border-collapse: collapse;
    font-size: clamp(0.78rem, 0.95vw, 0.88rem);
  }

  .rej-table thead th {
    padding: 0.5rem 0.75rem 0.6rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.5);
    text-align: left;
    border-bottom: 1px solid rgba(230, 214, 191, 0.1);
  }

  .rej-table tbody tr {
    border-bottom: 1px solid rgba(230, 214, 191, 0.07);
    transition: background 0.15s ease;
  }

  .rej-table tbody tr:hover {
    background: rgba(230, 214, 191, 0.04);
  }

  .rej-table td {
    padding: 0.62rem 0.75rem;
    vertical-align: top;
    color: rgba(236, 227, 214, 0.82);
    line-height: 1.5;
  }

  .rej-td--date {
    white-space: nowrap;
    color: rgba(230, 214, 191, 0.5) !important;
    font-size: 0.74rem;
    font-variant-numeric: tabular-nums;
  }

  .rej-td--org {
    font-weight: 500;
    color: rgba(236, 227, 214, 0.92) !important;
    min-width: 10rem;
  }

  .rej-td--account {
    min-width: 11rem;
    color: rgba(236, 227, 214, 0.72) !important;
    font-size: 0.77rem;
    word-break: break-word;
  }

  .rej-td--role {
    color: rgba(236, 227, 214, 0.78) !important;
  }

  .rej-td--outcome {
    color: rgba(230, 214, 191, 0.5) !important;
    font-size: 0.78rem;
    line-height: 1.55;
  }

  .rej-notes {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .rej-disclosure {
    margin-top: 0.85rem;
    border-top: 1px solid rgba(230, 214, 191, 0.12);
  }

  .rej-disclosure__summary {
    cursor: pointer;
    list-style: none;
  }

  .rej-disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .rej-disclosure__body {
    margin-top: 0.9rem;
  }

  .rej-list {
    margin: 0;
    padding-left: 1rem;
  }

  .rej-list li + li {
    margin-top: 0.55rem;
  }

  @media (max-width: 880px) {
    .rej-ledgers {
      grid-template-columns: 1fr;
    }

    .rej-section-note {
      max-width: none;
      text-align: left;
    }

    .rej-stat-grid {
      grid-template-columns: 1fr;
    }

    .rej-table-wrap {
      padding-inline: 0.75rem;
    }
  }
</style>
