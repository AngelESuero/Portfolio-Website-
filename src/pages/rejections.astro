  { date: 'Feb 16, 2024', org: 'Sony Music Entertainment US', role: 'Creative Coordinator', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 16, 2024', org: 'Sony Music', role: 'Administrative Assistant, Video Production', outcome: 'Application not selected for further consideration.' },
