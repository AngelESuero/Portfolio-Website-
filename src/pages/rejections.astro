  { date: 'Jun 12, 2024', org: 'Swatch Group', role: 'Watchmaker / Watch Technician', outcome: 'Application was not selected.' },
  { date: 'Apr 11, 2024', org: 'Sony Music', role: 'Admin Assistant', outcome: 'Application not selected for further consideration.' },
  { date: 'Apr 11, 2024', org: 'Sony Music Entertainment', role: 'Administrative Assistant', outcome: 'Application not selected for further consideration.' },
  { date: 'Apr 1, 2024', org: 'Santander', role: 'Part Time Teller, Newark, NJ', outcome: 'Would not be moved forward; advanced with other candidates.' },
  { date: 'Mar 20, 2024', org: 'Sony Music', role: 'Artist Development Assistant (AWAL)', outcome: 'Application not selected for further consideration.' },
  { date: 'Mar 16, 2024', org: 'Sony Music', role: 'Administrative Assistant, A&R; Administration', outcome: 'Application not selected for further consideration.' },
  { date: 'Mar 15, 2024', org: 'Sony Music Entertainment US', role: 'Admin Assistant, Marketing', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 16, 2024', org: 'Sony Music Entertainment US', role: 'Creative Coordinator', outcome: 'Application not selected for further consideration.' },
  { date: 'Feb 16, 2024', org: 'Sony Music', role: 'Administrative Assistant, Video Production', outcome: 'Application not selected for further consideration.' },
  { date: 'May 5, 2023', org: 'Corporate Immigration Partners P.C.', role: 'Technical Writer – Remote', outcome: 'Employer moved to the next step; application not selected.' },
];

const fellowship = { date: 'Dec 15, 2021', org: 'NYU Gallatin Global Fellowship in Human Rights', role: '2022 Fellowship Application', outcome: 'Forwarded rejection-related email.' };

const inventorySummary = {
  searchDate: 'Mar 24, 2026',
  priorCombinedClearApplications: 112,
  combinedClearApplications: 179,
  deepPassAdditions: 67,
  outboundMessages: 54,
  directRejections: rejections.length,
  reviewedMailboxes: 3,
  mailboxes: [
    {
      mailbox: 'aes903@nyu.edu',
      clearApplications: 97,
      note: '60 from the updated NYU pass, plus 37 older records found in the deep pass.',
    },
    {
      mailbox: 'angelesuero2@gmail.com',
      clearApplications: 82,
      note: '52 from the updated second pass, plus 30 older records found in the deep pass.',
    },
    {
      mailbox: 'angelesuero@a-e-space.info',
      clearApplications: 0,
      note: 'Reviewed in the addendum; only duplicates and receipts without role names were found.',
    },
  ],
  included: [
    'Job or internship applications where the employer and role name were both visible in the email record.',
    'Records backed by a confirmation, interview note, status update, or rejection email.',
  ],
  excluded: [
    'School marketing, housing or lottery records, loans or insurance, and other non-employment email trails.',
    'Incomplete applications, reminder emails, duplicates, and records that never showed a clear role name.',
  ],
  reportHref: '/documents/combined-gmail-job-applications-inventory.pdf',
  rejectionReportHref: '/documents/combined-rejection-emails-report.pdf',
};

const outboundSummary = {
  included: 'Sent emails to companies, organizations, recruiters, museums, venues, media outlets, and public institutions with attachments and clear job-search context.',
  excluded: 'Self-forwards, recommendation requests, replies without attachments, and clearly non-job material.',
  note: 'This appendix tracks outbound outreach, not submitted applications or rejection notices.',
};

const outboundHighlights = [
  {
    date: 'Feb 16, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'Front Desk',
    subject: 'Re: Entry-level studio support - availability for runner / session support',
  },
  {
    date: 'Feb 3, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'Reservoir Media',
    subject: 'Inquiry: Internship opportunities (music rights / publishing support) - resume + transcript attached',
  },
  {
    date: 'Feb 3, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'Guggenheim',
    subject: 'Inquiry: Best contact for entry-level AV / media production roles - resume + transcript attached',
  },
  {
    date: 'Jan 27, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'Spotify',
    subject: 'Correction: attachments re-sent - Podcast / creator ecosystem roles (Resume + transcript attached)',
  },
  {
    date: 'Jan 26, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'TED',
    subject: 'Inquiry: Conference production + storytelling operations roles (Resume + transcript attached)',
  },
  {
    date: 'Jan 24, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'NJPAC',
    subject: 'AV / event production support (contract / part-time) - Angel Suero',
  },
  {
    date: 'Jan 23, 2026',
    account: 'angelesuero@a-e-space.info',
    recipient: 'Newark Symphony Hall',
    subject: 'Event AV / venue ops support - contract or on-call availability (Angel Suero)',
  },
  {
    date: 'Jan 24, 2025',
    account: 'aes903@nyu.edu',
    recipient: 'Borough of Roselle',
    subject: 'Attention: LIBRARY ASSISTANT',
  },
  {
    date: 'Aug 29, 2024',
    account: 'aes903@nyu.edu',
    recipient: 'ProjectArt',
    subject: 'Teaching Artist Residency',
  },
  {
    date: 'Jul 2, 2024',
    account: 'aes903@nyu.edu',
    recipient: 'Studio Museum in Harlem',
    subject: 'Application for Internship!',
  },
  {
    date: 'Sep 1, 2021',
    account: 'aes903@nyu.edu',
    recipient: 'Newark Museum of Art',
    subject: 'Application for Gallery Host',
  },
];

const heldOutRecords = [
  {
    source: 'New Jersey Performing Arts Center (2 emails)',
    reason: 'Generic thank-you notes confirmed receipt of a resume but did not expose the role name.',
  },
  {
    source: 'New Jersey Courts (multiple emails)',
    reason: 'Application receipts were found, but the surfaced emails did not show role titles and could not be deduped confidently.',
  },
  {
    source: 'ScreenRant',
    reason: 'Application-received email did not surface a role name clearly enough to count with confidence.',
  },
  {
    source: 'POSH DJs',
    reason: 'Interview-step email referenced an application but did not surface the role name clearly.',
  },
  {
    source: 'UnitedMasters | Translation (2 emails)',
    reason: 'Confirmations were found, but the role wording in the surfaced email was too unclear to classify confidently.',
  },
  {
    source: 'City of Newark, Division of Arts and Cultural Affairs',
    reason: 'Submittable confirmation named the organization but not the role title.',
  },
  {
    source: 'Macmillan — Editorial Assistant, First Second and 23rd Street Books',
    reason: 'Email said the application remained incomplete pending data-review consent, so it was not counted as a clean completed submission.',
  },
  {
    source: 'Book of the Month / CBR / IT By Design / TED reminder emails',
    reason: 'Saved or incomplete-application reminders rather than completed submissions.',
  },
  {
    source: 'Housing / apartment / lottery records and financial-product emails',
    reason: 'Housing, SoFi, Avant, Prosper, Klarna, and similar trails were not employment applications.',
  },
  {
    source: '80,000 Hours advising',
    reason: 'This was an application to an advising program rather than employment.',
  },
];

const addendumHeldOutRecords = [
  {
    source: 'angelesuero@a-e-space.info',
    reason: 'Surfaced duplicates of roles already represented in the report plus one New Jersey Courts receipt with no role name.',
  },
  {
    source: 'IAG / Independent Artist Group',
    reason: 'Surfaced emails conflicted between “Agency Trainee” and “Summer Intern New York” wording, so the role was held out rather than guessed.',
  },
  {
    source: 'Syska Hennessy Group',
    reason: 'A rejection email surfaced the employer but not the role title clearly enough to classify confidently.',
  },
  {
    source: 'Industrial Bank',
    reason: 'An ADP thank-you email confirmed an application but did not surface the role title.',
  },
  {
    source: 'Role-less LinkedIn sent / reminder emails',
    reason: 'Several older LinkedIn reminders named employers but not a stable role title, so they remained excluded.',
  },
];

const heldOutSourceGroups = heldOutRecords.length + addendumHeldOutRecords.length;
const otherClearApplications = inventorySummary.combinedClearApplications - inventorySummary.directRejections;
const totalRecordedEffort = inventorySummary.combinedClearApplications + inventorySummary.outboundMessages;
const explicitClosureShare = Math.round((inventorySummary.directRejections / inventorySummary.combinedClearApplications) * 100);

const normalizeResponseOrg = (org) => {
  if (/sony music/i.test(org)) return 'Sony Music and related entities';
  if (/universal music group/i.test(org)) return 'Universal Music Group';
  if (/pseg/i.test(org)) return 'PSEG';
  return org;
};

const getResponseMeta = (outcome) => {
  const text = outcome.toLowerCase();

  if (text.includes('position filled')) {
    return { label: 'Position filled', tone: 'filled' };
  }

  if (text.includes('closed') || text.includes('no longer be filling') || text.includes('not to fill')) {
    return { label: 'Position closed / not filled', tone: 'closed' };
  }

  if (
    text.includes('other candidates')
    || text.includes('stronger match')
    || text.includes('considering other candidates')
    || text.includes('moved ahead')
    || text.includes('moved forward')
    || text.includes('pursued other candidates')
    || text.includes('next step')
  ) {
    return { label: 'Other candidates advanced', tone: 'advanced' };
  }

  if (
    text.includes('not selected')
    || text.includes('not move forward')
    || text.includes('would not proceed')
    || text.includes('did not have an appropriate position')
    || text.includes('application was not selected')
    || text.includes('decided not to move forward')
  ) {
    return { label: 'Not selected / no forward movement', tone: 'stopped' };
  }

  return { label: 'Other outcome', tone: 'other' };
};

const rejectionsWithType = rejections.map((record) => ({
  ...record,
  response: getResponseMeta(record.outcome),
  normalizedOrg: normalizeResponseOrg(record.org),
}));

const responsesByYear = Object.entries(
  rejectionsWithType.reduce((acc, record) => {
    const year = record.date.slice(-4);
    acc[year] = (acc[year] || 0) + 1;
    return acc;
  }, {} as Record<string, number>)
)
  .sort((a, b) => Number(b[0]) - Number(a[0]))
  .map(([label, count]) => ({
    label,
    count,
    share: Math.round((count / rejectionsWithType.length) * 100),
  }));

const responsesByType = Object.entries(
  rejectionsWithType.reduce((acc, record) => {
    acc[record.response.label] = (acc[record.response.label] || 0) + 1;
    return acc;
  }, {} as Record<string, number>)
)
  .map(([label, count]) => ({
    label,
    count,
    share: Math.round((count / rejectionsWithType.length) * 100),
  }))
  .sort((a, b) => b.count - a.count);

const repeatedEmployers = Object.entries(
  rejectionsWithType.reduce((acc, record) => {
    acc[record.normalizedOrg] = (acc[record.normalizedOrg] || 0) + 1;
    return acc;
  }, {} as Record<string, number>)
)
  .map(([label, count]) => ({
    label,
    count,
    share: Math.round((count / rejectionsWithType.length) * 100),
  }))
  .sort((a, b) => b.count - a.count)
  .filter((item) => item.count > 1);

const topEmployerResponseCount = repeatedEmployers.slice(0, 3).reduce((sum, item) => sum + item.count, 0);
const topEmployerResponseShare = Math.round((topEmployerResponseCount / rejectionsWithType.length) * 100);
const responseWindow = `${rejections[rejections.length - 1]?.date} to ${rejections[0]?.date}`;
---

<BaseLayout
  title="Rejection Log — a_e.s_"
  description="40 documented rejections inside a 179-application Gmail job-search archive, plus 54 confirmed outbound outreach emails."
  theme="archive"
  bodyClass="rejections-page"
  flatSurface={true}
  forceThemeMode="dark"
>
  <main class="rej-main">
    <section class="rej-header">
      <p class="rej-eyebrow">Job Search Record</p>
      <h1 class="rej-title">Effort and Response Log</h1>
      <p class="rej-subtitle">
        {inventorySummary.combinedClearApplications} clear applications and {inventorySummary.outboundMessages} direct outreach emails are on record. {inventorySummary.directRejections} application records came back with explicit rejection, position-filled, position-closed, or similar language and are listed below.
      </p>
      <div class="rej-link-row">
        <a class="rej-link" href={inventorySummary.reportHref}>Open updated Gmail inventory</a>
        <a class="rej-link" href={inventorySummary.rejectionReportHref}>Open rejection report</a>
      </div>
    </section>

    <section class="rej-ledgers" aria-label="Effort and returned responses">
      <article class="rej-panel rej-ledger">
        <div class="rej-section-head">
          <div>
            <p class="rej-section-label">Effort Recorded</p>
            <h2 class="rej-section-title">What went out</h2>
          </div>
          <p class="rej-section-note">Applications and sent outreach stay separate so the record does not blur them together.</p>
        </div>

        <div class="rej-metric-grid">
          <div class="rej-metric">
            <span class="rej-metric__num">{inventorySummary.combinedClearApplications}</span>
            <span class="rej-metric__label">Clear applications</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{inventorySummary.outboundMessages}</span>
            <span class="rej-metric__label">Sent outreach emails</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{totalRecordedEffort}</span>
            <span class="rej-metric__label">Tracked effort records</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{inventorySummary.reviewedMailboxes}</span>
            <span class="rej-metric__label">Mailboxes reviewed</span>
          </div>
        </div>

        <table class="rej-mini-table">
          <tbody>
            {inventorySummary.mailboxes.map((item) => (
              <tr>
                <td>
                  <strong>{item.mailbox}</strong>
                  <span>{item.note}</span>
                </td>
                <td class="rej-mini-table__count">{item.clearApplications}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </article>

      <article class="rej-panel rej-ledger">
        <div class="rej-section-head">
          <div>
            <p class="rej-section-label">Responses Returned</p>
            <h2 class="rej-section-title">What came back</h2>
          </div>
          <p class="rej-section-note">This panel covers the response side of the {inventorySummary.combinedClearApplications}-application lane only.</p>
        </div>

        <div class="rej-metric-grid">
          <div class="rej-metric">
            <span class="rej-metric__num">{inventorySummary.directRejections}</span>
            <span class="rej-metric__label">Explicit no / closed outcomes</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{explicitClosureShare}%</span>
            <span class="rej-metric__label">Application archive with explicit closure</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{otherClearApplications}</span>
            <span class="rej-metric__label">Applications without explicit closure here</span>
          </div>
          <div class="rej-metric">
            <span class="rej-metric__num">{topEmployerResponseShare}%</span>
            <span class="rej-metric__label">Responses concentrated in top 3 employers</span>
          </div>
        </div>

        <p class="rej-ledger__note">
          Response window in this log: {responseWindow}. The deeper pass added {inventorySummary.deepPassAdditions} older records and raised the application archive from {inventorySummary.priorCombinedClearApplications} to {inventorySummary.combinedClearApplications}.
        </p>
      </article>
    </section>

    <section class="rej-signal-grid" aria-label="Response patterns">
      <article class="rej-panel">
        <div class="rej-section-head">
          <div>
            <p class="rej-section-label">Responses By Year</p>
            <h2 class="rej-section-title">Where the weight landed</h2>
          </div>
        </div>

        <ul class="rej-rank-list">
          {responsesByYear.map((item) => (
            <li class="rej-rank-row">
              <div>
                <strong>{item.label}</strong>
                <span>{item.share}% of the explicit response log</span>
              </div>
              <span class="rej-rank-row__count">{item.count}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rej-panel">
        <div class="rej-section-head">
          <div>
            <p class="rej-section-label">Response Language</p>
            <h2 class="rej-section-title">How employers answered</h2>
          </div>
        </div>

        <ul class="rej-rank-list">
          {responsesByType.map((item) => (
            <li class="rej-rank-row">
              <div>
                <strong>{item.label}</strong>
                <span>{item.share}% of the explicit response log</span>
              </div>
              <span class="rej-rank-row__count">{item.count}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="rej-panel">
        <div class="rej-section-head">
          <div>
            <p class="rej-section-label">Repeated Employers</p>
            <h2 class="rej-section-title">Where responses clustered</h2>
          </div>
        </div>

        <ul class="rej-rank-list">
          {repeatedEmployers.slice(0, 6).map((item) => (
            <li class="rej-rank-row">
              <div>
                <strong>{item.label}</strong>
                <span>{item.share}% of the explicit response log</span>
              </div>
              <span class="rej-rank-row__count">{item.count}</span>
            </li>
          ))}
        </ul>

        <p class="rej-panel__footnote">
          {topEmployerResponseCount} of {inventorySummary.directRejections} explicit responses came from the top three repeated employers.
        </p>
      </article>
    </section>

    <section class="rej-table-section" aria-label="Rejection log">
      <div class="rej-section-head rej-section-head--table">
        <div>
          <p class="rej-section-label">Main Table</p>
          <h2 class="rej-section-title">Explicit responses to documented applications</h2>
        </div>
        <p class="rej-section-note">Most recent first. This table is the direct evidence lane, not the explanation of it.</p>
      </div>

      <div class="rej-table-wrap">
        <table class="rej-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Organization</th>
              <th scope="col">Role</th>
              <th scope="col">Response type</th>
              <th scope="col" class="rej-th--outcome">Response text</th>
            </tr>
          </thead>
          <tbody>
            {rejectionsWithType.map((record) => (
              <tr>
                <td class="rej-td--date">{record.date}</td>
                <td class="rej-td--org">{record.org}</td>
                <td class="rej-td--role">{record.role}</td>
                <td>
                  <span class={`rej-type-chip rej-type-chip--${record.response.tone}`}>{record.response.label}</span>
                </td>
                <td class="rej-td--outcome">{record.outcome}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="rej-method-grid" aria-label="Counting rules">
      <article class="rej-panel">
        <p class="rej-section-label">Counted In The Application Total</p>
        <ul class="rej-list">
          {inventorySummary.included.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="rej-panel">
        <p class="rej-section-label">Not Counted In The Application Total</p>
        <ul class="rej-list rej-list--muted">
          {inventorySummary.excluded.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="rej-panel">
        <p class="rej-section-label">Separate Outreach Lane</p>
        <p class="rej-panel__copy">{inventorySummary.outboundMessages} confirmed sent emails with resumes or transcripts attached appear in the latest PDF.</p>
        <p class="rej-panel__copy">{outboundSummary.note}</p>
        <p class="rej-panel__copy rej-panel__copy--muted">Included: {outboundSummary.included}</p>
        <p class="rej-panel__copy rej-panel__copy--muted">Not included: {outboundSummary.excluded}</p>
      </article>
    </section>

    <section class="rej-appendix">
      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">Appendix — Records reviewed but not counted ({heldOutSourceGroups} source groups)</summary>
        <div class="rej-disclosure__body">
          <p class="rej-appendix__intro">
            These records were reviewed during the Gmail search but left out of the application total because they were ambiguous, incomplete, duplicates, or not job applications.
          </p>
          <table class="rej-table rej-table--small">
            <thead>
              <tr>
                <th scope="col">Source</th>
                <th scope="col" class="rej-th--outcome">Why it stayed out</th>
              </tr>
            </thead>
            <tbody>
              {heldOutRecords.map((record) => (
                <tr>
                  <td class="rej-td--org">{record.source}</td>
                  <td class="rej-td--outcome">{record.reason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>

      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">Appendix — Deep-pass records not counted ({addendumHeldOutRecords.length})</summary>
        <div class="rej-disclosure__body">
          <p class="rej-appendix__intro">
            These records surfaced during the deep pass, but they still did not qualify as new clear applications.
          </p>
          <table class="rej-table rej-table--small">
            <thead>
              <tr>
                <th scope="col">Source</th>
                <th scope="col" class="rej-th--outcome">Why it stayed out</th>
              </tr>
            </thead>
            <tbody>
              {addendumHeldOutRecords.map((record) => (
                <tr>
                  <td class="rej-td--org">{record.source}</td>
                  <td class="rej-td--outcome">{record.reason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>

      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">Appendix — Outbound outreach samples ({outboundHighlights.length} shown)</summary>
        <div class="rej-disclosure__body">
          <p class="rej-appendix__intro">
            The latest PDF includes {inventorySummary.outboundMessages} confirmed sent outreach emails. The sample below shows part of that separate appendix.
          </p>
          <table class="rej-table rej-table--small">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">From account</th>
                <th scope="col">Recipient / org</th>
                <th scope="col" class="rej-th--outcome">Subject</th>
              </tr>
            </thead>
            <tbody>
              {outboundHighlights.map((record) => (
                <tr>
                  <td class="rej-td--date">{record.date}</td>
                  <td class="rej-td--account">{record.account}</td>
                  <td class="rej-td--org">{record.recipient}</td>
                  <td class="rej-td--subject">{record.subject}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="rej-appendix__footnote">Included in this appendix: {outboundSummary.included}</p>
          <p class="rej-appendix__footnote rej-appendix__footnote--muted">Not included in this appendix: {outboundSummary.excluded}</p>
        </div>
      </details>

      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">Appendix — Fellowship note</summary>
        <div class="rej-disclosure__body">
          <table class="rej-table rej-table--small">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Organization</th>
                <th scope="col">Role</th>
                <th scope="col" class="rej-th--outcome">Note</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="rej-td--date">{fellowship.date}</td>
                <td class="rej-td--org">{fellowship.org}</td>
                <td class="rej-td--role">{fellowship.role}</td>
                <td class="rej-td--outcome">{fellowship.outcome}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

