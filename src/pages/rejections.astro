const inventorySummary = {
  searchDate: 'Mar 24, 2026',
  combinedClearApplications: 179,
  outboundMessages: 54,
  directRejections: rejections.length,
  reportHref: '/documents/combined-gmail-job-applications-inventory.pdf',
};
const explicitClosureShare = Math.round((inventorySummary.directRejections / inventorySummary.combinedClearApplications) * 100);
const countingRules = [
  'Included: job or internship applications where the employer and role were visible in the email record.',
  'Excluded: incomplete applications, duplicates, reminders, and non-employment email trails.',
  'Outreach: sent emails with attachments and clear job-search context were tracked separately.',
];
---

<BaseLayout
  title="Rejection Log — a_e.s_"
  description="179 clear applications, 54 outreach emails, and 40 explicit outcomes from a Gmail job-search archive."
  theme="archive"
  bodyClass="rejections-page"
  flatSurface={true}
  forceThemeMode="dark"
>
  <main class="rej-main">
    <section class="rej-header">
      <p class="rej-eyebrow">Job Search Record</p>
      <h1 class="rej-title">Effort and Response Log</h1>
      <p class="rej-subtitle">
        You put out {inventorySummary.combinedClearApplications} clear applications and {inventorySummary.outboundMessages} outreach emails. {inventorySummary.directRejections} of those attempts came back with an explicit outcome.
      </p>
      <div class="rej-link-row">
        <a class="rej-link" href={inventorySummary.reportHref}>Open source PDF</a>
      </div>
    </section>

    <section class="rej-ledgers" aria-label="Effort and returned responses">
      <article class="rej-panel rej-ledger">
        <p class="rej-section-label">Effort Recorded</p>
        <h2 class="rej-section-title">What went out</h2>

        <div class="rej-stat-grid">
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.combinedClearApplications}</span>
            <span class="rej-stat__label">Clear applications</span>
          </div>
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.outboundMessages}</span>
            <span class="rej-stat__label">Sent outreach emails</span>
          </div>
        </div>

        <p class="rej-ledger__note">Applications are the main effort. Outreach sits beside them as direct contact.</p>
      </article>

      <article class="rej-panel rej-ledger">
        <p class="rej-section-label">Responses Returned</p>
        <h2 class="rej-section-title">What came back</h2>

        <div class="rej-stat-grid">
          <div class="rej-stat">
            <span class="rej-stat__num">{inventorySummary.directRejections}</span>
            <span class="rej-stat__label">Explicit outcomes</span>
          </div>
          <div class="rej-stat">
            <span class="rej-stat__num">{explicitClosureShare}%</span>
            <span class="rej-stat__label">Closure rate</span>
          </div>
        </div>

        <p class="rej-ledger__note">These are the returns that show what the effort produced.</p>
      </article>
    </section>

    <section class="rej-table-section" aria-label="Rejection log">
      <div class="rej-section-head rej-section-head--table">
        <div>
          <p class="rej-section-label">Evidence</p>
          <h2 class="rej-section-title">The 40 explicit outcomes</h2>
        </div>
        <p class="rej-section-note">Most recent first. This is the direct record of what came back.</p>
      </div>

      <div class="rej-table-wrap">
        <table class="rej-table">
          <thead>
            <tr>
              <th scope="col">Date</th>
              <th scope="col">Organization</th>
              <th scope="col">Role</th>
              <th scope="col" class="rej-th--outcome">Outcome</th>
            </tr>
          </thead>
          <tbody>
            {rejections.map((record) => (
              <tr>
                <td class="rej-td--date">{record.date}</td>
                <td class="rej-td--org">{record.org}</td>
                <td class="rej-td--role">{record.role}</td>
                <td class="rej-td--outcome">{record.outcome}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="rej-notes" aria-label="Counting rules">
      <details class="rej-disclosure">
        <summary class="rej-disclosure__summary">How this was counted</summary>
        <div class="rej-disclosure__body">
          <ul class="rej-list">
            {countingRules.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <p class="rej-appendix__footnote">The source PDF has the longer archive review if you want the extra context.</p>
        </div>
      </details>
    </section>
  </main>
</BaseLayout>

