---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatLongUtcDate } from '../lib/date-formatting';
import { getEntryVoiceExcerpt } from '../lib/archive-entries';
import { getAllEntries } from '../lib/site-collections';
import '../styles/pages/studio-notes.css';

const allEntries = await getAllEntries();
const notes = allEntries
  .filter(e => e.data.medium === 'note')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const mediumIcon: Record<string, string> = {
  music: '♪',
  video: '▶',
  writing: '✦',
  image: '◈',
  note: '◦',
  proposal: '⬡'
};
---

<BaseLayout title="Studio Notes — a_e.s_" theme="archive">
  <section class="view-surface studio-notes-page">
    <header class="view-surface-header studio-notes-header">
      <p class="view-surface-kicker">Active thinking</p>
      <h1>Studio Notes</h1>
      <p class="studio-notes-intro">
        Observations, fragments, and process notes from ongoing work. These exist as they are — unfinished thoughts held in the public record.
      </p>
      <div class="studio-notes-meta">
        <p>{notes.length} {notes.length === 1 ? 'note' : 'notes'}</p>
      </div>
    </header>

    {notes.length === 0 ? (
      <p class="studio-notes-empty">No studio notes yet.</p>
    ) : (
      <ul class="studio-notes-list">
        {notes.map((note) => (
          <li class="studio-note-item">
            <article>
              <header class="studio-note-header">
                <div class="studio-note-title-row">
                  <span class="studio-note-icon" aria-hidden="true">{mediumIcon.note}</span>
                  <h2 class="studio-note-title">{note.data.title}</h2>
                </div>
                <time class="studio-note-date">{formatLongUtcDate(note.data.date)}</time>
              </header>

              <p class="studio-note-summary">{getEntryVoiceExcerpt(note, 180)}</p>

              {note.data.tags && note.data.tags.length > 0 && (
                <div class="studio-note-tags">
                  {note.data.tags.map((tag: string) => (
                    <span class="studio-note-tag">{tag}</span>
                  ))}
                </div>
              )}
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

