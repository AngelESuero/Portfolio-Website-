---
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatLongUtcDate } from '../lib/date-formatting';
import { getEntryVoiceExcerpt } from '../lib/archive-entries';
import { getAllEntries } from '../lib/site-collections';

const allEntries = await getAllEntries();
const notes = allEntries
  .filter(e => e.data.medium === 'note')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const mediumIcon: Record<string, string> = {
  music: '♪',
  video: '▶',
  writing: '✦',
  image: '◈',
  note: '◦',
  proposal: '⬡'
};
---

<BaseLayout title="Studio Notes — a_e.s_" theme="archive">
  <section class="view-surface studio-notes-page">
    <header class="view-surface-header studio-notes-header">
      <p class="view-surface-kicker">Active thinking</p>
      <h1>Studio Notes</h1>
      <p class="studio-notes-intro">
        Observations, fragments, and process notes from ongoing work. These exist as they are — unfinished thoughts held in the public record.
      </p>
      <div class="studio-notes-meta">
        <p>{notes.length} {notes.length === 1 ? 'note' : 'notes'}</p>
      </div>
    </header>

    {notes.length === 0 ? (
      <p class="studio-notes-empty">No studio notes yet.</p>
    ) : (
      <ul class="studio-notes-list">
        {notes.map((note) => (
          <li class="studio-note-item">
            <article>
              <header class="studio-note-header">
                <div class="studio-note-title-row">
                  <span class="studio-note-icon" aria-hidden="true">{mediumIcon.note}</span>
                  <h2 class="studio-note-title">{note.data.title}</h2>
                </div>
                <time class="studio-note-date">{formatLongUtcDate(note.data.date)}</time>
              </header>

              <p class="studio-note-summary">{getEntryVoiceExcerpt(note, 180)}</p>

              {note.data.tags && note.data.tags.length > 0 && (
                <div class="studio-note-tags">
                  {note.data.tags.map((tag: string) => (
                    <span class="studio-note-tag">{tag}</span>
                  ))}
                </div>
              )}
            </article>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .studio-notes-page {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
  }

  .studio-notes-header {
    max-width: 68ch;
  }

  .studio-notes-intro {
    margin: 0.6rem 0 0;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .studio-notes-meta {
    margin-top: 0.9rem;
    display: flex;
    gap: 1.5rem;
    font-size: 0.88rem;
    color: var(--tone-muted);
  }

  .studio-notes-meta p {
    margin: 0;
  }

  .studio-notes-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .studio-note-item {
    border: 1px solid var(--line2);
    border-radius: calc(var(--radius) * var(--space-scale));
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tone-surface-strong) 56%, transparent),
      color-mix(in srgb, var(--tone-surface) 46%, transparent)
    );
    padding: clamp(0.95rem, 2vw, 1.2rem);
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .studio-note-item:hover {
    border-color: color-mix(in srgb, var(--line2) 140%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tone-surface-strong) 66%, transparent),
      color-mix(in srgb, var(--tone-surface) 56%, transparent)
    );
  }

  .studio-note-item article {
    display: grid;
    gap: 0.7rem;
  }

  .studio-note-header {
    display: grid;
    gap: 0.5rem;
  }

  .studio-note-title-row {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .studio-note-icon {
    font-size: 0.95rem;
    color: var(--tone-accent-glow);
    flex-shrink: 0;
  }

  .studio-note-title {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.3;
  }

  .studio-note-date {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tone-muted);
  }

  .studio-note-summary {
    margin: 0;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .studio-note-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }

  .studio-note-tag {
    display: inline-block;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.25rem 0.45rem;
    border-radius: 0.3rem;
    background: color-mix(in srgb, var(--tone-accent) 12%, transparent);
    color: var(--tone-accent-glow);
  }

  .studio-notes-empty {
    color: var(--tone-muted);
    font-style: italic;
  }
</style>
