---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedCard from '../components/EmbedCard.astro';
import { LINK_HUB_CATEGORIES, LINK_HUB_ICONS } from '../data/linkhub';
import LinkHubLaneShell from '../components/LinkHubLaneShell.astro';
import { LINK_HUB_LANES } from '../data/linkhub-lanes';
import '../styles/pages/link-hub.css';

const ACCENT_SWATCHES: Record<string, string> = {
  yellow: '#dcc56e',
  blue: '#7cb8c0',
  orange: '#d6a06b',
  red: '#c77b73',
  white: '#eadfc0',
  black: '#6b6158',
  violet: '#a28ed0',
  indigo: '#7392c1'
};
const getAccentSwatch = (value?: string) => ACCENT_SWATCHES[String(value || '').trim().toLowerCase()] || ACCENT_SWATCHES.blue;

const categoryIds = LINK_HUB_CATEGORIES.map((category) => category.id);
const defaultItems = Object.fromEntries(
  LINK_HUB_CATEGORIES.map((category) => [category.id, category.items[0]?.id || ''])
);
const categoryColors = Object.fromEntries(LINK_HUB_CATEGORIES.map((category) => [category.id, category.color]));
---

<BaseLayout
  title="Link Hub — a_e.s_"
  description="Timeline-style link hub with category lanes, tabs, and embeddable links."
  theme="hub"
>
  <section class="hub-page">
    <header class="hub-header">
      <p class="hub-kicker">Timeline hub</p>
      <h1>Link Hub</h1>
      <p class="hub-dek">Curated routes by lane. Open what you need, then return to the native archive pages.</p>
    </header>

    <nav class="hub-icons lab-only" aria-label="Primary links">
      {LINK_HUB_ICONS.map((item) => (
        <a href={item.url} {...(/^https?:\/\//i.test(item.url) ? { target: '_blank', rel: 'noopener' } : {})} aria-label={`Open ${item.title}`}>
          <span>{item.icon}</span>
          <small>{item.title}</small>
        </a>
      ))}
    </nav>

    <div class="hub-tabs" role="tablist" aria-label="Link categories">
      {LINK_HUB_CATEGORIES.map((category, index) => (
        <button
          type="button"
          role="tab"
          id={`hub-tab-${category.id}`}
          aria-controls={`hub-panel-${category.id}`}
          style={`--hub-accent:${getAccentSwatch(category.color)}`}
          data-hub-tab={category.id}
          data-color={category.color}
          aria-selected={index === 0 ? 'true' : 'false'}
          class:list={[index === 0 && 'is-active']}
        >
          {category.label}
        </button>
      ))}
    </div>

    {LINK_HUB_CATEGORIES.map((category, index) => (
      <section
        class:list={['hub-panel', index === 0 && 'is-active']}
        id={`hub-panel-${category.id}`}
        role="tabpanel"
        aria-labelledby={`hub-tab-${category.id}`}
        style={`--hub-accent:${getAccentSwatch(category.color)}`}
        data-hub-panel={category.id}
        aria-label={`${category.label} links`}
      >
        <LinkHubLaneShell lane={LINK_HUB_LANES[category.id]}>
          <div class="hub-subtabs" role="tablist" aria-label={`${category.label} links`}>
            {category.items.map((item, itemIndex) => (
              <button
                type="button"
                role="tab"
                id={`hub-link-tab-${category.id}-${item.id}`}
                aria-controls={`hub-link-panel-${category.id}-${item.id}`}
                style={`--hub-accent:${getAccentSwatch(category.color)}`}
                data-hub-link-tab={item.id}
                data-hub-link-category={category.id}
                data-color={category.color}
                aria-selected={itemIndex === 0 ? 'true' : 'false'}
                class:list={[itemIndex === 0 && 'is-active']}
              >
                {item.title}
              </button>
            ))}
          </div>

          {category.items.map((item, itemIndex) => (
            <div
              class:list={['hub-link-panel', itemIndex === 0 && 'is-active']}
              id={`hub-link-panel-${category.id}-${item.id}`}
              role="tabpanel"
              aria-labelledby={`hub-link-tab-${category.id}-${item.id}`}
              data-hub-link-panel={item.id}
              data-hub-link-category={category.id}
              aria-label={`${item.title} panel`}
            >
              <EmbedCard item={item} />

              {category.id === 'writing' && item.id === 'substack' && (
                <aside class="hub-latest" data-substack-latest>
                  <h3>Latest Substack posts</h3>
                  <p class="hub-latest-status" data-substack-status>Loading latest entries...</p>
                  <ul data-substack-list></ul>
                </aside>
              )}
            </div>
          ))}
        </LinkHubLaneShell>
      </section>
    ))}
  </section>

  <script is:inline define:vars={{ categoryIds, defaultItems, categoryColors }}>
    (() => {
      const tabs = Array.from(document.querySelectorAll('[data-hub-tab]'));
      const panels = Array.from(document.querySelectorAll('[data-hub-panel]'));
      if (!tabs.length || !panels.length) return;

      const categoryState = { ...(defaultItems || {}) };
      const resolveCategoryColor = (categoryId) => categoryColors?.[categoryId] || 'blue';

      const setActiveLink = (categoryId, itemId, syncAccent = true, focus = false) => {
        const linkTabs = Array.from(document.querySelectorAll(`[data-hub-link-category="${categoryId}"][data-hub-link-tab]`));
        const linkPanels = Array.from(document.querySelectorAll(`[data-hub-link-category="${categoryId}"][data-hub-link-panel]`));
        let activeColor = resolveCategoryColor(categoryId);

        linkTabs.forEach((tab) => {
          const active = tab.getAttribute('data-hub-link-tab') === itemId;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.setAttribute('tabindex', active ? '0' : '-1');
          if (active) activeColor = tab.getAttribute('data-color') || activeColor;
        });

        linkPanels.forEach((panel) => {
          const active = panel.getAttribute('data-hub-link-panel') === itemId;
          panel.classList.toggle('is-active', active);
          if (active) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        categoryState[categoryId] = itemId;
        if (syncAccent) window.__setSiteAccent?.(activeColor, { animate: true, duration: 250 });
        if (focus) {
          const activeTab = linkTabs.find((tab) => tab.getAttribute('data-hub-link-tab') === itemId);
          activeTab?.focus();
        }
      };

      const setActiveCategory = (categoryId, syncAccent = true, focus = false) => {
        if (!Array.isArray(categoryIds) || !categoryIds.includes(categoryId)) return;

        tabs.forEach((tab) => {
          const active = tab.getAttribute('data-hub-tab') === categoryId;
          tab.classList.toggle('is-active', active);
          tab.setAttribute('aria-selected', String(active));
          tab.setAttribute('tabindex', active ? '0' : '-1');
        });

        panels.forEach((panel) => {
          const active = panel.getAttribute('data-hub-panel') === categoryId;
          panel.classList.toggle('is-active', active);
          if (active) {
            panel.removeAttribute('hidden');
          } else {
            panel.setAttribute('hidden', '');
          }
        });

        if (syncAccent) window.__setSiteAccent?.(resolveCategoryColor(categoryId), { animate: true, duration: 250 });

        const itemId = categoryState[categoryId];
        if (itemId) setActiveLink(categoryId, itemId, false);
        if (focus) {
          const activeTab = tabs.find((tab) => tab.getAttribute('data-hub-tab') === categoryId);
          activeTab?.focus();
        }
      };

      tabs.forEach((tab, index) => {
        tab.setAttribute('tabindex', index === 0 ? '0' : '-1');
        tab.addEventListener('click', () => {
          const categoryId = tab.getAttribute('data-hub-tab');
          if (categoryId) setActiveCategory(categoryId);
        });
        tab.addEventListener('keydown', (event) => {
          const currentIndex = tabs.indexOf(tab);
          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            event.preventDefault();
            const nextTab = tabs[(currentIndex + 1) % tabs.length];
            const nextCategoryId = nextTab.getAttribute('data-hub-tab');
            if (nextCategoryId) setActiveCategory(nextCategoryId, true, true);
            return;
          }
          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            event.preventDefault();
            const previousTab = tabs[(currentIndex - 1 + tabs.length) % tabs.length];
            const previousCategoryId = previousTab.getAttribute('data-hub-tab');
            if (previousCategoryId) setActiveCategory(previousCategoryId, true, true);
            return;
          }
          if (event.key === 'Home') {
            event.preventDefault();
            const firstCategoryId = tabs[0]?.getAttribute('data-hub-tab');
            if (firstCategoryId) setActiveCategory(firstCategoryId, true, true);
            return;
          }
          if (event.key === 'End') {
            event.preventDefault();
            const lastCategoryId = tabs[tabs.length - 1]?.getAttribute('data-hub-tab');
            if (lastCategoryId) setActiveCategory(lastCategoryId, true, true);
          }
        });
      });

      const allLinkTabs = Array.from(document.querySelectorAll('[data-hub-link-tab]'));
      allLinkTabs.forEach((tab, index) => {
        tab.setAttribute('tabindex', index === 0 ? '0' : '-1');
        tab.addEventListener('click', () => {
          const categoryId = tab.getAttribute('data-hub-link-category');
          const itemId = tab.getAttribute('data-hub-link-tab');
          if (!categoryId || !itemId) return;
          setActiveLink(categoryId, itemId);
        });
        tab.addEventListener('keydown', (event) => {
          const categoryId = tab.getAttribute('data-hub-link-category');
          const itemId = tab.getAttribute('data-hub-link-tab');
          if (!categoryId || !itemId) return;

          const groupTabs = Array.from(
            document.querySelectorAll(`[data-hub-link-category="${categoryId}"][data-hub-link-tab]`)
          );
          const currentIndex = groupTabs.indexOf(tab);

          if (event.key === 'ArrowRight' || event.key === 'ArrowDown') {
            event.preventDefault();
            const nextTab = groupTabs[(currentIndex + 1) % groupTabs.length];
            const nextItemId = nextTab.getAttribute('data-hub-link-tab');
            if (nextItemId) setActiveLink(categoryId, nextItemId, true, true);
            return;
          }

          if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
            event.preventDefault();
            const previousTab = groupTabs[(currentIndex - 1 + groupTabs.length) % groupTabs.length];
            const previousItemId = previousTab.getAttribute('data-hub-link-tab');
            if (previousItemId) setActiveLink(categoryId, previousItemId, true, true);
            return;
          }

          if (event.key === 'Home') {
            event.preventDefault();
            const firstItemId = groupTabs[0]?.getAttribute('data-hub-link-tab');
            if (firstItemId) setActiveLink(categoryId, firstItemId, true, true);
            return;
          }

          if (event.key === 'End') {
            event.preventDefault();
            const lastItemId = groupTabs[groupTabs.length - 1]?.getAttribute('data-hub-link-tab');
            if (lastItemId) setActiveLink(categoryId, lastItemId, true, true);
          }
        });
      });

      const latestBlocks = Array.from(document.querySelectorAll('[data-substack-latest]'));
      const loadSubstack = async () => {
        if (!latestBlocks.length) return;

        const setStatus = (message) => {
          latestBlocks.forEach((block) => {
            const status = block.querySelector('[data-substack-status]');
            if (status) status.textContent = message;
          });
        };

        try {
          const response = await fetch('/api/social-rss/substack.json');
          if (!response.ok) throw new Error(`RSS endpoint returned ${response.status}`);
          const payload = await response.json();
          const items = Array.isArray(payload?.items) ? payload.items.slice(0, 5) : [];

          latestBlocks.forEach((block) => {
            const list = block.querySelector('[data-substack-list]');
            if (!(list instanceof HTMLElement)) return;
            list.innerHTML = '';

            if (!items.length) {
              const status = block.querySelector('[data-substack-status]');
              if (status) status.textContent = payload?.message || 'No recent entries available.';
              return;
            }

            items.forEach((item) => {
              const li = document.createElement('li');
              const link = document.createElement('a');
              link.href = item.url || '#';
              link.target = '_blank';
              link.rel = 'noopener';
              link.textContent = item.title || item.url || 'Untitled post';

              const meta = document.createElement('span');
              if (item.date) {
                const date = new Date(item.date);
                meta.textContent = Number.isNaN(date.valueOf())
                  ? item.date
                  : new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).format(date);
              }

              li.appendChild(link);
              if (meta.textContent) li.appendChild(meta);
              list.appendChild(li);
            });

            const status = block.querySelector('[data-substack-status]');
            if (status) status.textContent = `Showing ${items.length} latest item${items.length === 1 ? '' : 's'}.`;
          });
        } catch {
          setStatus('Could not load Substack latest posts right now.');
        }
      };

      setActiveCategory(Array.isArray(categoryIds) && categoryIds[0] ? categoryIds[0] : 'music', false);
      loadSubstack();
    })();
  </script>
</BaseLayout>
