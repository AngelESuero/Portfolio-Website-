---
import BaseLayout from '../layouts/BaseLayout.astro';
import CrossRouteResume from '../components/CrossRouteResume.astro';
import profile from '../data/profile';
import { MUSIC_URLS, SOCIAL_URLS, VIDEO_URLS } from '../data/site-refs';
import { getAllEntries } from '../lib/site-collections';
import { getEntryHref, sortEntriesByDate } from '../lib/archive-entries';

const spotifyVol4EmbedUrl = 'https://open.spotify.com/embed/playlist/1aeafuJB347VmKXu4jvaTO';
const soundcloudVol4Url = 'https://soundcloud.com/aesuero/sets/volume-4-angel-sueros-top-50';

type NativeAudioBite = {
  title: string;
  source: string;
  href: string;
  note: string;
  src: string;
  mime: string;
  duration?: string;
};

type ExternalAudioBite = {
  title: string;
  source: string;
  href: string;
  note: string;
  presentation: 'embed' | 'handoff';
  linkLabel: string;
  embedUrl?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  handoffCopy?: string;
};

type AudioBite = NativeAudioBite | ExternalAudioBite;

const watchClips = [
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/2CKfTl0scAf.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/2CKfTl0scAf-poster.png',
    note: 'A direct cut from the archive, kept loose and physical.'
  },
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/2ycBgc6PYPZ.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/2ycBgc6PYPZ-poster.png',
    note: 'Different frame, same pressure.'
  },
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/7e3ZWjDFxaL.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/7e3ZWjDFxaL-poster.png',
    note: 'Another angle for the same emotional weather.'
  },
  {
    title: 'Death of My Feminine',
    year: '2022',
    kind: 'Demo clip',
    src: '/media/work/scraps/death-of-my-feminine-demos-2022/5MYgthfeSOc.mp4',
    poster: '/images/work/scraps/death-of-my-feminine-demos-2022/5MYgthfeSOc-poster.png',
    note: 'An earlier demo lane, kept close for mood and movement.'
  }
];

const audioBites: AudioBite[] = [
  {
    title: 'SCRAPS AFTER HEARTBREAKS',
    source: 'Native audio',
    href: '/archive/music/scraps-after-heartbreaks',
    note: 'A direct playable file from the archive.',
    src: 'https://pub-cc1abfe7e4f342ddb929a047f6d5b3f3.r2.dev/studio/music/2026-02-01/scraps-after-heartbreaks-3c977bc4.mp3',
    mime: 'audio/mpeg',
    duration: '2:11'
  },
  {
    title: 'My First Beat Tape',
    source: 'Untitled',
    href: '/archive/music/my-first-beat-tape',
    note: 'A clean listening point from Untitled.',
    presentation: 'embed',
    linkLabel: 'Open archive entry',
    embedUrl: MUSIC_URLS.untitledMyFirstBeatTape,
    secondaryHref: MUSIC_URLS.untitledMyFirstBeatTape,
    secondaryLabel: 'Listen on Untitled'
  },
  {
    title: 'Queries (The Beat Tape): Family... Love?',
    source: 'Untitled',
    href: '/archive/music/queries-the-beat-tape-family-love',
    note: 'Family and love held as one connected sequence.',
    presentation: 'handoff',
    linkLabel: 'Open archive entry',
    secondaryHref: MUSIC_URLS.untitledQueriesBeatTape,
    secondaryLabel: 'Listen on Untitled',
    handoffCopy: 'Untitled keeps this piece off the inline player here, so the archive entry and source page stay linked instead.'
  },
  {
    title: 'The Every Day Soundscape',
    source: 'Untitled',
    href: '/archive/music/the-every-day-soundscape',
    note: 'A neighboring atmospheric fragment.',
    presentation: 'handoff',
    linkLabel: 'Open archive entry',
    secondaryHref: MUSIC_URLS.untitledEveryDaySoundscape,
    secondaryLabel: 'Listen on Untitled',
    handoffCopy: 'This record opens more reliably from the archive and original Untitled page than it does as an embedded frame.'
  },
  {
    title: 'Now Listening (Vol 4)',
    source: 'Spotify',
    href: MUSIC_URLS.spotifyVol4,
    note: 'Current playlist pressure and reference zone.',
    presentation: 'embed',
    linkLabel: 'Open source',
    embedUrl: spotifyVol4EmbedUrl
  },
  {
    title: 'Volume 4 - SoundCloud',
    source: 'SoundCloud',
    href: soundcloudVol4Url,
    note: 'Another listening lane when the mood wants a different container.',
    presentation: 'embed',
    linkLabel: 'Open source',
    embedUrl: `https://w.soundcloud.com/player/?url=${encodeURIComponent(soundcloudVol4Url)}&color=%23b97a2d&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`
  }
];

const inspirationPhotos = [
  { src: '/images/home-preview/collage-2.jpg', alt: 'Collaged photo inspiration in warm tones.' },
  { src: '/images/home-preview/collage-5.jpg', alt: 'A darker collage fragment from the home archive.' },
  { src: '/images/home-preview/download-3.jpg', alt: 'Personal photo archive image.' },
  { src: '/images/work/art-of-survival/isolation.jpg', alt: 'A still from The Art of Survival.' },
  { src: '/images/home-preview/download-5.jpg', alt: 'Black and white portrait from the photo strip.' },
  { src: '/images/home-preview/collage-7.jpg', alt: 'Another collage element with saturated color.' },
  { src: '/images/home-preview/download-7.jpg', alt: 'Archive photo with soft light.' },
  { src: '/images/home-preview/collage-4.jpg', alt: 'A collage detail used as visual texture.' }
];

const referenceLinks = [
  { href: SOCIAL_URLS.youtube, label: 'YouTube' },
  { href: SOCIAL_URLS.soundcloud, label: 'SoundCloud' },
  { href: MUSIC_URLS.spotifyVol4, label: 'Spotify' },
  { href: MUSIC_URLS.untitledMyFirstBeatTape, label: 'Untitled' },
  { href: VIDEO_URLS.everydayLifeVideo, label: 'Everyday Life video' }
];

const rotationQueue = [
  { title: 'SCRAPS After Heartbreaks', cue: 'archive cut' },
  { title: 'Now Listening (Vol 4)', cue: 'playlist' },
  { title: 'Queries (The Beat Tape)', cue: 'untitled lane' },
  { title: 'Volume 4', cue: 'soundcloud set' }
];
const musicEntries = sortEntriesByDate((await getAllEntries()).filter((entry) => entry.data.medium === 'music'));
const featuredListeningEntry = musicEntries[0] ?? null;
const fallbackFeaturedSummary = 'Open this first for the latest archive-facing listening context.';
const shelfDefinitions = [
  {
    id: 'recent',
    title: 'Recent archive drops',
    note: 'Newest entries, in release order.',
    items: musicEntries.slice(0, 5)
  },
  {
    id: 'scraps',
    title: 'Scraps and rough cuts',
    note: 'Loose records that keep texture and process visible.',
    items: musicEntries.filter((entry) => `${entry.slug} ${entry.data.title}`.toLowerCase().includes('scraps')).slice(0, 5)
  },
  {
    id: 'tapes',
    title: 'Tape and set containers',
    note: 'Longer run structures for replay, sequencing, and return.',
    items: musicEntries
      .filter((entry) => /(tape|volume|queries)/i.test(`${entry.slug} ${entry.data.title}`))
      .slice(0, 5)
  }
].filter((shelf) => shelf.items.length > 0);

const getFeaturedMetaFromEntry = (entry: (typeof musicEntries)[number] | null, fallbackSummary = fallbackFeaturedSummary) => {
  if (!entry) {
    return {
      title: 'The music archive is still being assembled.',
      summary: 'No archive entries are available yet.',
      href: '/archive/music',
      cta: 'Open full music archive'
    };
  }

  return {
    title: entry.data.title,
    summary: entry.data.summary || fallbackSummary,
    href: getEntryHref(entry),
    cta: 'Open featured entry'
  };
};

const defaultFeaturedMeta = getFeaturedMetaFromEntry(featuredListeningEntry);
const libraryViewData = {
  all: {
    label: 'All containers',
    summary: 'Viewing every shelf in the library.',
    featured: defaultFeaturedMeta
  },
  ...Object.fromEntries(
    shelfDefinitions.map((shelf) => [
      shelf.id,
      {
        label: shelf.title,
        summary: `Viewing ${shelf.title.toLowerCase()}.`,
        featured: getFeaturedMetaFromEntry(shelf.items[0] ?? featuredListeningEntry, shelf.note)
      }
    ])
  )
};
---

<BaseLayout
  title="Music Inspiration - a_e.s_"
  description={`Videos, audio bites, and photos that keep ${profile.name} inspired.`}
  theme="archive"
  bodyClass="music-page"
  flatSurface={true}
>
  <main class="music-page__shell">
    <header class="music-hero">
      <p class="music-hero__eyebrow">Always nearby</p>
      <h1>Music Inspiration</h1>
      <p class="music-hero__lede">
        A living wall of videos, audio bites, and photos that stay open when I want to hear the next thing before it
        exists.
      </p>
      <nav class="music-hero__nav" aria-label="Jump to media sections">
        <a href="#library">Library</a>
        <a href="#watch">Watch</a>
        <a href="#listen">Listen</a>
        <a href="#browse">Browse</a>
      </nav>
      <ul class="music-hero__queue" aria-label="Current listening rotation">
        {rotationQueue.map((item) => (
          <li>
            <span>{item.title}</span>
            <small>{item.cue}</small>
          </li>
        ))}
      </ul>
    </header>

    <section class="music-section music-section--library" id="library" aria-labelledby="music-library-heading">
      <div class="music-section__head">
        <p class="music-section__kicker">Library</p>
        <h2 id="music-library-heading">Curated listening containers</h2>
      </div>

      <nav class="music-library__filters" aria-label="Choose a library container">
        <button type="button" class="music-library-filter is-active" data-library-view="all" aria-pressed="true">
          All containers
        </button>
        {shelfDefinitions.map((shelf) => (
          <button type="button" class="music-library-filter" data-library-view={shelf.id} aria-pressed="false">
            {shelf.title}
          </button>
        ))}
      </nav>
      <p class="music-library__state" data-library-state>Viewing every shelf in the library.</p>

      <div class="music-library">
        <article class="music-library__featured" data-library-featured>
          <p class="music-library__label">Current entry point</p>
          {featuredListeningEntry ? (
            <>
              <h3 data-library-featured-title>{defaultFeaturedMeta.title}</h3>
              <p data-library-featured-summary>{defaultFeaturedMeta.summary}</p>
              <div class="music-library__actions">
                <a href={defaultFeaturedMeta.href} data-library-featured-primary>{defaultFeaturedMeta.cta}</a>
                <a href="/archive/music">Open full music archive</a>
              </div>
            </>
          ) : (
            <p>The music archive is still being assembled.</p>
          )}
        </article>

        <div class="music-library__shelves">
          {shelfDefinitions.map((shelf) => (
            <article class="music-shelf" data-library-shelf={shelf.id}>
              <header>
                <h3>{shelf.title}</h3>
                <p>{shelf.note}</p>
              </header>
              <ol>
                {shelf.items.map((entry) => (
                  <li>
                    <a href={getEntryHref(entry)}>{entry.data.title}</a>
                    <span>{entry.data.date.toISOString().slice(0, 10)}</span>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="music-section music-section--watch" id="watch" aria-labelledby="music-watch-heading">
      <div class="music-section__head">
        <p class="music-section__kicker">Watch</p>
        <h2 id="music-watch-heading">Moving clips</h2>
      </div>

      <div class="music-video-grid">
        {watchClips.map((clip) => (
          <article class="music-video">
            <div class="music-video__meta">
              <span>{clip.kind}</span>
              <span>{clip.year}</span>
            </div>
            <h3>{clip.title}</h3>
            <video controls preload="metadata" playsinline poster={clip.poster}>
              <source src={clip.src} type="video/mp4" />
            </video>
            <p>{clip.note}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="music-section music-section--listen" id="listen" aria-labelledby="music-listen-heading">
      <div class="music-section__head">
        <p class="music-section__kicker">Listen</p>
        <h2 id="music-listen-heading">Audio bites</h2>
      </div>

      <div class="music-audio-stack">
        {audioBites.map((item, index) => (
          <article class="music-audio-row" id={`listen-${index + 1}`}>
            <div class="music-audio-row__meta">
              <p class="music-audio-row__source">{item.source}</p>
              <h3>{item.title}</h3>
              <p class="music-audio-row__note">{item.note}</p>
            </div>

            {'src' in item ? (
              <div class="music-audio-row__player music-audio-row__player--native">
                <audio controls preload="metadata">
                  <source src={item.src} type={item.mime} />
                </audio>
                <p class="music-audio-row__detail">
                  {item.duration && <span>{item.duration}</span>}
                  <a href={item.href}>Open archive entry</a>
                </p>
              </div>
            ) : item.presentation === 'embed' && item.embedUrl ? (
              <div class="music-audio-row__player">
                <iframe
                  src={item.embedUrl}
                  title={`${item.title} embed`}
                  loading="lazy"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  allowFullScreen
                  frameborder="0"
                ></iframe>
                <p class="music-audio-row__detail">
                  <a href={item.href} {...(/^https?:\/\//i.test(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                    {item.linkLabel}
                  </a>
                  {item.secondaryHref && item.secondaryLabel ? (
                    <a href={item.secondaryHref} target="_blank" rel="noopener noreferrer">
                      {item.secondaryLabel}
                    </a>
                  ) : null}
                </p>
              </div>
            ) : (
              <div class="music-audio-row__player music-audio-row__player--handoff">
                <div class="music-audio-row__fallback">
                  <p>{item.handoffCopy ?? 'Playback continues on the archive entry or original source.'}</p>
                  <div class="music-audio-row__handoff-actions">
                    <a href={item.href} {...(/^https?:\/\//i.test(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {item.linkLabel}
                    </a>
                    {item.secondaryHref && item.secondaryLabel ? (
                      <a href={item.secondaryHref} target="_blank" rel="noopener noreferrer">
                        {item.secondaryLabel}
                      </a>
                    ) : null}
                  </div>
                </div>
              </div>
            )}
            <div class="music-audio-row__sequence">
              <span>Track {index + 1} of {audioBites.length}</span>
              <div>
                {index > 0 && <a href={`#listen-${index}`}>Previous</a>}
                {index < audioBites.length - 1 && <a href={`#listen-${index + 2}`}>Next</a>}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="music-section music-section--browse" id="browse" aria-labelledby="music-browse-heading">
      <div class="music-section__head">
        <p class="music-section__kicker">Browse</p>
        <h2 id="music-browse-heading">Photos that keep the ear open</h2>
      </div>

      <div class="music-photo-grid">
        {inspirationPhotos.map((photo, index) => (
          <figure class:list={['music-photo', index % 3 === 0 && 'music-photo--wide', index % 4 === 0 && 'music-photo--tall']}>
            <img src={photo.src} alt={photo.alt} loading="lazy" />
          </figure>
        ))}
      </div>
    </section>

    <CrossRouteResume current="music" className="music-resume" heading="Resume your other creative lanes" />

    <footer class="music-footer">
      <p class="music-footer__copy">
        Open sources and reference lanes:
      </p>
      <div class="music-footer__links">
        {referenceLinks.map((link) => (
          <a href={link.href} {...(/^https?:\/\//i.test(link.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
            {link.label}
          </a>
        ))}
      </div>
    </footer>
  </main>

  <script
    id="music-library-view-data"
    type="application/json"
    set:html={JSON.stringify(libraryViewData)}
  ></script>
  <script is:inline>
    (() => {
      const STORAGE_KEY = 'music-library-view-v1';
      const dataNode = document.getElementById('music-library-view-data');
      if (!(dataNode instanceof HTMLScriptElement)) return;

      let viewData = {};
      try {
        viewData = JSON.parse(dataNode.textContent || '{}');
      } catch {
        viewData = {};
      }

      const validViews = Object.keys(viewData);
      if (!validViews.length) return;

      const buttons = Array.from(document.querySelectorAll('[data-library-view]')).filter(
        (node) => node instanceof HTMLButtonElement
      );
      const shelves = Array.from(document.querySelectorAll('[data-library-shelf]')).filter(
        (node) => node instanceof HTMLElement
      );
      const stateNode = document.querySelector('[data-library-state]');
      const featuredTitle = document.querySelector('[data-library-featured-title]');
      const featuredSummary = document.querySelector('[data-library-featured-summary]');
      const featuredPrimary = document.querySelector('[data-library-featured-primary]');

      const isValidView = (value) => typeof value === 'string' && validViews.includes(value);

      const syncQuery = (view) => {
        const url = new URL(window.location.href);
        if (view === 'all') {
          url.searchParams.delete('library');
        } else {
          url.searchParams.set('library', view);
        }
        history.replaceState({ library: view }, '', url);
      };

      const persistView = (view) => {
        try {
          window.localStorage.setItem(STORAGE_KEY, view);
        } catch {
          // Ignore storage issues and keep UI functional.
        }
      };

      const setView = (view, options = {}) => {
        const { sync = true, persist = true } = options;
        const nextView = isValidView(view) ? view : 'all';
        const nextData = viewData[nextView] || viewData.all || null;

        buttons.forEach((button) => {
          const active = button.dataset.libraryView === nextView;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', String(active));
        });

        shelves.forEach((shelf) => {
          const shelfId = shelf.dataset.libraryShelf || '';
          shelf.hidden = nextView !== 'all' && shelfId !== nextView;
        });

        if (stateNode instanceof HTMLElement && nextData && typeof nextData.summary === 'string') {
          stateNode.textContent = nextData.summary;
        }

        const nextFeatured = nextData && typeof nextData === 'object' ? nextData.featured : null;
        if (featuredTitle instanceof HTMLElement && nextFeatured && typeof nextFeatured.title === 'string') {
          featuredTitle.textContent = nextFeatured.title;
        }
        if (featuredSummary instanceof HTMLElement && nextFeatured && typeof nextFeatured.summary === 'string') {
          featuredSummary.textContent = nextFeatured.summary;
        }
        if (featuredPrimary instanceof HTMLAnchorElement && nextFeatured && typeof nextFeatured.href === 'string') {
          featuredPrimary.href = nextFeatured.href;
          featuredPrimary.textContent =
            typeof nextFeatured.cta === 'string' && nextFeatured.cta.trim().length > 0
              ? nextFeatured.cta
              : 'Open featured entry';
        }

        if (sync) syncQuery(nextView);
        if (persist) persistView(nextView);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          setView(button.dataset.libraryView || 'all');
        });
      });

      const queryView = new URLSearchParams(window.location.search).get('library') || '';
      let initialView = isValidView(queryView) ? queryView : '';

      if (!initialView) {
        try {
          const saved = window.localStorage.getItem(STORAGE_KEY) || '';
          if (isValidView(saved)) initialView = saved;
        } catch {
          // ignore storage read issues
        }
      }

      setView(initialView || 'all', { sync: true, persist: false });
    })();
  </script>
</BaseLayout>

<style>
  :global(html body.music-page[data-theme='archive']) {
    --tone-text: rgba(236, 244, 238, 0.95);
    --tone-muted: rgba(176, 198, 184, 0.78);
    --tone-bg: #0b120f;
    --tone-bg-deep: #060a08;
    --tone-surface: rgba(15, 24, 19, 0.92);
    --tone-surface-strong: rgba(10, 18, 13, 0.96);
    --tone-line: rgba(120, 153, 132, 0.2);
    --line2: rgba(120, 153, 132, 0.14);
    --tone-accent: #1db954;
    --tone-accent-glow: #7ef6a6;
    background:
      radial-gradient(42rem 24rem at 50% 0%, rgba(29, 185, 84, 0.2), transparent 54%),
      radial-gradient(36rem 20rem at 84% 6%, rgba(75, 119, 89, 0.16), transparent 60%),
      linear-gradient(180deg, #101813 0%, #0b120f 48%, #060a08 100%);
  }

  :global(html body.music-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.03), transparent 28%),
      linear-gradient(to left, rgba(255, 255, 255, 0.02), transparent 40%),
      radial-gradient(1100px 700px at 18% 2%, rgba(29, 185, 84, 0.12), transparent 64%),
      radial-gradient(1100px 700px at 84% 4%, rgba(74, 119, 89, 0.1), transparent 66%);
  }

  .music-page__shell {
    display: grid;
    gap: clamp(1.2rem, 2.4vw, 1.9rem);
    color: var(--tone-text);
  }

  .music-hero,
  .music-section,
  .music-footer {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 14%, var(--line2));
    border-radius: 1.4rem;
    background:
      linear-gradient(180deg, rgba(20, 31, 24, 0.88), rgba(10, 17, 13, 0.94)),
      radial-gradient(120% 140% at 0% 0%, color-mix(in srgb, var(--tone-accent) 14%, transparent), transparent 56%);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.24),
      0 1px 0 rgba(255, 255, 255, 0.07) inset;
  }

  .music-hero {
    display: grid;
    gap: 0.55rem;
    max-width: 68ch;
    padding: clamp(1.25rem, 2.4vw, 1.8rem);
  }

  .music-hero__eyebrow,
  .music-section__kicker,
  .music-hero__nav,
  .music-footer__copy {
    margin: 0;
  }

  .music-hero__eyebrow,
  .music-section__kicker {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.09em;
    color: color-mix(in srgb, var(--tone-text) 76%, var(--tone-muted) 24%);
  }

  .music-hero h1,
  .music-section__head h2,
  .music-video h3,
  .music-audio-row h3 {
    margin: 0;
  }

  .music-hero h1 {
    font-size: clamp(2.4rem, 7vw, 4.4rem);
    line-height: 1.02;
    color: var(--tone-text);
  }

  .music-hero__lede {
    max-width: 52ch;
    margin: 0;
    line-height: 1.76;
    font-size: 1.01rem;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
  }

  .music-hero__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding-top: 0.15rem;
  }

  .music-hero__queue {
    margin: 0.35rem 0 0;
    padding: 0;
    list-style: none;
