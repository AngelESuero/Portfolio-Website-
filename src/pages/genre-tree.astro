---
import BaseLayout from '../layouts/BaseLayout.astro';
import AngelGenreHybridTree from '../components/AngelGenreHybridTree';
---

<BaseLayout
  title="Genre Tree - a_e.s_"
  description="Angel's game genre ancestor tree — a hybrid view of played and future games by genre."
  theme="archive"
>
  <main style="width: 100%; padding: 2rem 0;">
    <section style="margin-bottom: 3rem; text-align: center;">
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.1; margin: 0; color: var(--tone-text);">
        A Path Toward Genre Ancestry
      </h1>
    </section>
    <AngelGenreHybridTree client:load />
  </main>
</BaseLayout>
