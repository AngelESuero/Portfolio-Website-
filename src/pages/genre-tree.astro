---
import BaseLayout from '../layouts/BaseLayout.astro';
import AngelGenreHybridTree from '../components/AngelGenreHybridTree';
---

<BaseLayout
  title="Genre Tree - a_e.s_"
  description="Angel's game genre ancestor tree — a hybrid view of played and future games by genre."
  theme="archive"
>
  <main style="max-width: 1100px; margin: 0 auto; padding: clamp(2rem, 4vw, 3.5rem) clamp(1rem, 3vw, 1.75rem) clamp(3rem, 6vw, 5rem);">
    <AngelGenreHybridTree client:load />
  </main>
</BaseLayout>
