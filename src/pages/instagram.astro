---
import BaseLayout from '../layouts/BaseLayout.astro';
import igManifest from '../data/ig.json';

const items = Array.isArray(igManifest) ? igManifest : [];
const firstFileHref = items.find((item) => typeof item?.src === 'string' && item.src)?.src ?? '/instagram';
const firstInstagramHref = items.find((item) => typeof item?.ig_url === 'string' && item.ig_url.trim())?.ig_url?.trim() ?? '';
const archiveYears = [...new Set(items.map((item) => String(item?.year || '').trim()).filter(Boolean))].sort(
  (a, b) => Number(b) - Number(a)
);
const seriesOptions = [...new Set(items.map((item) => String(item?.series || '').trim()).filter(Boolean))];
const availableTypes = [...new Set(items.map((item) => String(item?.type || '').trim().toLowerCase()).filter(Boolean))];
const showTypeChips = availableTypes.length > 1;
const backdropFallbacks = ['/ig/2026/2026-01-10_archive-note.svg', '/ig/2025/2025-12-02_process-grid.svg'];
const backdropImages = items
  .slice(0, 2)
  .map((item) => (typeof item?.src === 'string' ? item.src : ''))
  .filter(Boolean);
const backdropOne = backdropImages[0] ?? backdropFallbacks[0];
const backdropTwo = backdropImages[1] ?? backdropFallbacks[1];

const humanizeLabel = (value: string) => {
  const raw = String(value || '').trim();
  if (!raw) return 'Untitled post';

  const stripped = raw.replace(/^(\d{4}-\d{2}-\d{2})[_-]?/, '').trim();
  const cleaned = stripped.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
  if (!cleaned) return 'Untitled post';

  return cleaned
    .split(' ')
    .map((part) => (part ? part.charAt(0).toUpperCase() + part.slice(1) : part))
    .join(' ');
};
---

<BaseLayout
  title="Instagram Archive — a_e.s_"
  description="Local-first Instagram archive sourced from exported files."
  theme="social"
>
  <section class="ig-page">
    <div class="ig-backdrop" aria-hidden="true">
      <img class="ig-backdrop__photo ig-backdrop__photo--one" src={backdropOne} alt="" loading="eager" decoding="async" />
      {backdropTwo && (
        <img class="ig-backdrop__photo ig-backdrop__photo--two" src={backdropTwo} alt="" loading="eager" decoding="async" />
      )}
      <span class="ig-backdrop__glow ig-backdrop__glow--one"></span>
      <span class="ig-backdrop__glow ig-backdrop__glow--two"></span>
    </div>

    <header class="ig-hero">
      <div class="ig-hero__copy">
        <p class="ig-kicker">Local archive</p>
        <h1>Instagram Archive</h1>
        <p class="ig-dek">Local-first archive of exported posts.</p>
      </div>
      <aside class="ig-hero__panel" aria-label="Archive summary">
        <div class="ig-hero__meta">
          <span>{items.length} {items.length === 1 ? 'post' : 'posts'}</span>
          <span>{archiveYears.length} {archiveYears.length === 1 ? 'year' : 'years'}</span>
          <span>{seriesOptions.length > 0 ? `${seriesOptions.length} series` : 'No series yet'}</span>
        </div>
      </aside>
    </header>

    <section class="ig-filters" aria-label="Instagram archive filters">
      <label class="ig-filter">
        <span>Year</span>
        <select id="ig-year">
          <option value="">All years</option>
        </select>
      </label>

      {seriesOptions.length > 0 && (
        <label class="ig-filter">
          <span>Series</span>
          <select id="ig-series">
            <option value="">All series</option>
          </select>
        </label>
      )}

      <label class="ig-filter ig-filter--wide">
        <span>Search</span>
        <input id="ig-tag-query" type="text" placeholder="Search titles or tags" />
      </label>
    </section>

    <div class="ig-controls">
      <p id="ig-status" class="ig-status">Loading archive…</p>
      {showTypeChips && <div class="ig-type-chips" id="ig-type-chips" aria-label="Type filters"></div>}
    </div>
    <div id="ig-grid" class="ig-grid" aria-live="polite"></div>
  </section>

  <div id="ig-modal" class="ig-modal" hidden>
    <button type="button" class="ig-modal-backdrop" data-close-modal aria-label="Close media details"></button>
    <div class="ig-modal-panel" role="dialog" aria-modal="true" aria-labelledby="ig-modal-title">
      <button type="button" class="ig-modal-close" data-close-modal aria-label="Close">×</button>
      <div id="ig-modal-media" class="ig-modal-media"></div>
      <h2 id="ig-modal-title" class="ig-modal-title"></h2>
      <p id="ig-modal-meta" class="ig-modal-meta"></p>
      <p id="ig-modal-caption" class="ig-modal-caption"></p>
      <div class="ig-modal-links">
        <a id="ig-modal-file-link" href={firstFileHref} target="_blank" rel="noopener">Open File</a>
        {firstInstagramHref && (
          <a id="ig-modal-ig-link" href={firstInstagramHref} target="_blank" rel="noopener">View on Instagram</a>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ items }}>
  (() => {
    const yearEl = document.getElementById('ig-year');
    const seriesEl = document.getElementById('ig-series');
    const tagQueryEl = document.getElementById('ig-tag-query');
    const typeChipsEl = document.getElementById('ig-type-chips');
    const statusEl = document.getElementById('ig-status');
    const gridEl = document.getElementById('ig-grid');
    const modalEl = document.getElementById('ig-modal');
    const modalMediaEl = document.getElementById('ig-modal-media');
    const modalTitleEl = document.getElementById('ig-modal-title');
    const modalMetaEl = document.getElementById('ig-modal-meta');
    const modalCaptionEl = document.getElementById('ig-modal-caption');
    const modalFileLinkEl = document.getElementById('ig-modal-file-link');
    const modalIgLinkEl = document.getElementById('ig-modal-ig-link');
    if (
      !yearEl ||
      !tagQueryEl ||
      !statusEl ||
      !gridEl ||
      !modalEl ||
      !modalMediaEl ||
      !modalTitleEl ||
      !modalMetaEl ||
      !modalCaptionEl ||
      !modalFileLinkEl
    ) {
      return;
    }

    const normalizeType = (value) => String(value || '').toLowerCase();
    const humanizeLabel = (value) => {
      const raw = String(value || '').trim();
      if (!raw) return 'Untitled post';

      const stripped = raw.replace(/^(\d{4}-\d{2}-\d{2})[_-]?/, '').trim();
      const cleaned = stripped.replace(/[_-]+/g, ' ').replace(/\s+/g, ' ').trim();
      if (!cleaned) return 'Untitled post';

      return cleaned
        .split(' ')
        .map((part) => (part ? part.charAt(0).toUpperCase() + part.slice(1) : part))
        .join(' ');
    };

    const parseArchiveDate = (value) => {
      const raw = String(value || '').trim();
      const match = raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
      if (match) {
        const [, year, month, day] = match;
        return new Date(Date.UTC(Number(year), Number(month) - 1, Number(day)));
      }

      const parsed = new Date(raw);
      return Number.isNaN(parsed.valueOf()) ? null : parsed;
    };

    const formatDate = (value) => {
      const parsed = parseArchiveDate(value);
      if (!parsed) return String(value || '');
      return new Intl.DateTimeFormat('en-US', {
        month: 'short',
        day: 'numeric',
        year: 'numeric',
        timeZone: 'UTC'
      }).format(parsed);
    };

    const normalizeItem = (item) => {
      const date = String(item?.date || '');
      const year = Number(item?.year || (date ? date.slice(0, 4) : 0));
      const id = String(item?.id || `${date}_${String(item?.src || '')}`);
      const type = normalizeType(item?.type) || 'photo';
      const series = String(item?.series || '').trim();
      const tags = Array.isArray(item?.tags) ? item.tags.map((tag) => String(tag).toLowerCase()).filter(Boolean) : [];
      const src = String(item?.src || '');
      const caption = String(item?.caption || '').trim();
      const igUrl = String(item?.ig_url || '').trim();
      return { id, date, year, type, series, tags, src, caption, ig_url: igUrl };
    };

    const state = {
      items: (Array.isArray(items) ? items : [])
        .map(normalizeItem)
        .filter((item) => item.id && item.src && item.date)
        .sort((a, b) => String(b.date).localeCompare(String(a.date))),
      activeType: 'all'
    };

    const itemById = new Map(state.items.map((item) => [item.id, item]));
    const availableTypes = [...new Set(state.items.map((item) => item.type).filter(Boolean))].sort();

    const makeMedia = (item, className) => {
      if (item.type === 'video' || item.type === 'reel') {
        const video = document.createElement('video');
        video.src = item.src;
        video.className = className;
        video.muted = true;
        video.playsInline = true;
        video.preload = 'metadata';
        video.controls = true;
        return video;
      }

      const image = document.createElement('img');
      image.src = item.src;
      image.alt = item.caption || humanizeLabel(item.id);
      image.className = className;
      image.loading = 'lazy';
      image.decoding = 'async';
      return image;
    };

    const closeModal = () => {
      modalEl.hidden = true;
      document.body.style.removeProperty('overflow');
      modalMediaEl.innerHTML = '';
    };

    const openModal = (item) => {
      modalMediaEl.innerHTML = '';
      modalMediaEl.appendChild(makeMedia(item, 'ig-modal-media-inner'));
      modalTitleEl.textContent = item.caption || humanizeLabel(item.id);
      modalMetaEl.textContent = `${formatDate(item.date)} • ${humanizeLabel(item.type)}${item.series ? ` • ${item.series}` : ''}`;
      if (item.caption) {
        modalCaptionEl.hidden = false;
        modalCaptionEl.textContent = item.caption;
      } else {
        modalCaptionEl.hidden = true;
        modalCaptionEl.textContent = '';
      }
      modalFileLinkEl.href = item.src;
      modalFileLinkEl.textContent = 'Open File';

      if (modalIgLinkEl instanceof HTMLAnchorElement) {
        if (item.ig_url) {
          modalIgLinkEl.href = item.ig_url;
          modalIgLinkEl.hidden = false;
        } else {
          modalIgLinkEl.hidden = true;
        }
      }

      modalEl.hidden = false;
      document.body.style.overflow = 'hidden';
    };

    const renderTypeChips = () => {
      if (!(typeChipsEl instanceof HTMLElement) || availableTypes.length <= 1) return;
      typeChipsEl.innerHTML = '';
      ['all', ...availableTypes].forEach((type) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `ig-chip${state.activeType === type ? ' is-active' : ''}`;
        btn.dataset.type = type;
        btn.setAttribute('aria-pressed', String(state.activeType === type));
        btn.textContent = type === 'all' ? 'All types' : humanizeLabel(type);
        typeChipsEl.appendChild(btn);
      });
    };

    const updateFilterOptions = () => {
      const years = [...new Set(state.items.map((item) => item.year).filter(Boolean))].sort((a, b) => b - a);
      const seriesValues = [...new Set(state.items.map((item) => item.series).filter(Boolean))].sort();
      const prevYear = yearEl.value;

      yearEl.innerHTML = '<option value="">All years</option>';

      years.forEach((year) => {
        const option = document.createElement('option');
        option.value = String(year);
        option.textContent = String(year);
        yearEl.appendChild(option);
      });

      if (seriesEl instanceof HTMLSelectElement) {
        const prevSeries = seriesEl.value;
        seriesEl.innerHTML = '<option value="">All series</option>';

        seriesValues.forEach((series) => {
          const option = document.createElement('option');
          option.value = series;
          option.textContent = series;
          seriesEl.appendChild(option);
        });

        if ([...seriesEl.options].some((opt) => opt.value === prevSeries)) seriesEl.value = prevSeries;
      }

      if ([...yearEl.options].some((opt) => opt.value === prevYear)) yearEl.value = prevYear;
    };

    const filteredItems = () => {
      const year = yearEl instanceof HTMLSelectElement ? yearEl.value : '';
      const series = seriesEl instanceof HTMLSelectElement ? seriesEl.value : '';
      const query = tagQueryEl instanceof HTMLInputElement ? tagQueryEl.value.trim().toLowerCase() : '';

      return state.items.filter((item) => {
        if (year && String(item.year) !== year) return false;
        if (state.activeType !== 'all' && item.type !== state.activeType) return false;
        if (series && item.series !== series) return false;
        if (!query) return true;
        const haystack = `${item.caption} ${item.series} ${item.tags.join(' ')}`.toLowerCase();
        return haystack.includes(query);
      });
    };

    const renderGrid = () => {
      gridEl.innerHTML = '';
      const itemsToRender = filteredItems();
      statusEl.textContent = itemsToRender.length
        ? `Showing ${itemsToRender.length} post${itemsToRender.length === 1 ? '' : 's'}`
        : 'No posts match these filters.';

      itemsToRender.forEach((item) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'ig-card';
        button.dataset.id = item.id;
        button.appendChild(makeMedia(item, 'ig-thumb'));

        const body = document.createElement('div');
        body.className = 'ig-card-body';

        const meta = document.createElement('p');
        meta.className = 'ig-card-meta';
        meta.textContent = item.series ? `${formatDate(item.date)} • ${item.series}` : formatDate(item.date);

        const title = document.createElement('p');
        title.className = 'ig-card-title';
        title.textContent = item.caption || humanizeLabel(item.id);

        body.appendChild(meta);
        body.appendChild(title);
        button.appendChild(body);
        gridEl.appendChild(button);
      });
    };

    if (typeChipsEl instanceof HTMLElement && availableTypes.length > 1) {
      typeChipsEl.addEventListener('click', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLElement)) return;
        const chip = target.closest('.ig-chip');
        if (!(chip instanceof HTMLButtonElement)) return;
        state.activeType = chip.dataset.type || 'all';
        renderTypeChips();
        renderGrid();
      });
    }

    if (yearEl instanceof HTMLSelectElement) yearEl.addEventListener('change', renderGrid);
    if (seriesEl instanceof HTMLSelectElement) seriesEl.addEventListener('change', renderGrid);
    if (tagQueryEl instanceof HTMLInputElement) tagQueryEl.addEventListener('input', renderGrid);

    gridEl.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      const card = target.closest('.ig-card');
      if (!(card instanceof HTMLButtonElement)) return;
      const id = card.dataset.id || '';
      const item = itemById.get(id);
      if (item) openModal(item);
    });

    modalEl.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement)) return;
      if (target.hasAttribute('data-close-modal')) closeModal();
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modalEl.hidden) closeModal();
    });

    updateFilterOptions();
    renderTypeChips();
    renderGrid();
  })();
</script>

<style>
  .ig-page {
    max-width: 72rem;
    margin: 0 auto;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(111, 86, 58, 0.16);
    border-radius: 1.35rem;
    padding: clamp(1rem, 1.8vw, 1.5rem);
    background:
      radial-gradient(circle at 15% 0%, rgba(255, 255, 255, 0.9), transparent 32%),
      radial-gradient(circle at 85% 8%, rgba(181, 122, 45, 0.12), transparent 24%),
      linear-gradient(180deg, rgba(252, 248, 242, 0.98), rgba(245, 238, 228, 0.99));
    box-shadow: 0 24px 70px rgba(47, 28, 11, 0.08);
  }

  .ig-page::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 30% 0%, rgba(255, 255, 255, 0.75), transparent 32%),
      radial-gradient(circle at 82% 12%, rgba(181, 122, 45, 0.1), transparent 18%);
  }

  .ig-page::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(rgba(104, 84, 65, 0.06) 0.6px, transparent 0.6px);
    background-size: 18px 18px;
    opacity: 0.35;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.65), transparent 88%);
  }

  .ig-backdrop {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .ig-backdrop__photo {
    position: absolute;
    width: min(27rem, 44vw);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.15rem;
    opacity: 0.13;
    filter: saturate(0.78) contrast(0.96) brightness(1.05);
    box-shadow: 0 20px 60px rgba(42, 26, 10, 0.16);
    mix-blend-mode: multiply;
  }

  .ig-backdrop__photo--one {
    top: -2rem;
    right: -5rem;
    transform: rotate(8deg);
  }

  .ig-backdrop__photo--two {
    left: -4rem;
    bottom: 2rem;
    width: min(22rem, 36vw);
    transform: rotate(-7deg);
  }

  .ig-backdrop__glow {
    position: absolute;
    border-radius: 999px;
    filter: blur(26px);
    opacity: 0.55;
  }

  .ig-backdrop__glow--one {
    width: 18rem;
    height: 18rem;
    top: 2rem;
    right: 1rem;
    background: rgba(181, 122, 45, 0.12);
  }

  .ig-backdrop__glow--two {
    width: 16rem;
    height: 16rem;
    left: 0;
    bottom: 0;
    background: rgba(88, 122, 149, 0.1);
  }

  .ig-page > :not(.ig-backdrop) {
    position: relative;
    z-index: 1;
  }

  .ig-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.85fr);
    gap: 1rem;
    align-items: end;
  }

  .ig-hero__copy {
    max-width: 42rem;
  }

  .ig-kicker {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.71rem;
    color: rgba(99, 77, 56, 0.72);
  }

  .ig-hero h1 {
    margin: 0.38rem 0 0.76rem;
    font-size: clamp(2.05rem, 4.3vw, 3.2rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: #1f1711;
  }

  .ig-dek {
    margin: 0;
    max-width: 60ch;
    color: #5f4c3a;
    line-height: 1.62;
  }

  .ig-hero__panel {
    padding: 0.9rem;
    border: 1px solid rgba(111, 86, 58, 0.14);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.62);
    backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.85);
  }

  .ig-hero__meta {
    display: grid;
    gap: 0.5rem;
  }

  .ig-hero__meta span {
    display: inline-flex;
    align-items: center;
    min-height: 2.05rem;
    padding: 0.42rem 0.68rem;
    border-radius: 999px;
    border: 1px solid rgba(111, 86, 58, 0.14);
    background: rgba(255, 255, 255, 0.8);
    color: #654f3d;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ig-filters {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.72rem;
    padding: 0.92rem;
    border: 1px solid rgba(111, 86, 58, 0.12);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.56);
    backdrop-filter: blur(12px);
  }

  .ig-filter {
    display: grid;
    gap: 0.32rem;
  }

  .ig-filter--wide {
    grid-column: 1 / -1;
  }

  .ig-filter span {
    font-size: 0.71rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #6d5743;
  }

  .ig-filter select,
  .ig-filter input {
    width: 100%;
    border: 1px solid rgba(111, 86, 58, 0.16);
    border-radius: 0.72rem;
    background: rgba(255, 255, 255, 0.84);
    color: #1f1711;
    padding: 0.56rem 0.68rem;
    font: inherit;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
  }

  .ig-filter select:focus-visible,
  .ig-filter input:focus-visible,
  .ig-chip:focus-visible,
  .ig-card:focus-visible,
  .ig-modal-close:focus-visible,
  .ig-modal-links a:focus-visible {
    outline: 2px solid rgba(181, 122, 45, 0.72);
    outline-offset: 2px;
  }

  .ig-controls {
    margin-top: 0.95rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    flex-wrap: wrap;
  }

  .ig-status {
    margin: 0;
    color: #6c5847;
    font-size: 0.84rem;
  }

  .ig-type-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .ig-chip {
    border: 1px solid rgba(111, 86, 58, 0.16);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.72);
    color: #5f4c39;
    padding: 0.38rem 0.78rem;
    font-size: 0.78rem;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.75);
  }

  .ig-chip.is-active {
    border-color: rgba(181, 122, 45, 0.32);
    color: #8a5a23;
    background: rgba(181, 122, 45, 0.12);
  }

  .ig-grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17.5rem, 24rem));
    justify-content: center;
    align-items: start;
    gap: 1rem;
  }

  .ig-card {
    border: 1px solid rgba(111, 86, 58, 0.14);
    border-radius: 1.05rem;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(249, 243, 235, 0.98));
    padding: 0;
    text-align: left;
    overflow: hidden;
    cursor: pointer;
    box-shadow: 0 18px 50px rgba(44, 27, 10, 0.08);
    transition:
      transform 180ms var(--ease-standard),
      box-shadow 180ms var(--ease-standard),
      border-color 180ms var(--ease-standard);
  }

  .ig-card:hover {
    transform: translateY(-3px);
    border-color: rgba(181, 122, 45, 0.24);
    box-shadow: 0 24px 60px rgba(44, 27, 10, 0.12);
  }

  .ig-thumb {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #e9dfd1;
  }

  .ig-card-body {
    display: grid;
    gap: 0.24rem;
    padding: 0.76rem 0.82rem 0.88rem;
  }

  .ig-card-meta {
    margin: 0;
    font-size: 0.7rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: #8a6f57;
  }

  .ig-card-title {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.38;
    color: #1f1711;
  }

  .ig-modal[hidden] {
    display: none;
  }

  .ig-modal {
    position: fixed;
    inset: 0;
    z-index: 80;
    display: grid;
    place-items: center;
    padding: 1rem;
  }

  .ig-modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(21, 16, 11, 0.58);
    border: 0;
    padding: 0;
  }

  .ig-modal-panel {
    position: relative;
    width: min(64rem, calc(100vw - 2rem));
    max-height: calc(100vh - 2rem);
    overflow: auto;
