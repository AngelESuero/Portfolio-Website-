---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoiceExcerpt from '../../components/VoiceExcerpt.astro';
import { formatLongUtcDate } from '../../lib/date-formatting';
import { isPostReady } from '../../lib/post-readiness';
import { getAllPosts } from '../../lib/site-collections';
import { getContentVoiceExcerpt } from '../../lib/content-excerpts';
import '../../styles/pages/writing/[slug].css';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const allPosts = (await getAllPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const currentIndex = allPosts.findIndex((entry) => entry.slug === post.slug);
const newerPost = currentIndex > 0 ? allPosts[currentIndex - 1] : null;
const olderPost = currentIndex >= 0 && currentIndex < allPosts.length - 1 ? allPosts[currentIndex + 1] : null;
const currentTags = new Set(post.data.tags.map((tag) => tag.trim().toLowerCase()).filter(Boolean));
const relatedPosts = allPosts
  .filter((entry) => entry.slug !== post.slug)
  .map((entry) => {
    const sharedTags = entry.data.tags.filter((tag) => currentTags.has(tag.trim().toLowerCase())).length;
    return { entry, sharedTags };
  })
  .filter((candidate) => candidate.sharedTags > 0)
  .sort((left, right) => right.sharedTags - left.sharedTags || right.entry.data.date.valueOf() - left.entry.data.date.valueOf())
  .slice(0, 3)
  .map((candidate) => candidate.entry);
const postReady = isPostReady(post);
const voiceExcerpt = postReady ? getContentVoiceExcerpt(post, 220) : '';
const wordCount = post.body ? post.body.trim().split(/\s+/).length : 0;
const readingTime = Math.max(1, Math.round(wordCount / 200));
---
<BaseLayout title={`${post.data.title} — Writing`} theme="writing">
  <article class="writing-entry">
    <a href="/writing" class="writing-entry-back">← Back to Writing</a>
    <header class="writing-entry-header">
      <p class="writing-entry-date">{formatLongUtcDate(post.data.date)}</p>
      <h1 class="font-display text-4xl md:text-5xl">{post.data.title}</h1>
      {postReady ? <VoiceExcerpt text={voiceExcerpt} label="From the piece" variant="feature" /> : <p class="writing-entry-summary">{post.data.summary}</p>}
      <div class="writing-entry-meta">
        {postReady && <p>{readingTime} min read</p>}
        <div class="writing-entry-tags" aria-label="Post tags">
          {post.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      </div>
    </header>

    <section class:list={['reading-prose', 'mt-8', { 'reading-prose--withheld': !postReady }]}>
      {postReady ? <Content /> : <p class="writing-entry-unfilled">unfilled</p>}
    </section>

    <footer class="writing-entry-footer">
      <a href="/rss.xml" class="writing-entry-rss">Follow via RSS</a>
      {relatedPosts.length > 0 && (
        <section class="writing-entry-related" aria-label="Related pieces">
          <p>Continue this thread</p>
          <ul>
            {relatedPosts.map((related) => (
              <li><a href={`/writing/${related.slug}`}>{related.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      <nav class="writing-entry-nav" aria-label="Adjacent posts">
        {newerPost && (
          <a href={`/writing/${newerPost.slug}`} class="writing-entry-nav-link">
            Newer: {newerPost.data.title}
          </a>
        )}
        {olderPost && (
          <a href={`/writing/${olderPost.slug}`} class="writing-entry-nav-link">
            Older: {olderPost.data.title}
          </a>
        )}
      </nav>
    </footer>
  </article>
</BaseLayout>

