---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import WritingWorkbench from '../../../app/components/WritingWorkbench';
import { formatLongUtcDate, formatShortUtcDate } from '../../lib/date-formatting';
import { isPostReady } from '../../lib/post-readiness';
import { getEntryHref, sortEntriesByDate } from '../../lib/archive-entries';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const readyPosts = posts.filter(isPostReady);
const archiveWritingEntries = sortEntriesByDate(
  (await getCollection('entries')).filter((entry) => (
    entry.data.medium === 'writing' &&
    !entry.slug.startsWith('writing/_') &&
    entry.slug !== 'writing/test'
  ))
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.trim().toLowerCase())))]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b));

const latestPublished = readyPosts.slice(0, 6).map((post) => ({
  title: post.data.title,
  href: `/writing/${post.slug}`,
  date: formatShortUtcDate(post.data.date),
  summary: post.data.summary,
  tags: post.data.tags
}));

const politicalTagSet = new Set(['political', 'political-economy', 'governance', 'civic', 'capitalism']);
const hasPoliticalTag = (tags: string[]) => tags.some((tag) => politicalTagSet.has(tag.trim().toLowerCase()));
const politicalPosts = readyPosts.filter((post) => hasPoliticalTag(post.data.tags));

const getGoogleDocPreviewUrl = (value: string): string | null => {
  try {
    const parsed = new URL(value);
    const docMatch = parsed.pathname.match(/^\/document\/d\/([^/]+)/);
    if (parsed.hostname.includes('docs.google.com') && docMatch?.[1]) {
      return `https://docs.google.com/document/d/${docMatch[1]}/preview`;
    }

    const driveMatch = parsed.pathname.match(/^\/file\/d\/([^/]+)/);
    if (parsed.hostname.includes('drive.google.com') && driveMatch?.[1]) {
      return `https://drive.google.com/file/d/${driveMatch[1]}/preview`;
    }
  } catch {
    return null;
  }

  return null;
};

const getArchiveDocumentSupport = (entry: (typeof archiveWritingEntries)[number]) => {
  if (entry.slug === 'writing/my-astrology-chart') {
    return {
      sourceHref: '/documents/archive/my-astrology-chart.pdf',
      sourceLabel: 'Open PDF',
      previewUrl: '/documents/archive/my-astrology-chart.pdf',
      previewLabel: 'Inline PDF preview'
    };
  }

  const externalUrl = typeof entry.data.external_url === 'string' ? entry.data.external_url.trim() : '';
  if (!externalUrl) return null;

  const previewUrl = getGoogleDocPreviewUrl(externalUrl);
  return {
    sourceHref: externalUrl,
    sourceLabel: previewUrl ? 'Open source doc' : 'Open source link',
    previewUrl,
    previewLabel: previewUrl ? 'Inline source preview' : ''
  };
};

const archiveDocuments = archiveWritingEntries.map((entry) => ({
  entry,
  href: getEntryHref(entry),
  support: getArchiveDocumentSupport(entry)
}));

const politicalArchiveDocuments = archiveDocuments.filter(({ entry }) => hasPoliticalTag(entry.data.tags));
const archiveDocumentsWithoutPolitical = archiveDocuments.filter(({ entry }) => !hasPoliticalTag(entry.data.tags));

type PoliticalRecord = {
  title: string;
  date: Date;
  summary: string;
  tags: string[];
  siteHref?: string;
  archiveHref?: string;
  sourceHref?: string;
  sourceLabel?: string;
  previewUrl?: string | null;
  previewLabel?: string;
  sourceType: string;
};

const politicalRecordMap = new Map<string, PoliticalRecord>();

for (const post of politicalPosts) {
  const key = post.data.title.trim().toLowerCase();
  politicalRecordMap.set(key, {
    title: post.data.title,
    date: post.data.date,
    summary: post.data.summary,
    tags: post.data.tags,
    siteHref: `/writing/${post.slug}`,
    sourceType: 'On-site essay'
  });
}

for (const { entry, href, support } of politicalArchiveDocuments) {
  const key = entry.data.title.trim().toLowerCase();
  const existing = politicalRecordMap.get(key);

  if (existing) {
    existing.archiveHref = href;
    existing.sourceHref = support?.sourceHref;
    existing.sourceLabel = support?.sourceLabel;
    existing.previewUrl = support?.previewUrl;
    existing.previewLabel = support?.previewLabel;
    if (entry.data.date.valueOf() > existing.date.valueOf()) {
      existing.date = entry.data.date;
      existing.summary = entry.data.summary;
    }
    continue;
  }

  politicalRecordMap.set(key, {
    title: entry.data.title,
    date: entry.data.date,
    summary: entry.data.summary,
    tags: entry.data.tags,
    archiveHref: href,
    sourceHref: support?.sourceHref,
    sourceLabel: support?.sourceLabel,
    previewUrl: support?.previewUrl,
    previewLabel: support?.previewLabel,
    sourceType: entry.data.status
  });
}

const politicalRecords = [...politicalRecordMap.values()].sort((a, b) => b.date.valueOf() - a.date.valueOf());

const driveFileViewUrl = (fileId: string): string => `https://drive.google.com/file/d/${fileId}/view?usp=sharing`;
const driveFilePreviewUrl = (fileId: string): string => `https://drive.google.com/file/d/${fileId}/preview`;

type DriveEssaySource = {
  title: string;
  summary: string;
  context: string;
  sourceType: string;
  tags: string[];
  sourceLinks: Array<{ label: string; href: string }>;
