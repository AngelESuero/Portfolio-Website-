---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoiceExcerpt from '../../components/VoiceExcerpt.astro';
import WritingWorkbench from '../../../app/components/WritingWorkbench';
import { formatLongUtcDate, formatShortUtcDate } from '../../lib/date-formatting';
import { isPostReady } from '../../lib/post-readiness';
import { getEntryHref, sortEntriesByDate } from '../../lib/archive-entries';
import { getContentVoiceExcerpt } from '../../lib/content-excerpts';
import { getAllEntries, getAllPosts } from '../../lib/site-collections';

const posts = (await getAllPosts()).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const readyPosts = posts.filter(isPostReady);
const archiveWritingEntries = sortEntriesByDate(
  (await getAllEntries()).filter((entry) => (
    entry.data.medium === 'writing' &&
    !entry.slug.startsWith('writing/_') &&
    entry.slug !== 'writing/test'
  ))
);
const allTags = [...new Set(posts.flatMap((post) => post.data.tags.map((tag) => tag.trim().toLowerCase())))]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b));

const latestPublished = readyPosts.slice(0, 6).map((post) => ({
  title: post.data.title,
  href: `/writing/${post.slug}`,
  date: formatShortUtcDate(post.data.date),
  summary: post.data.summary,
  voice: getContentVoiceExcerpt(post, 160),
  tags: post.data.tags
}));

const getGoogleDocPreviewUrl = (value: string): string | null => {
  try {
    const parsed = new URL(value);
    const docMatch = parsed.pathname.match(/^\/document\/d\/([^/]+)/);
    if (parsed.hostname.includes('docs.google.com') && docMatch?.[1]) {
      return `https://docs.google.com/document/d/${docMatch[1]}/preview`;
    }

    const driveMatch = parsed.pathname.match(/^\/file\/d\/([^/]+)/);
    if (parsed.hostname.includes('drive.google.com') && driveMatch?.[1]) {
      return `https://drive.google.com/file/d/${driveMatch[1]}/preview`;
    }
  } catch {
    return null;
  }

  return null;
};

const getArchiveDocumentSupport = (entry: (typeof archiveWritingEntries)[number]) => {
  if (entry.slug === 'writing/my-astrology-chart') {
    return {
      sourceHref: '/documents/archive/my-astrology-chart.pdf',
      sourceLabel: 'Open PDF',
      previewUrl: '/documents/archive/my-astrology-chart.pdf',
      previewLabel: 'Inline PDF preview'
    };
  }

  const externalUrl = typeof entry.data.external_url === 'string' ? entry.data.external_url.trim() : '';
  if (!externalUrl) return null;

  const previewUrl = getGoogleDocPreviewUrl(externalUrl);
  return {
    sourceHref: externalUrl,
    sourceLabel: previewUrl ? 'Open source doc' : 'Open source link',
    previewUrl,
    previewLabel: previewUrl ? 'Inline source preview' : ''
  };
};

const archiveDocuments = archiveWritingEntries.map((entry) => ({
  entry,
  href: getEntryHref(entry),
  support: getArchiveDocumentSupport(entry)
}));
---

<BaseLayout title="Writing — a_e.s_" theme="writing" bodyClass="writing-workbench-page">
  <section class="writing-page-header">
    <div class="writing-page-header__copy">
      <p class="writing-page-header__kicker">Writing desk</p>
      <h1 class="font-display text-4xl md:text-5xl">Writing</h1>
      <p class="writing-page-header__dek">
        This page is now built like a working surface first. Draft in the desk, save each note straight to your computer,
        and keep the published archive below.
      </p>
      <p class="writing-page-header__cue">Substack cue: readable measure, editorial rhythm, longform first.</p>
    </div>

    <div class="writing-page-header__meta">
      <p>{posts.length} total entries</p>
      <p>{readyPosts.length} published pieces</p>
      <p>{archiveDocuments.length} archive documents</p>
      {posts[0] && <p>Latest public date: {formatLongUtcDate(posts[0].data.date)}</p>}
      <a href="/rss.xml">RSS feed</a>
    </div>
  </section>

  <section class="writing-desk-shell">
    <WritingWorkbench client:only="react" published={latestPublished} totalPublished={readyPosts.length} />
  </section>

  <section class="writing-documents" aria-labelledby="writing-documents-heading">
    <div class="writing-documents__header">
      <div>
        <p class="writing-documents__kicker">Archive documents</p>
        <h2 id="writing-documents-heading" class="font-display text-2xl">The longer record behind the posts</h2>
        <p class="writing-documents__dek">
          These are the writing entries that live in the archive itself: papers, recovered fragments, reference
          documents, and records that do not all fit the post format.
        </p>
      </div>
      <a href="/archive/writing" class="writing-documents__browse">Open full writing archive</a>
    </div>

    {archiveDocuments.length === 0 ? (
      <p class="writing-empty">No archive documents are filed yet.</p>
    ) : (
      <div class="writing-documents__grid">
        {archiveDocuments.map(({ entry, href, support }) => (
          <article class="writing-document-card">
            <div class="writing-document-card__meta">
              <p>{formatShortUtcDate(entry.data.date)}</p>
              <span>{entry.data.status}</span>
            </div>

            <h3 class="font-display text-2xl">
              <a href={href}>{entry.data.title}</a>
            </h3>

            <VoiceExcerpt text={getContentVoiceExcerpt(entry, 170)} label="From the archive" variant="compact" />

            {entry.data.tags.length > 0 && (
              <div class="writing-tags">
                {entry.data.tags.map((tag) => <span class="writing-tag">#{tag}</span>)}
              </div>
            )}

            <div class="writing-document-card__actions">
              <a href={href} class="writing-document-card__link">Open archive record</a>
              {support && (
                <a
                  href={support.sourceHref}
                  class="writing-document-card__link writing-document-card__link--secondary"
                  target="_blank"
                  rel="noopener"
                >
                  {support.sourceLabel}
                </a>
              )}
            </div>

            {support?.previewUrl ? (
              <details class="writing-document-card__preview">
                <summary>{support.previewLabel}</summary>
                <div class="writing-document-card__frame">
                  <iframe
                    src={support.previewUrl}
                    title={`${entry.data.title} preview`}
                    loading="lazy"
                    allow="autoplay"
                  ></iframe>
                </div>
              </details>
            ) : support ? (
              <p class="writing-document-card__note">This document is linked on-site, but its source does not expose a reliable inline preview.</p>
            ) : (
              <p class="writing-document-card__note">This record is preserved in the archive even though the source artifact is not fully attached yet.</p>
            )}
          </article>
        ))}
      </div>
    )}
  </section>

  <section class="writing-archive" id="writing-list" aria-labelledby="writing-archive-heading">
    <div class="writing-archive__header">
      <div>
        <p class="writing-archive__kicker">Public archive</p>
        <h2 id="writing-archive-heading" class="font-display text-2xl">Published and in-progress entries</h2>
        <p class="writing-archive__dek">
          The desk above is for making notes. The list below is still the site record.
        </p>
      </div>

      <div class="writing-archive__controls">
        {allTags.length > 0 && (
          <div class="writing-filters" role="group" aria-label="Filter posts by tag">
            <button type="button" class="writing-filter is-active" data-filter="all" aria-pressed="true">All</button>
            {allTags.map((tag) => (
              <button type="button" class="writing-filter" data-filter={tag} aria-pressed="false">#{tag}</button>
            ))}
          </div>
        )}
        <p class="writing-results" id="writing-results-count">{posts.length} {posts.length === 1 ? 'entry' : 'entries'}</p>
      </div>
    </div>

    {posts.length === 0 ? (
      <p class="writing-empty">No entries published yet.</p>
    ) : (
      <>
        <ul class="writing-list" id="writing-list-items">
          {posts.map((post) => {
            const postReady = isPostReady(post);
            return (
              <li class="writing-item" data-tags={post.data.tags.map((tag) => tag.trim().toLowerCase()).join(' ')}>
                <article class="writing-entry-row">
                  <div class="writing-entry-row__meta">
                    <p>{formatShortUtcDate(post.data.date)}</p>
                    <span class:list={['writing-entry-row__state', { 'is-ready': postReady }]}>
                      {postReady ? 'Published' : 'In progress'}
                    </span>
                  </div>

                  <div class="writing-entry-row__body">
                    <h3 class="font-display text-2xl">
                      <a href={`/writing/${post.slug}`}>{post.data.title}</a>
                    </h3>
                    {postReady ? (
                      <VoiceExcerpt text={getContentVoiceExcerpt(post, 170)} label="From the piece" variant="compact" />
                    ) : (
                      <p>This entry is still being shaped.</p>
                    )}
                    <div class="writing-entry-row__footer">
                      <div class="writing-tags">
                        {post.data.tags.map((tag) => <span class="writing-tag">#{tag}</span>)}
                      </div>
                      {postReady && (
                        <a href={`/writing/${post.slug}`} class="writing-read-link" aria-label={`Read ${post.data.title}`}>
                          Read entry
                        </a>
                      )}
                    </div>
                  </div>
                </article>
              </li>
            );
          })}
        </ul>
        <p class="writing-empty" id="writing-empty-state" hidden>No posts match this tag yet.</p>
      </>
    )}
  </section>

  <script is:inline>
    (() => {
      const filterButtons = Array.from(document.querySelectorAll('.writing-filter'));
      const items = Array.from(document.querySelectorAll('.writing-item'));
      const emptyState = document.getElementById('writing-empty-state');
      const results = document.getElementById('writing-results-count');
      if (!filterButtons.length || !items.length || !results) return;

      const label = (count) => `${count} ${count === 1 ? 'entry' : 'entries'}`;

      const setActive = (activeFilter) => {
        filterButtons.forEach((candidate) => {
          const active = (candidate.getAttribute('data-filter') || 'all') === activeFilter;
          candidate.classList.toggle('is-active', active);
          candidate.setAttribute('aria-pressed', String(active));
        });
      };

      const applyFilter = (filter) => {
        let visibleCount = 0;
        items.forEach((item) => {
          const tags = item.getAttribute('data-tags') || '';
          const matches = filter === 'all' || tags.split(/\s+/).includes(filter);
          item.hidden = !matches;
          if (matches) visibleCount += 1;
        });

        results.textContent = label(visibleCount);
        if (emptyState) emptyState.hidden = visibleCount !== 0;
      };

      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-filter') || 'all';
          setActive(filter);
          applyFilter(filter);
        });
      });

      setActive('all');
      applyFilter('all');
    })();
  </script>
</BaseLayout>

<style>
  :global(body.writing-workbench-page[data-theme='writing']) {
    --tone-bg: #f5f2ea;
    --tone-bg-deep: #ece7dc;
    --tone-surface: rgba(255, 253, 248, 0.96);
    --tone-surface-strong: rgba(255, 255, 252, 0.99);
    --tone-text: rgba(28, 25, 22, 0.98);
    --tone-muted: rgba(77, 68, 59, 0.86);
    --tone-line: rgba(122, 101, 77, 0.2);
    --line2: rgba(122, 101, 77, 0.16);
    --tone-accent: #ff6719;
    --tone-accent-glow: #cb4f13;
    background:
      radial-gradient(40rem 22rem at 12% 7%, rgba(255, 124, 51, 0.12), transparent 70%),
      radial-gradient(34rem 18rem at 88% 10%, rgba(225, 196, 143, 0.11), transparent 72%),
      linear-gradient(180deg, #f8f4eb 0%, #f2ede2 42%, #ece6da 100%);
    color: var(--tone-text);
  }

  :global(body.writing-workbench-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.07), transparent 26%),
      linear-gradient(to left, rgba(119, 92, 62, 0.04), transparent 38%),
      radial-gradient(54rem 30rem at 18% 4%, rgba(255, 124, 51, 0.08), transparent 66%);
  }

  .writing-page-header,
  .writing-desk-shell,
  .writing-documents,
  .writing-archive {
    max-width: 1440px;
    margin: 0 auto;
    padding-left: 1.25rem;
    padding-right: 1.25rem;
  }

  .writing-page-header {
    padding-top: 1.4rem;
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .writing-page-header__copy {
    max-width: 72ch;
  }

  .writing-page-header__kicker {
    margin: 0 0 0.45rem;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tone-accent-glow);
  }

  .writing-page-header h1,
  .writing-documents h2,
  .writing-archive h2,
  .writing-document-card h3,
  .writing-entry-row h3 {
    font-family: ui-serif, Georgia, Cambria, 'Times New Roman', Times, serif;
    letter-spacing: -0.02em;
  }

  .writing-page-header__dek {
    margin: 0.85rem 0 0;
    max-width: 62ch;
    font-size: 1.02rem;
    color: var(--tone-muted);
    line-height: 1.78;
  }

  .writing-page-header__cue {
    margin: 0.75rem 0 0;
    width: fit-content;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 28%, var(--line2));
    border-radius: 999px;
    padding: 0.32rem 0.72rem;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.75), rgba(255, 255, 255, 0.35)),
      color-mix(in srgb, var(--tone-surface) 84%, transparent);
  }

  .writing-page-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    padding: 0.95rem 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.58), rgba(255, 255, 255, 0.2)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  .writing-page-header__meta p,
  .writing-page-header__meta a {
    margin: 0;
  }

  .writing-page-header__meta a {
    color: var(--tone-accent-glow);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 50%, transparent);
  }

  .writing-desk-shell {
    margin-top: 1.25rem;
  }

  .writing-archive {
    margin-top: clamp(1.6rem, 3vw, 2.5rem);
    padding-bottom: 2.2rem;
  }

  .writing-documents {
    margin-top: clamp(1.6rem, 3vw, 2.4rem);
  }

  .writing-documents__header {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .writing-documents__kicker {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tone-accent-glow);
  }

  .writing-documents__dek {
    margin: 0.6rem 0 0;
    max-width: 62ch;
    color: var(--tone-muted);
    line-height: 1.7;
  }

  .writing-documents__browse {
    width: fit-content;
    color: var(--tone-accent-glow);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 50%, transparent);
  }

  .writing-documents__grid {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .writing-document-card {
    position: relative;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    border-radius: 0.95rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.74), rgba(255, 255, 255, 0.24)),
      color-mix(in srgb, var(--tone-surface) 92%, transparent);
    padding: 1rem;
    display: grid;
    gap: 0.85rem;
    box-shadow: 0 14px 28px rgba(72, 59, 45, 0.08);
  }

  .writing-document-card::before {
    content: '';
    position: absolute;
    left: 0.62rem;
    top: 0.62rem;
    bottom: 0.62rem;
    width: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-accent) 64%, transparent);
    opacity: 0.72;
  }

  .writing-document-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1rem;
    align-items: center;
  }

  .writing-document-card__meta p,
  .writing-document-card__meta span {
    margin: 0;
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  .writing-document-card__summary,
  .writing-document-card__note {
    margin: 0;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    line-height: 1.72;
  }

  .writing-document-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .writing-document-card__link {
    width: fit-content;
    color: var(--tone-accent-glow);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 50%, transparent);
  }

  .writing-document-card__link--secondary {
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    border-color: var(--line2);
  }

  .writing-document-card__preview {
    border-top: 1px solid var(--line2);
    padding-top: 0.85rem;
  }

  .writing-document-card__preview summary {
    cursor: pointer;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .writing-document-card__frame {
    margin-top: 0.85rem;
    border: 1px solid var(--line2);
    border-radius: 0.9rem;
    overflow: hidden;
    background: color-mix(in srgb, var(--tone-bg-deep) 78%, black 22%);
  }

  .writing-document-card__frame iframe {
    display: block;
    width: 100%;
    min-height: 26rem;
    border: 0;
    background: white;
  }

  .writing-archive__header {
    display: grid;
    gap: 1rem;
    align-items: end;
  }

  .writing-archive__kicker {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--tone-accent-glow);
  }

  .writing-archive__dek {
    margin: 0.6rem 0 0;
    max-width: 60ch;
    color: var(--tone-muted);
  }

  .writing-archive__controls {
    display: grid;
    gap: 0.75rem;
  }

  .writing-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  @media (max-width: 900px) {
    .writing-documents__grid {
      grid-template-columns: 1fr;
    }
  }

  .writing-filter {
    appearance: none;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 22%, var(--line2));
    border-radius: 999px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.76), rgba(255, 255, 255, 0.3)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    color: var(--tone-muted);
    padding: 0.45rem 0.75rem;
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition: transform 140ms ease, border-color 160ms ease, background 160ms ease;
  }

  .writing-filter.is-active {
    border-color: color-mix(in srgb, var(--tone-accent) 66%, var(--line2));
    background:
      linear-gradient(180deg, rgba(255, 198, 165, 0.7), rgba(255, 173, 128, 0.4)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    color: color-mix(in srgb, var(--tone-text) 72%, var(--tone-accent) 28%);
    transform: translateY(-1px);
  }

  .writing-results {
    margin: 0;
    font-size: 0.82rem;
    color: var(--tone-muted);
  }

  .writing-list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .writing-entry-row {
    position: relative;
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    border-radius: 0.95rem;
    background:
      linear-gradient(
        180deg,
        rgba(255, 255, 255, 0.74),
        rgba(255, 255, 255, 0.24)
      );
    box-shadow: 0 14px 30px rgba(72, 59, 45, 0.09);
    transition: border-color 170ms ease, transform 170ms ease, box-shadow 170ms ease;
  }

  .writing-entry-row::before {
    content: '';
    position: absolute;
    left: 0.58rem;
    top: 0.72rem;
    bottom: 0.72rem;
    width: 2px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-accent) 58%, transparent);
    opacity: 0.66;
  }

  .writing-entry-row:hover {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tone-accent) 44%, var(--line2));
    box-shadow: 0 20px 36px rgba(72, 59, 45, 0.12);
  }

  .writing-entry-row__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--tone-muted);
  }

  .writing-entry-row__state {
    border: 1px solid var(--line2);
    border-radius: 999px;
    padding: 0.2rem 0.5rem;
  }

  .writing-entry-row__state.is-ready {
    border-color: color-mix(in srgb, var(--tone-accent) 30%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .writing-entry-row__body {
    display: grid;
    gap: 0.55rem;
    padding-left: 0.2rem;
  }

  .writing-entry-row__body h3,
  .writing-entry-row__body p {
    margin: 0;
  }

  .writing-entry-row__body a {
    color: var(--tone-text);
    text-decoration: none;
  }

  .writing-entry-row__body > p {
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
    line-height: 1.78;
    max-width: 68ch;
  }

  .writing-entry-row__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    justify-content: space-between;
  }

  .writing-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .writing-tag {
    display: inline-flex;
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 20%, var(--line2));
    font-size: 0.72rem;
    color: var(--tone-muted);
    background: color-mix(in srgb, var(--tone-surface-strong) 70%, transparent);
  }

  .writing-read-link {
    color: var(--tone-accent-glow);
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 55%, transparent);
