---
import BaseLayout from '../layouts/BaseLayout.astro';
import { MUSIC_URLS, SOCIAL_URLS } from '../data/site-refs';
import '../styles/pages/distribution.css';

const distributionLayers = [
  {
    title: 'Substack',
    description: 'Essays and longform writing.',
    href: SOCIAL_URLS.substackPublication,
    ctaLabel: 'Read on Substack',
  },
  {
    title: 'YouTube',
    description: 'Theater, performances, and process videos.',
    href: SOCIAL_URLS.youtube,
    ctaLabel: 'Watch on YouTube',
  },
  {
    title: 'Instagram',
    description: 'Visual archive and Newark imagery.',
    href: SOCIAL_URLS.instagram,
    ctaLabel: 'Open Instagram',
  },
  {
    title: 'Spotify',
    description: 'Official music releases.',
    href: MUSIC_URLS.spotifyVol4,
    ctaLabel: 'Listen on Spotify',
  },
  {
    title: 'X',
    description: 'Short updates and commentary.',
    href: SOCIAL_URLS.x,
    ctaLabel: 'Open X',
  },
  {
    title: 'TikTok',
    description: 'Short-form video clips.',
    href: SOCIAL_URLS.tiktok,
    ctaLabel: 'Watch on TikTok',
  },
  {
    title: 'SoundCloud',
    description: 'Demos and sketches.',
    href: SOCIAL_URLS.soundcloud,
    ctaLabel: 'Listen on SoundCloud',
  },
  {
    title: 'Discord',
    description: 'Community chat.',
    href: SOCIAL_URLS.discordCreators,
    ctaLabel: 'Enter Discord',
  },
  {
    title: 'Twitch',
    description: 'Live sessions and streams.',
    href: SOCIAL_URLS.twitch,
    ctaLabel: 'Watch on Twitch',
  },
] as const;
---

<BaseLayout
  title="Distribution — Angel Suero"
  description="External publishing links. This website is the primary archive."
  theme="archive"
  forceThemeMode="light"
  bodyClass="distribution-page"
  flatSurface={true}
  showHeader={true}
  ambientEffects={false}
  fullBleed={true}
>
  <main class="distribution-shell">
    <section class="distribution-hero" aria-labelledby="distribution-title">
      <p class="distribution-kicker">Distribution</p>
      <h1 id="distribution-title">Where to find the work.</h1>
      <p class="distribution-dek">
        This website is the main archive. These links go to platform versions.
      </p>

      <div class="distribution-home-links" aria-label="Main site navigation">
        <a href="/">Home</a>
        <a href="/work">Work</a>
        <a href="/archive">Archive</a>
        <a href="/contact">Contact</a>
      </div>
    </section>

    <section class="distribution-grid" aria-label="External platforms">
      {distributionLayers.map((layer) => (
        <article class="distribution-card">
          <h2>{layer.title}</h2>
          <p>{layer.description}</p>
          <a href={layer.href} target="_blank" rel="noopener" class="distribution-card-cta">
            {layer.ctaLabel}
          </a>
        </article>
      ))}
    </section>
  </main>
</BaseLayout>

