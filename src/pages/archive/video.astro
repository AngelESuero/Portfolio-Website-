---
import EntryCard from '../../components/EntryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ARCHIVE_MEDIUMS,
  getArchiveMediumHref,
  getEntryDisplayMedium,
  sortEntriesByDate
} from '../../lib/archive-entries';
import { formatLongArchiveUtcDate } from '../../lib/date-formatting';
import { getAllEntries } from '../../lib/site-collections';
import '../../styles/pages/archive/video.css';

const allEntries = sortEntriesByDate(await getAllEntries());
const entries = allEntries.filter((e) => e.data.medium === 'video');

const videos = entries.filter((e) => e.data.ingest?.surface === 'videos');
const streams = entries.filter((e) => e.data.ingest?.surface === 'streams');
const shorts = entries.filter((e) => e.data.ingest?.surface === 'shorts');
const other = entries.filter((e) => !e.data.ingest?.surface || !['videos','streams','shorts'].includes(e.data.ingest.surface));
---
<BaseLayout title="Video Archive — a_e.s_" theme="archive">
  <section class="view-surface archive-video">
    <header class="view-surface-header archive-video__header">
      <p class="view-surface-kicker">Archive lane</p>
      <h1>Video</h1>
      <p class="archive-video__description">
        Moving-image work filed into the archive: standalone uploads, streams, and shorts kept as a continuous channel record.
      </p>
      <div class="archive-video__meta font-archive">
        <p>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
        <p>{videos.length} uploads · {streams.length} streams · {shorts.length} shorts</p>
        {entries[0] && <p>Latest: {formatLongArchiveUtcDate(entries[0].data.date)}</p>}
      </div>
    </header>

    <nav class="archive-video__browse font-archive" aria-label="Archive lane pages">
      <a href="/archive" class="archive-video__browse-link">All archive</a>
      {ARCHIVE_MEDIUMS.map((lane) => (
        <a
          href={getArchiveMediumHref(lane)}
          class:list={['archive-video__browse-link', lane === 'video' && 'is-current']}
          {...(lane === 'video' ? { 'aria-current': 'page' } : {})}
        >
          {getEntryDisplayMedium(lane)}
        </a>
      ))}
    </nav>

    <section class="archive-video-controls" aria-label="Video filters">
      <div class="archive-video-controls__group">
        <p class="archive-video-controls__label font-archive">Type</p>
        <div class="archive-video-controls__buttons" role="group" aria-label="Filter by video type">
          <button type="button" class="archive-filter font-archive is-active" data-surface="all" aria-pressed="true">
            All ({entries.length})
          </button>
          {videos.length > 0 && (
            <button type="button" class="archive-filter font-archive" data-surface="videos" aria-pressed="false">
              Uploads ({videos.length})
            </button>
          )}
          {streams.length > 0 && (
            <button type="button" class="archive-filter font-archive" data-surface="streams" aria-pressed="false">
              Streams ({streams.length})
            </button>
          )}
          {shorts.length > 0 && (
            <button type="button" class="archive-filter font-archive" data-surface="shorts" aria-pressed="false">
              Shorts ({shorts.length})
            </button>
          )}
        </div>
      </div>
    </section>

    <div class="archive-results font-archive">
      <p id="archive-results-count">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
    </div>

    {entries.length === 0 ? (
      <p class="archive-video__empty">No video entries yet.</p>
    ) : (
      <>
        <ul class="archive-video__list" id="archive-video-list">
          {entries.map((entry) => (
            <li
              class="archive-video__item"
              data-surface={entry.data.ingest?.surface ?? 'other'}
            >
              <EntryCard entry={entry} />
            </li>
          ))}
        </ul>
        <p class="archive-video__empty" id="archive-video-empty" hidden>Nothing matches this filter.</p>
      </>
    )}
  </section>

  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('[data-surface]'));
      const filterButtons = buttons.filter((b) => b.tagName === 'BUTTON');
      const items = Array.from(document.querySelectorAll('.archive-video__item'));
      const resultsCount = document.getElementById('archive-results-count');
      const emptyState = document.getElementById('archive-video-empty');

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const surface = btn.getAttribute('data-surface') || 'all';

          filterButtons.forEach((b) => {
            const active = b.getAttribute('data-surface') === surface;
            b.classList.toggle('is-active', active);
            b.setAttribute('aria-pressed', String(active));
          });

          let count = 0;
          items.forEach((item) => {
            const itemSurface = item.getAttribute('data-surface') || 'other';
            const visible = surface === 'all' || itemSurface === surface;
            item.hidden = !visible;
            if (visible) count++;
          });

          if (resultsCount) resultsCount.textContent = `${count} ${count === 1 ? 'entry' : 'entries'}`;
          if (emptyState instanceof HTMLElement) emptyState.hidden = count !== 0;
        });
      });
    })();
  </script>
</BaseLayout>

