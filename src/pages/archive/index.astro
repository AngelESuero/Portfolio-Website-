---
import EntryCard from '../../components/EntryCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ARCHIVE_MEDIUMS,
  collectEntryTags,
  getArchiveMediumHref,
  getEntryDisplayMedium,
  normalizeEntryTag,
  sortEntriesByDate
} from '../../lib/archive-entries';
import { formatLongArchiveUtcDate } from '../../lib/date-formatting';
import { getAllEntries } from '../../lib/site-collections';

const entries = sortEntriesByDate(await getAllEntries());
const mediums = ARCHIVE_MEDIUMS;
const allTags = collectEntryTags(entries);
const DEFAULT_VISIBLE_TAGS = 6;
const mediumTagSet = new Set(mediums);
const tagCounts = [...entries.reduce((counts, entry) => {
  entry.data.tags
    .map(normalizeEntryTag)
    .filter(Boolean)
    .forEach((tag) => counts.set(tag, (counts.get(tag) || 0) + 1));
  return counts;
}, new Map<string, number>()).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const rankedTags = [
  ...tagCounts.filter(([tag]) => !mediumTagSet.has(tag as typeof mediums[number])),
  ...tagCounts.filter(([tag]) => mediumTagSet.has(tag as typeof mediums[number]))
].map(([tag]) => tag);
const featuredTags = rankedTags.slice(0, DEFAULT_VISIBLE_TAGS);
const secondaryTags = allTags.filter((tag) => !featuredTags.includes(tag));
---
<BaseLayout title="Archive — a_e.s_" theme="archive" bodyClass="archive-ig-page">
  <section class="view-surface archive-page">
    <header class="view-surface-header archive-page__header">
      <p class="view-surface-kicker">Living archive</p>
      <h1>Archive</h1>
      <p class="archive-page__description">
        Entries, fragments, notes, demos, releases, and proposals kept in one public record. New things tend to land
        here first; some later gather into work.
      </p>
      <div class="archive-page__meta font-archive">
        <p>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
        <p>{mediums.length} mediums</p>
        {entries[0] && <p>Latest: {formatLongArchiveUtcDate(entries[0].data.date)}</p>}
      </div>
    </header>

    <nav class="archive-page__browse font-archive" aria-label="Archive lane pages">
      <a href="/archive" class="archive-page__browse-link is-current" aria-current="page">All archive</a>
      {mediums.map((medium) => (
        <a href={getArchiveMediumHref(medium)} class="archive-page__browse-link">
          {getEntryDisplayMedium(medium)}
        </a>
      ))}
    </nav>

    <section class="archive-controls" aria-label="Archive filters">
      <div class="archive-controls__group">
        <p class="archive-controls__label font-archive">Medium</p>
        <div class="archive-controls__buttons" role="group" aria-label="Filter by medium">
          <button type="button" class="archive-filter font-archive is-active" data-filter-group="medium" data-filter-value="all" aria-pressed="true">
            All
          </button>
          {mediums.map((medium) => (
            <button type="button" class="archive-filter font-archive" data-filter-group="medium" data-filter-value={medium} aria-pressed="false">
              {getEntryDisplayMedium(medium)}
            </button>
          ))}
        </div>
      </div>

      {allTags.length > 0 && (
        <details class="archive-controls__toggle" id="archive-tag-toggle">
          <summary class="archive-controls__toggle-summary font-archive">
            <span class="archive-controls__toggle-label archive-controls__toggle-label--show">Show tags</span>
            <span class="archive-controls__toggle-label archive-controls__toggle-label--hide">Hide tags</span>
          </summary>

          <div class="archive-controls__group archive-controls__group--secondary archive-controls__group--tags">
            <div class="archive-controls__heading">
              <p class="archive-controls__label font-archive">Tags</p>
            </div>

            <div class="archive-controls__buttons" role="group" aria-label="Filter by tag">
              <button type="button" class="archive-filter font-archive is-active" data-filter-group="tag" data-filter-value="all" aria-pressed="true">
                All
              </button>
              {featuredTags.map((tag) => (
                <button type="button" class="archive-filter font-archive" data-filter-group="tag" data-filter-value={tag} aria-pressed="false">
                  #{tag}
                </button>
              ))}
            </div>

            {secondaryTags.length > 0 && (
              <details class="archive-controls__more">
                <summary class="archive-controls__more-toggle font-archive">
                  More tags <span aria-hidden="true">({secondaryTags.length})</span>
                </summary>
                <div class="archive-controls__buttons archive-controls__buttons--secondary" role="group" aria-label="More archive tags">
                  {secondaryTags.map((tag) => (
                    <button type="button" class="archive-filter font-archive" data-filter-group="tag" data-filter-value={tag} aria-pressed="false">
                      #{tag}
                    </button>
                  ))}
                </div>
              </details>
            )}
          </div>
        </details>
      )}
    </section>

    <div class="archive-results font-archive">
      <p id="archive-results-count">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
    </div>

    {entries.length === 0 ? (
      <p class="archive-empty">No archive entries yet.</p>
    ) : (
      <>
        <ul class="archive-list" id="archive-list">
          {entries.map((entry) => (
            <li
              class="archive-item"
              data-medium={entry.data.medium}
              data-tags={entry.data.tags.map((tag) => normalizeEntryTag(tag)).join(' ')}
            >
              <EntryCard entry={entry} />
            </li>
          ))}
        </ul>
        <p class="archive-empty" id="archive-empty-state" hidden>Nothing matches this filter yet.</p>
      </>
    )}
  </section>

  <script is:inline>
    (() => {
      const buttons = Array.from(document.querySelectorAll('.archive-filter'));
      const items = Array.from(document.querySelectorAll('.archive-item'));
      const resultsCount = document.getElementById('archive-results-count');
      const emptyState = document.getElementById('archive-empty-state');
      const tagToggle = document.getElementById('archive-tag-toggle');
      let activeMedium = 'all';
      let activeTag = 'all';

      const updateGroupState = (group, value) => {
        buttons
          .filter((button) => button instanceof HTMLButtonElement && button.dataset.filterGroup === group)
          .forEach((button) => {
            const isActive = button.dataset.filterValue === value;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-pressed', String(isActive));
          });
      };

      const render = () => {
        let visibleCount = 0;

        items.forEach((item) => {
          if (!(item instanceof HTMLElement)) return;

          const itemMedium = item.dataset.medium || '';
          const itemTags = (item.dataset.tags || '').split(/\s+/).filter(Boolean);
          const mediumMatch = activeMedium === 'all' || itemMedium === activeMedium;
          const tagMatch = activeTag === 'all' || itemTags.includes(activeTag);
          const visible = mediumMatch && tagMatch;

          item.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (resultsCount) {
          resultsCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'entry' : 'entries'}`;
        }

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount !== 0;
        }
      };

      buttons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;

        button.addEventListener('click', () => {
          const group = button.dataset.filterGroup;
          const value = button.dataset.filterValue || 'all';
          if (group === 'medium') activeMedium = value;
          if (group === 'tag') activeTag = value;
          if (group) updateGroupState(group, value);
          render();
        });
      });

      if (tagToggle instanceof HTMLDetailsElement) {
        tagToggle.addEventListener('toggle', () => {
          if (!tagToggle.open && activeTag !== 'all') {
            activeTag = 'all';
            updateGroupState('tag', 'all');
            render();
          }
        });
      }

      render();
    })();
  </script>
</BaseLayout>

<style>
  :global(body.archive-ig-page[data-theme='archive']) {
    --tone-bg: #12101a;
    --tone-bg-deep: #09070f;
    --tone-surface: rgba(25, 20, 36, 0.9);
    --tone-surface-strong: rgba(17, 13, 27, 0.96);
    --tone-text: rgba(244, 238, 255, 0.95);
    --tone-muted: rgba(201, 189, 228, 0.78);
    --tone-line: rgba(214, 181, 255, 0.2);
    --line2: rgba(214, 181, 255, 0.14);
    --tone-accent: #ff4f8b;
    --tone-accent-glow: #ffd1e4;
    --tone-sky: #7f8bff;
    background:
      radial-gradient(42rem 26rem at 16% 8%, rgba(255, 88, 155, 0.2), transparent 58%),
      radial-gradient(50rem 26rem at 84% 6%, rgba(127, 139, 255, 0.18), transparent 60%),
      radial-gradient(42rem 24rem at 50% 94%, rgba(246, 167, 96, 0.12), transparent 64%),
      linear-gradient(180deg, #12101a 0%, #0d0b14 45%, #09070f 100%);
  }

  :global(body.archive-ig-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.04), transparent 28%),
      linear-gradient(to left, rgba(255, 255, 255, 0.04), transparent 28%),
      radial-gradient(60rem 30rem at 20% 2%, rgba(255, 88, 155, 0.1), transparent 62%),
      radial-gradient(56rem 34rem at 80% 3%, rgba(127, 139, 255, 0.1), transparent 64%);
  }

  .archive-page__header {
    position: relative;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line2);
    border-radius: 1.2rem;
    background:
      radial-gradient(110% 160% at 4% 0%, rgba(255, 88, 155, 0.12), transparent 56%),
      linear-gradient(180deg, rgba(32, 25, 44, 0.84), rgba(17, 13, 27, 0.9));
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .archive-page {
    display: grid;
    gap: 1.5rem;
  }

  .archive-page__description {
    max-width: 68ch;
  }

  .archive-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    color: color-mix(in srgb, var(--tone-text) 82%, var(--tone-muted) 18%);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .archive-page__meta p,
  .archive-results p {
    margin: 0;
  }

  .archive-page__browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .archive-page__browse-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.15rem;
    padding: 0.4rem 0.74rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    color: color-mix(in srgb, var(--tone-text) 80%, var(--tone-muted) 20%);
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .archive-page__browse-link.is-current,
  .archive-page__browse-link:hover,
  .archive-page__browse-link:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 56%, var(--line2));
    color: #fff6fd;
    transform: translateY(-1px);
    background:
      linear-gradient(135deg, rgba(255, 88, 155, 0.28), rgba(127, 139, 255, 0.26)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .archive-controls {
    display: grid;
    gap: 1rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--line2);
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.022), transparent 72%),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .archive-controls__group {
    display: grid;
    gap: 0.55rem;
  }

  .archive-controls__group--secondary {
    gap: 0.7rem;
  }

  .archive-controls__group--tags {
    margin-top: 0.72rem;
  }

  .archive-controls__toggle {
    border-top: 1px solid var(--line2);
    padding-top: 0.72rem;
  }

  .archive-controls__toggle[open] {
    padding-bottom: 0.04rem;
  }

  .archive-controls__toggle-summary {
    width: fit-content;
    cursor: pointer;
    list-style: none;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  .archive-controls__toggle-summary::-webkit-details-marker {
    display: none;
  }

  .archive-controls__toggle-summary:hover,
  .archive-controls__toggle-summary:focus-visible {
    color: var(--tone-text);
  }

  .archive-controls__toggle-label--hide,
  .archive-controls__toggle[open] .archive-controls__toggle-label--show {
    display: none;
  }

  .archive-controls__toggle[open] .archive-controls__toggle-label--hide {
    display: inline;
  }

  .archive-controls__heading {
    display: grid;
    gap: 0.22rem;
  }

  .archive-controls__label {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--tone-muted);
  }

  .archive-controls__note {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.42;
    color: color-mix(in srgb, var(--tone-text) 74%, var(--tone-muted) 26%);
  }

  .archive-controls__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.48rem;
  }

  .archive-controls__buttons--secondary {
    padding-top: 0.62rem;
  }

  .archive-controls__more {
    border-top: 1px solid var(--line2);
    padding-top: 0.68rem;
  }

  .archive-controls__more[open] {
    padding-bottom: 0.08rem;
  }

  .archive-controls__more-toggle {
    width: fit-content;
    cursor: pointer;
    list-style: none;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .archive-controls__more-toggle::-webkit-details-marker {
    display: none;
  }

  .archive-controls__more-toggle:hover,
  .archive-controls__more-toggle:focus-visible {
    color: var(--tone-text);
  }

  .archive-filter {
    border-radius: 999px;
    padding: 0.36rem 0.74rem;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
    transition: transform 140ms ease, border-color 180ms ease, background 180ms ease;
  }

  .archive-filter.is-active,
  .archive-filter:hover,
  .archive-filter:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 52%, var(--line2));
    color: #fff6fd;
    transform: translateY(-1px);
    background:
      linear-gradient(135deg, rgba(255, 88, 155, 0.24), rgba(127, 139, 255, 0.22)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .archive-results {
    color: color-mix(in srgb, var(--tone-text) 76%, var(--tone-muted) 24%);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1.05rem;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }

  .archive-item {
    content-visibility: auto;
    contain: layout style paint;
    contain-intrinsic-size: 32rem;
  }

  .archive-item {
    min-width: 0;
    transition: transform 200ms ease;
  }

  :global(body.archive-ig-page .archive-list .entry-card) {
    border-radius: 1.25rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    box-shadow:
      0 16px 36px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
    transition: transform 220ms ease, box-shadow 220ms ease, border-color 220ms ease;
  }

  :global(body.archive-ig-page .archive-list .entry-card:hover) {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--tone-accent) 56%, var(--line2));
    box-shadow:
      0 24px 44px rgba(0, 0, 0, 0.28),
      0 0 0 1px rgba(255, 88, 155, 0.24) inset;
  }

  :global(body.archive-ig-page .archive-list .entry-card__status) {
    border-color: color-mix(in srgb, var(--tone-accent) 48%, var(--line2));
    color: #fff2f8;
    background:
      linear-gradient(135deg, rgba(255, 88, 155, 0.24), rgba(127, 139, 255, 0.22));
  }

  :global(body.archive-ig-page .archive-list .entry-card__tags span) {
    border-color: color-mix(in srgb, var(--tone-accent) 36%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 74%, transparent);
  }

  :global(body.archive-ig-page .archive-list .entry-card__link) {
    color: #ffd8ea;
    border-bottom-color: color-mix(in srgb, var(--tone-accent) 72%, transparent);
  }

  .archive-empty {
    margin: 0;
    color: color-mix(in srgb, var(--tone-text) 82%, var(--tone-muted) 18%);
  }
</style>
