---
import EntryCard from '../../components/EntryCard.astro';
import CrossRouteResume from '../../components/CrossRouteResume.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import igManifest from '../../data/ig.json';
import {
  ARCHIVE_MEDIUMS,
  collectEntryTags,
  getArchiveMediumHref,
  getEntryHref,
  getEntryDisplayMedium,
  normalizeEntryTag,
  sortEntriesByDate
} from '../../lib/archive-entries';
import { formatLongArchiveUtcDate } from '../../lib/date-formatting';
import { getAllEntries } from '../../lib/site-collections';

const entries = sortEntriesByDate(await getAllEntries());
const mediums = ARCHIVE_MEDIUMS;
const allTags = collectEntryTags(entries);
const DEFAULT_VISIBLE_TAGS = 6;
const mediumTagSet = new Set(mediums);
const tagCounts = [...entries.reduce((counts, entry) => {
  entry.data.tags
    .map(normalizeEntryTag)
    .filter(Boolean)
    .forEach((tag) => counts.set(tag, (counts.get(tag) || 0) + 1));
  return counts;
}, new Map<string, number>()).entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));
const rankedTags = [
  ...tagCounts.filter(([tag]) => !mediumTagSet.has(tag as typeof mediums[number])),
  ...tagCounts.filter(([tag]) => mediumTagSet.has(tag as typeof mediums[number]))
].map(([tag]) => tag);
const featuredTags = rankedTags.slice(0, DEFAULT_VISIBLE_TAGS);
const secondaryTags = allTags.filter((tag) => !featuredTags.includes(tag));
const mediumHighlights = mediums
  .map((medium) => ({
    medium,
    entry: entries.find((entry) => entry.data.medium === medium) ?? null
  }))
  .filter((item): item is { medium: typeof mediums[number]; entry: (typeof entries)[number] } => Boolean(item.entry));
const pinnedCollections = tagCounts
  .filter(([tag, count]) => !mediumTagSet.has(tag as typeof mediums[number]) && count > 1)
  .slice(0, 5)
  .map(([tag, count]) => ({
    tag,
    count,
    sample: entries
      .filter((entry) => entry.data.tags.map(normalizeEntryTag).includes(tag))
      .slice(0, 2)
      .map((entry) => ({
        title: entry.data.title,
        href: getEntryHref(entry)
      }))
  }));
const storyPhotos = (Array.isArray(igManifest) ? igManifest : []).filter(
  (item) => typeof item?.src === 'string' && /\.(jpe?g|png|webp|avif)$/i.test(item.src)
);
---
<BaseLayout title="Archive — a_e.s_" theme="archive" bodyClass="archive-ig-page">
  <section class="view-surface archive-page">
    <header class="view-surface-header archive-page__header">
      <p class="view-surface-kicker">Living archive</p>
      <h1>Archive</h1>
      <p class="archive-page__description">
        Entries, fragments, notes, demos, releases, and proposals kept in one public record. New things tend to land
        here first; some later gather into work.
      </p>
      <p class="archive-page__cue">Instagram cue: visual-first scan, then open the full record.</p>
      <div class="archive-page__meta font-archive">
        <p>{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
        <p>{mediums.length} mediums</p>
        {entries[0] && <p>Latest: {formatLongArchiveUtcDate(entries[0].data.date)}</p>}
      </div>
    </header>

    <nav class="archive-page__browse font-archive" aria-label="Archive lane pages">
      <a href="/archive" class="archive-page__browse-link is-current" aria-current="page">All archive</a>
      {mediums.map((medium) => (
        <a href={getArchiveMediumHref(medium)} class="archive-page__browse-link">
          {getEntryDisplayMedium(medium)}
        </a>
      ))}
    </nav>

    <section class="archive-highlights" aria-label="Archive browse highlights">
      <article class="archive-highlight-card archive-highlight-card--medium">
        <header class="archive-highlight-card__head">
          <p class="archive-controls__label font-archive">Medium lanes</p>
          <span>Profile-style overview</span>
        </header>
        <div class="archive-highlight-card__body">
          {mediumHighlights.map(({ medium, entry }) => (
            <button type="button" class="archive-highlight-medium" data-collection-medium={medium}>
              <span>{getEntryDisplayMedium(medium)}</span>
              <strong>{entry.data.title}</strong>
              <small>{formatLongArchiveUtcDate(entry.data.date)}</small>
            </button>
          ))}
        </div>
      </article>

      {pinnedCollections.length > 0 && (
        <article class="archive-highlight-card archive-highlight-card--collections">
          <header class="archive-highlight-card__head">
            <p class="archive-controls__label font-archive">Pinned collections</p>
            <span>Calm highlight sets</span>
          </header>
          <div class="archive-highlight-card__body archive-highlight-card__body--collections">
            {pinnedCollections.map((collection) => (
              <section class="archive-collection">
                <header>
                  <button type="button" data-collection-tag={collection.tag}>#{collection.tag}</button>
                  <span>{collection.count} entries</span>
                </header>
                <ul>
                  {collection.sample.map((item) => (
                    <li><a href={item.href}>{item.title}</a></li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </article>
      )}
    </section>

    {storyPhotos.length > 0 && (
      <section class="archive-stories" aria-label="Instagram stories preview rail">
        <header class="archive-stories__head">
          <div>
            <p class="archive-controls__label font-archive">Instagram stories</p>
            <h2>Curated strip from your local stories archive</h2>
          </div>
          <a href="/instagram" class="archive-stories__link">Open full stories archive</a>
        </header>
        <div class="archive-stories__track">
          {storyPhotos.map((item) => (
            <a href="/instagram" class="archive-story-card">
              <img src={item.src} alt={item.caption || `Instagram story item from ${item.date || 'local archive'}`} loading="lazy" decoding="async" />
              <span>{item.date || 'Story'}</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="archive-controls" aria-label="Archive filters">
      <div class="archive-controls__group">
        <p class="archive-controls__label font-archive">Medium</p>
        <div class="archive-controls__buttons" role="group" aria-label="Filter by medium">
          <button type="button" class="archive-filter font-archive is-active" data-filter-group="medium" data-filter-value="all" aria-pressed="true">
            All
          </button>
          {mediums.map((medium) => (
            <button type="button" class="archive-filter font-archive" data-filter-group="medium" data-filter-value={medium} aria-pressed="false">
              {getEntryDisplayMedium(medium)}
            </button>
          ))}
        </div>
      </div>

      {allTags.length > 0 && (
        <details class="archive-controls__toggle" id="archive-tag-toggle">
          <summary class="archive-controls__toggle-summary font-archive">
            <span class="archive-controls__toggle-label archive-controls__toggle-label--show">Show tags</span>
            <span class="archive-controls__toggle-label archive-controls__toggle-label--hide">Hide tags</span>
          </summary>

          <div class="archive-controls__group archive-controls__group--secondary archive-controls__group--tags">
            <div class="archive-controls__heading">
              <p class="archive-controls__label font-archive">Tags</p>
            </div>

            <div class="archive-controls__buttons" role="group" aria-label="Filter by tag">
              <button type="button" class="archive-filter font-archive is-active" data-filter-group="tag" data-filter-value="all" aria-pressed="true">
                All
              </button>
              {featuredTags.map((tag) => (
                <button type="button" class="archive-filter font-archive" data-filter-group="tag" data-filter-value={tag} aria-pressed="false">
                  #{tag}
                </button>
              ))}
            </div>

            {secondaryTags.length > 0 && (
              <details class="archive-controls__more">
                <summary class="archive-controls__more-toggle font-archive">
                  More tags <span aria-hidden="true">({secondaryTags.length})</span>
                </summary>
                <div class="archive-controls__buttons archive-controls__buttons--secondary" role="group" aria-label="More archive tags">
                  {secondaryTags.map((tag) => (
                    <button type="button" class="archive-filter font-archive" data-filter-group="tag" data-filter-value={tag} aria-pressed="false">
                      #{tag}
                    </button>
                  ))}
                </div>
              </details>
            )}
          </div>
        </details>
      )}
    </section>

    <div class="archive-results font-archive">
      <p id="archive-results-count">{entries.length} {entries.length === 1 ? 'entry' : 'entries'}</p>
    </div>

    {entries.length === 0 ? (
      <p class="archive-empty">No archive entries yet.</p>
    ) : (
      <>
        <ul class="archive-list" id="archive-list">
          {entries.map((entry) => (
            <li
              class="archive-item"
              data-medium={entry.data.medium}
              data-tags={entry.data.tags.map((tag) => normalizeEntryTag(tag)).join(' ')}
            >
              <EntryCard entry={entry} />
            </li>
          ))}
        </ul>
        <p class="archive-empty" id="archive-empty-state" hidden>Nothing matches this filter yet.</p>
      </>
    )}

    <CrossRouteResume current="archive" className="archive-resume" heading="Resume your other sections" />
  </section>

  <script is:inline>
    (() => {
      const FILTER_KEY = 'archive-filter-state';
      const buttons = Array.from(document.querySelectorAll('.archive-filter'));
      const items = Array.from(document.querySelectorAll('.archive-item'));
      const resultsCount = document.getElementById('archive-results-count');
      const emptyState = document.getElementById('archive-empty-state');
      const tagToggle = document.getElementById('archive-tag-toggle');
      let activeMedium = 'all';
      let activeTag = 'all';
      const validByGroup = {
        medium: new Set(
          buttons
            .filter((button) => button instanceof HTMLButtonElement && button.dataset.filterGroup === 'medium')
            .map((button) => button.dataset.filterValue || 'all')
        ),
        tag: new Set(
          buttons
            .filter((button) => button instanceof HTMLButtonElement && button.dataset.filterGroup === 'tag')
            .map((button) => button.dataset.filterValue || 'all')
        )
      };
      const resolveFilter = (group, candidate) =>
        candidate && validByGroup[group].has(candidate) ? candidate : 'all';

      const updateGroupState = (group, value) => {
        buttons
          .filter((button) => button instanceof HTMLButtonElement && button.dataset.filterGroup === group)
          .forEach((button) => {
            const isActive = button.dataset.filterValue === value;
            button.classList.toggle('is-active', isActive);
            button.setAttribute('aria-pressed', String(isActive));
          });
      };

      const render = () => {
        let visibleCount = 0;

        items.forEach((item) => {
          if (!(item instanceof HTMLElement)) return;

          const itemMedium = item.dataset.medium || '';
          const itemTags = (item.dataset.tags || '').split(/\s+/).filter(Boolean);
          const mediumMatch = activeMedium === 'all' || itemMedium === activeMedium;
          const tagMatch = activeTag === 'all' || itemTags.includes(activeTag);
          const visible = mediumMatch && tagMatch;

          item.hidden = !visible;
          if (visible) visibleCount += 1;
        });

        if (resultsCount) {
          resultsCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'entry' : 'entries'}`;
        }

        if (emptyState instanceof HTMLElement) {
          emptyState.hidden = visibleCount !== 0;
        }
      };
      const persistState = () => {
        try {
          window.localStorage.setItem(
            FILTER_KEY,
            JSON.stringify({ medium: activeMedium, tag: activeTag })
          );
        } catch {}
      };
      const syncQuery = () => {
        const url = new URL(window.location.href);
        if (activeMedium === 'all') {
          url.searchParams.delete('medium');
        } else {
          url.searchParams.set('medium', activeMedium);
        }
        if (activeTag === 'all') {
          url.searchParams.delete('tag');
        } else {
          url.searchParams.set('tag', activeTag);
        }
        window.history.replaceState({}, '', `${url.pathname}${url.search}${url.hash}`);
      };
      const applyState = () => {
        if (tagToggle instanceof HTMLDetailsElement) {
          tagToggle.open = activeTag !== 'all';
        }
        render();
        persistState();
        syncQuery();
      };
      const scrollToResults = () => {
        const list = document.getElementById('archive-list');
        if (list instanceof HTMLElement) {
          list.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };
      const setMedium = (value) => {
        activeMedium = resolveFilter('medium', value || 'all');
        updateGroupState('medium', activeMedium);
      };
      const setTag = (value) => {
        activeTag = resolveFilter('tag', value || 'all');
        updateGroupState('tag', activeTag);
      };

      buttons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;

        button.addEventListener('click', () => {
          const group = button.dataset.filterGroup;
          const value = button.dataset.filterValue || 'all';
          if (group === 'medium') setMedium(value);
          if (group === 'tag') setTag(value);
          applyState();
        });
      });

      document.querySelectorAll('[data-collection-medium]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          setMedium(button.dataset.collectionMedium || 'all');
          setTag('all');
          applyState();
          scrollToResults();
        });
      });

      document.querySelectorAll('[data-collection-tag]').forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;
        button.addEventListener('click', () => {
          if (tagToggle instanceof HTMLDetailsElement) tagToggle.open = true;
          setTag(button.dataset.collectionTag || 'all');
          setMedium('all');
          applyState();
          scrollToResults();
        });
      });

      if (tagToggle instanceof HTMLDetailsElement) {
        tagToggle.addEventListener('toggle', () => {
          if (!tagToggle.open && activeTag !== 'all') {
            setTag('all');
            applyState();
          }
        });
      }

      const params = new URLSearchParams(window.location.search);
      let initialMedium = resolveFilter('medium', params.get('medium') || '');
      let initialTag = resolveFilter('tag', params.get('tag') || '');
      if (initialMedium === 'all' && initialTag === 'all') {
        try {
          const saved = JSON.parse(window.localStorage.getItem(FILTER_KEY) || '{}');
          initialMedium = resolveFilter('medium', saved.medium || '');
          initialTag = resolveFilter('tag', saved.tag || '');
        } catch {}
      }
      setMedium(initialMedium);
      setTag(initialTag);
      applyState();
    })();
  </script>
</BaseLayout>

<style>
  :global(body.archive-ig-page[data-theme='archive']) {
    --tone-bg: #12101a;
    --tone-bg-deep: #09070f;
    --tone-surface: rgba(25, 20, 36, 0.9);
    --tone-surface-strong: rgba(17, 13, 27, 0.96);
    --tone-text: rgba(244, 238, 255, 0.95);
    --tone-muted: rgba(201, 189, 228, 0.78);
    --tone-line: rgba(214, 181, 255, 0.2);
    --line2: rgba(214, 181, 255, 0.14);
    --tone-accent: #ff4f8b;
    --tone-accent-glow: #ffd1e4;
    --tone-sky: #7f8bff;
    background:
      radial-gradient(42rem 26rem at 16% 8%, rgba(255, 88, 155, 0.2), transparent 58%),
      radial-gradient(50rem 26rem at 84% 6%, rgba(127, 139, 255, 0.18), transparent 60%),
      radial-gradient(42rem 24rem at 50% 94%, rgba(246, 167, 96, 0.12), transparent 64%),
      linear-gradient(180deg, #12101a 0%, #0d0b14 45%, #09070f 100%);
  }

  :global(body.archive-ig-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(255, 255, 255, 0.04), transparent 28%),
      linear-gradient(to left, rgba(255, 255, 255, 0.04), transparent 28%),
      radial-gradient(60rem 30rem at 20% 2%, rgba(255, 88, 155, 0.1), transparent 62%),
      radial-gradient(56rem 34rem at 80% 3%, rgba(127, 139, 255, 0.1), transparent 64%);
  }

  .archive-page__header {
    position: relative;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line2);
    border-radius: 1.2rem;
    background:
      radial-gradient(110% 160% at 4% 0%, rgba(255, 88, 155, 0.12), transparent 56%),
      linear-gradient(180deg, rgba(32, 25, 44, 0.84), rgba(17, 13, 27, 0.9));
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.24),
      inset 0 1px 0 rgba(255, 255, 255, 0.05);
  }

  .archive-page {
    display: grid;
    gap: 1.5rem;
  }

  .archive-resume {
    margin-top: 0.2rem;
  }

  .archive-page__description {
    max-width: 68ch;
    font-size: 1.02rem;
    line-height: 1.72;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
  }

  .archive-page__cue {
    margin: 0;
    width: fit-content;
    max-width: 58ch;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 32%, var(--line2));
    border-radius: 999px;
    padding: 0.32rem 0.68rem;
    font-size: 0.78rem;
    line-height: 1.42;
    letter-spacing: 0.03em;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
    background:
      linear-gradient(135deg, rgba(255, 88, 155, 0.2), rgba(127, 139, 255, 0.18)),
      color-mix(in srgb, var(--tone-surface) 86%, transparent);
  }

  .archive-page__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1rem;
    color: color-mix(in srgb, var(--tone-text) 82%, var(--tone-muted) 18%);
    font-size: 0.86rem;
    letter-spacing: 0.02em;
  }

  .archive-page__meta p,
  .archive-results p {
    margin: 0;
  }

  .archive-page__browse {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .archive-stories {
    border: 1px solid var(--line2);
    border-radius: 1.05rem;
    padding: 0.9rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
    display: grid;
    gap: 0.75rem;
  }

  .archive-stories__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.65rem;
    flex-wrap: wrap;
  }

  .archive-stories__head h2 {
    margin: 0.14rem 0 0;
    font-size: clamp(1rem, 2.3vw, 1.24rem);
    letter-spacing: -0.01em;
    color: color-mix(in srgb, var(--tone-text) 92%, var(--tone-muted) 8%);
  }

  .archive-stories__link {
    font-size: 0.84rem;
    text-decoration: none;
    color: #ffe3ef;
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 64%, transparent);
  }

  .archive-stories__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(8rem, 9.8rem);
    gap: 0.62rem;
    overflow-x: auto;
    padding-bottom: 0.18rem;
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--tone-accent) 40%, transparent) transparent;
  }

  .archive-story-card {
    display: grid;
    gap: 0.38rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .archive-story-card img {
    width: 100%;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    border-radius: 0.78rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 32%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 80%, transparent);
  }

  .archive-story-card span {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 72%, var(--tone-muted) 28%);
  }

  .archive-highlights {
    display: grid;
    gap: 0.82rem;
  }

  .archive-highlight-card {
    border: 1px solid var(--line2);
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
    padding: 0.88rem 0.95rem;
  }

  .archive-highlight-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
  }

  .archive-highlight-card__head span {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tone-text) 70%, var(--tone-muted) 30%);
  }

  .archive-highlight-card__body {
    margin-top: 0.62rem;
    display: grid;
    gap: 0.55rem;
  }

  .archive-highlight-medium {
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    border-radius: 0.78rem;
    background: color-mix(in srgb, var(--tone-surface-strong) 70%, transparent);
    text-align: left;
    display: grid;
    gap: 0.14rem;
    padding: 0.52rem 0.58rem;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .archive-highlight-medium span {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-text) 76%, var(--tone-muted) 24%);
  }

  .archive-highlight-medium strong {
    font-size: 0.94rem;
    line-height: 1.36;
  }

  .archive-highlight-medium small {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-text) 68%, var(--tone-muted) 32%);
  }

  .archive-highlight-card__body--collections {
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .archive-collection {
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    border-radius: 0.75rem;
    padding: 0.55rem 0.6rem;
    background: color-mix(in srgb, var(--tone-surface-strong) 72%, transparent);
  }

  .archive-collection header {
    display: flex;
    justify-content: space-between;
    gap: 0.4rem;
    align-items: baseline;
  }

  .archive-collection header button {
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--tone-accent-glow);
    font: inherit;
    cursor: pointer;
  }

  .archive-collection header span {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-text) 70%, var(--tone-muted) 30%);
  }

  .archive-collection ul {
    margin: 0.48rem 0 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.3rem;
  }

  .archive-collection a {
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    text-decoration: none;
  }

  .archive-page__browse-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.15rem;
    padding: 0.4rem 0.74rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
    color: color-mix(in srgb, var(--tone-text) 80%, var(--tone-muted) 20%);
    text-decoration: none;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .archive-page__browse-link.is-current,
  .archive-page__browse-link:hover,
  .archive-page__browse-link:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 56%, var(--line2));
    color: #fff6fd;
    transform: translateY(-1px);
    background:
      linear-gradient(135deg, rgba(255, 88, 155, 0.28), rgba(127, 139, 255, 0.26)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .archive-controls {
    display: grid;
    gap: 1rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--line2);
    border-radius: 1rem;
