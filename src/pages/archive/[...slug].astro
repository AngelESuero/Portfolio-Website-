---
import type { CollectionEntry } from 'astro:content';
import ArchiveMusicEntryPlayer from '../../components/ArchiveMusicEntryPlayer.astro';
import EntryMediaBlock from '../../components/EntryMediaBlock.astro';
import VoiceExcerpt from '../../components/VoiceExcerpt.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getMusicManifestItemByEntryRef,
  getMusicSequenceNeighbors,
  type MusicEntryRef
} from '../../data/music-manifest';
import {
  entryHasBody,
  getArchiveMediumHref,
  getEntryDisplayMedium,
  getEntryDisplaySource,
  getEntryDisplayStatus,
  getEntryHref,
  getEntryVoiceExcerpt,
  shouldShowEntryStatus,
  sortEntriesByDate
} from '../../lib/archive-entries';
import { formatLongArchiveUtcDate } from '../../lib/date-formatting';
import { getMusicEntryRef, resolveMusicManifestItems } from '../../lib/music-player';
import { getAllEntries } from '../../lib/site-collections';
import { getLinkCtaLabel, providerFromUrl } from '../../lib/embed-resolver';
import '../../styles/pages/archive/[...slug].css';

export async function getStaticPaths() {
  const entries = await getAllEntries();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props as { entry: CollectionEntry<'entries'> };
const { Content } = await entry.render();
const allEntries = sortEntriesByDate(await getAllEntries());
const relatedEntries = (entry.data.related_entries || [])
  .map((slug) => allEntries.find((item) => item.slug === slug))
  .filter(Boolean) as CollectionEntry<'entries'>[];
const hasBody = entryHasBody(entry);
const mediumLabel = getEntryDisplayMedium(entry.data.medium);
const sourceLabel = getEntryDisplaySource(entry.data.source);
const showStatus = shouldShowEntryStatus(entry.data.status);
const statusLabel = getEntryDisplayStatus(entry.data.status);
const voiceExcerpt = getEntryVoiceExcerpt(entry, 240);
const voiceLabel =
  entry.data.medium === 'note'
    ? 'From the note'
    : entry.data.medium === 'writing'
      ? 'From the piece'
      : 'From the record';
const externalUrl = typeof entry.data.external_url === 'string' ? entry.data.external_url.trim() : '';
const externalProvider = externalUrl ? providerFromUrl(externalUrl) : null;
const externalLabel = externalUrl ? getLinkCtaLabel(externalUrl, externalProvider) : '';
const externalIsAbsolute = /^https?:\/\//i.test(externalUrl);
const mediumHref = getArchiveMediumHref(entry.data.medium);
const sameMediumEntries = allEntries
  .filter((item) => item.slug !== entry.slug && item.data.medium === entry.data.medium)
  .slice(0, 3);
const musicEntryRef = entry.data.medium === 'music' ? (getMusicEntryRef(entry) as MusicEntryRef) : null;
const manifestItem = musicEntryRef ? getMusicManifestItemByEntryRef(musicEntryRef) : null;
const neighbors = manifestItem ? getMusicSequenceNeighbors(manifestItem) : null;
const resolvedMusicItems = manifestItem ? resolveMusicManifestItems(allEntries) : [];
const resolvedMusicItemById = new Map(resolvedMusicItems.map((item) => [item.id, item] as const));
const musicPlayerItem = manifestItem ? resolvedMusicItemById.get(manifestItem.id) ?? null : null;
const previousMusicItem = neighbors?.previous ? resolvedMusicItemById.get(neighbors.previous.id) ?? null : null;
const nextMusicItem = neighbors?.next ? resolvedMusicItemById.get(neighbors.next.id) ?? null : null;
const showManifestMusicPlayer = Boolean(musicPlayerItem);
const showLegacyMediaBlock = !showManifestMusicPlayer
  && (entry.data.medium === 'music' || entry.data.medium === 'video' || entry.data.medium === 'image' || externalUrl || entry.data.asset);
const showFooterSourceLink = Boolean(externalUrl) && !showManifestMusicPlayer;
---
<BaseLayout title={`${entry.data.title} — Archive`} theme="archive">
  <article class="archive-entry">
    <nav class="archive-entry__backtrail font-archive" aria-label="Archive breadcrumbs">
      <a href="/archive" class="archive-entry__back">← All archive</a>
      <a href={mediumHref} class="archive-entry__back">Browse {mediumLabel}</a>
    </nav>

    <header class="archive-entry__header">
      <p class="archive-entry__meta font-archive">
        <span>{formatLongArchiveUtcDate(entry.data.date)}</span>
        <span>{mediumLabel}</span>
        <span>{sourceLabel}</span>
      </p>
      <h1 class="font-display text-4xl md:text-5xl">{entry.data.title}</h1>
      <VoiceExcerpt text={voiceExcerpt} label={voiceLabel} variant="feature" />

      <div class="archive-entry__details">
        <div class="archive-entry__tags font-archive" aria-label="Entry tags">
          {entry.data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
        {showStatus && <span class="archive-entry__status font-archive">{statusLabel}</span>}
      </div>
    </header>

    {showManifestMusicPlayer && musicPlayerItem && (
      <section class="archive-entry__media">
        <ArchiveMusicEntryPlayer
          item={musicPlayerItem}
          previousHref={previousMusicItem?.entryHref ?? null}
          previousTitle={previousMusicItem?.title ?? null}
          nextHref={nextMusicItem?.entryHref ?? null}
          nextTitle={nextMusicItem?.title ?? null}
        />
      </section>
    )}

    {showLegacyMediaBlock && (
      <section class="archive-entry__media">
        <EntryMediaBlock entry={entry} />
      </section>
    )}

    {hasBody && (
      <section class="reading-prose archive-entry__body">
        <Content />
      </section>
    )}

    {(showFooterSourceLink || relatedEntries.length > 0 || sameMediumEntries.length > 0) && (
      <footer class="archive-entry__footer">
        {showFooterSourceLink && (
          <a href={externalUrl} class="archive-entry__source-link" {...(externalIsAbsolute ? { target: '_blank', rel: 'noopener' } : {})}>
            {externalLabel}
          </a>
        )}

        {relatedEntries.length > 0 && (
          <div class="archive-entry__related">
            <p class="font-archive">Related entries</p>
            <div class="archive-entry__related-links">
              {relatedEntries.map((relatedEntry) => (
                <a href={getEntryHref(relatedEntry)}>{relatedEntry.data.title}</a>
              ))}
            </div>
          </div>
        )}

        {sameMediumEntries.length > 0 && (
          <div class="archive-entry__related">
            <p class="font-archive">More in {mediumLabel}</p>
            <div class="archive-entry__related-links">
              <a href={mediumHref}>Browse all {mediumLabel.toLowerCase()}</a>
              {sameMediumEntries.map((sameMediumEntry) => (
                <a href={getEntryHref(sameMediumEntry)}>{sameMediumEntry.data.title}</a>
              ))}
            </div>
          </div>
        )}
      </footer>
    )}
  </article>
</BaseLayout>

