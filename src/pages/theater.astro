---
import { getCollection } from 'astro:content';
import EntryMediaBlock from '../components/EntryMediaBlock.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';
import { formatLongUtcDate, formatShortUtcDate } from '../lib/date-formatting';
import type { ArchiveEntry } from '../lib/archive-entries';
import {
  ARCHIVE_MEDIUMS,
  getArchiveMediumHref,
  getEntryDisplayMedium,
  getEntryDisplaySource,
  getEntryDisplayStatus,
  getEntryHref,
  shouldShowEntryStatus,
  sortEntriesByDate
} from '../lib/archive-entries';

const archiveEntries = sortEntriesByDate(await getCollection('entries'));
const featuredEntries = ARCHIVE_MEDIUMS
  .map((medium) => archiveEntries.find((entry) => entry.data.medium === medium))
  .filter((entry): entry is ArchiveEntry => Boolean(entry));
const stageEntries = Array.from(
  new Map([...featuredEntries, ...archiveEntries.slice(0, 6)].map((entry) => [entry.slug, entry])).values()
).slice(0, 8);
const requestedSlug = Astro.url.searchParams.get('entry') ?? '';
const defaultEntry =
  stageEntries.find((entry) => entry.slug === requestedSlug) ??
  stageEntries.find((entry) => entry.data.medium === 'video') ??
  stageEntries.find((entry) => entry.data.medium === 'image') ??
  stageEntries.find((entry) => entry.data.medium === 'music') ??
  stageEntries[0] ??
  archiveEntries[0];
const renderedPanels = await Promise.all(
  stageEntries.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  })
);
---

<BaseLayout
  title="The Theater - a_e.s_"
  description={`An archive screening room for ${profile.name}'s entries.`}
  theme="archive"
  bodyClass="theater-page"
  fullBleed={true}
  ambientEffects={true}
>
  <main class="theater-shell">
    <section class="theater-hero">
      <div class="theater-hero__copy">
        <p class="theater-hero__eyebrow">Archive screening room</p>
        <h1>Center stage for the archive.</h1>
        <p class="theater-hero__lede">
          Choose a record from the queue. The stage holds the full archive entry while the rest of the room stays in
          support.
        </p>
        <div class="theater-hero__actions">
          <a href="#stage">Enter the room</a>
          <a href="/archive">Browse archive</a>
        </div>
      </div>
    </section>

    <section class="theater-stage" id="stage" aria-labelledby="theater-stage-heading">
      <div class="theater-stage__intro">
        <p class="theater-stage__eyebrow">Selected archive</p>
        <h2 id="theater-stage-heading">One record at a time, held in the light.</h2>
        <p>The queue stays narrow, the notes stay quiet, and the selected entry owns the frame.</p>
      </div>

      <div class="theater-room">
        <aside class="theater-rail theater-rail--archive" aria-label="Archive queue">
          <div class="theater-rail__head">
            <p>Archive queue</p>
            <a href="/archive">All archive</a>
          </div>

          <div class="theater-picker theater-picker--archive">
            {renderedPanels.map(({ entry }) => (
              <button
                type="button"
                class:list={['theater-picker__item', entry.slug === defaultEntry.slug && 'is-active']}
                data-theater-item
                data-entry-slug={entry.slug}
                aria-pressed={entry.slug === defaultEntry.slug ? 'true' : 'false'}
                aria-controls={`theater-panel-${entry.slug}`}
              >
                <span class="theater-picker__pill">{getEntryDisplayMedium(entry.data.medium)}</span>
                <span>
                  <strong>{entry.data.title}</strong>
                  <small>
                    {formatShortUtcDate(entry.data.date)} · {getEntryDisplaySource(entry.data.source)}
                  </small>
                </span>
              </button>
            ))}
          </div>
        </aside>

        <div class="theater-screening">
          <div class="theater-screening__marquee">
            <p>Center stage</p>
            <div>
              <h2>The real archive entry stays on the screen.</h2>
              <span>Click a record from the queue to change the projection.</span>
            </div>
          </div>

          <div class="theater-screen" aria-live="polite">
            {renderedPanels.map(({ entry, Content }) => {
              const showStatus = shouldShowEntryStatus(entry.data.status);
              const isActive = entry.slug === defaultEntry.slug;

              return (
                <article
                  id={`theater-panel-${entry.slug}`}
                  class:list={['theater-panel', isActive && 'is-active']}
                  data-theater-panel
                  data-entry-slug={entry.slug}
                  hidden={!isActive}
                >
                  <header class="theater-panel__header">
                    <p class="theater-panel__meta">
                      <span>{formatLongUtcDate(entry.data.date)}</span>
                      <span>{getEntryDisplayMedium(entry.data.medium)}</span>
                      <span>{getEntryDisplaySource(entry.data.source)}</span>
                    </p>

                    <div class="theater-panel__heading">
                      <h3>{entry.data.title}</h3>
                      {showStatus ? <span class="theater-panel__status">{getEntryDisplayStatus(entry.data.status)}</span> : null}
                    </div>

                    <p class="theater-panel__summary">{entry.data.summary}</p>

                    <div class="theater-panel__tags" aria-label="Entry tags">
                      {entry.data.tags.map((tag) => <span>#{tag}</span>)}
                    </div>
                  </header>

                  <div class="theater-panel__media">
                    <EntryMediaBlock entry={entry} compact={false} />
                  </div>

                  <section class="reading-prose theater-panel__body">
                    <Content />
                  </section>

                  <footer class="theater-panel__footer">
                    <a href={getEntryHref(entry)}>Open archive entry</a>
                    <a href={getArchiveMediumHref(entry.data.medium)}>
                      Browse {getEntryDisplayMedium(entry.data.medium).toLowerCase()}
                    </a>
                  </footer>
                </article>
              );
            })}
          </div>
        </div>

        <aside class="theater-rail theater-rail--notes" aria-label="House notes">
          <div class="theater-rail__head">
            <p>House notes</p>
            <a href={getEntryHref(defaultEntry)}>Open entry</a>
          </div>

          <div class="theater-notes">
            <p class="theater-notes__lede">
              The selected record gets the biggest frame. The rest of the archive stays close, but off to the side.
            </p>

            <div class="theater-notes__stack">
              <div>
                <span>Primary medium</span>
                <strong>{getEntryDisplayMedium(defaultEntry.data.medium)}</strong>
              </div>
              <div>
                <span>Source</span>
                <strong>{getEntryDisplaySource(defaultEntry.data.source)}</strong>
              </div>
              <div>
                <span>Status</span>
                <strong>{shouldShowEntryStatus(defaultEntry.data.status) ? getEntryDisplayStatus(defaultEntry.data.status) : 'Published'}</strong>
              </div>
            </div>

            <div class="theater-notes__links">
              <a href="/archive/video">Video archive</a>
              <a href="/archive/music">Music archive</a>
              <a href="/archive/writing">Writing archive</a>
              <a href="/archive">Full archive</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="theater-exit" aria-labelledby="theater-exit-heading">
      <p>The room stays open.</p>
      <h2 id="theater-exit-heading">Move back to the archive or out to the rest of the site.</h2>
      <div class="theater-exit__actions">
        <a href="/archive">Full archive</a>
        <a href="/map?view=unfurling">Map #2</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const items = Array.from(document.querySelectorAll('[data-theater-item]'));
      const panels = Array.from(document.querySelectorAll('[data-theater-panel]'));

      if (!items.length || !panels.length) {
        return;
      }

      const setActive = (slug, pushState) => {
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.dataset.entrySlug !== slug;
          panel.classList.toggle('is-active', panel.dataset.entrySlug === slug);
        });

        items.forEach((item) => {
          if (!(item instanceof HTMLButtonElement)) return;
          const isActive = item.dataset.entrySlug === slug;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-pressed', String(isActive));
        });

        if (pushState) {
          const url = new URL(window.location.href);
          url.searchParams.set('entry', slug);
          history.pushState({ entry: slug }, '', url);
        }
      };

      const initialSlug =
        new URL(window.location.href).searchParams.get('entry') ||
        items.find((item) => item instanceof HTMLButtonElement && item.classList.contains('is-active'))?.dataset.entrySlug ||
        items[0]?.dataset.entrySlug;

      if (initialSlug) {
        setActive(initialSlug, false);
      }

      items.forEach((item) => {
        if (!(item instanceof HTMLButtonElement)) return;
        item.addEventListener('click', () => {
          const slug = item.dataset.entrySlug;
          if (!slug) return;
          setActive(slug, true);
        });
      });

      window.addEventListener('popstate', () => {
        const slug = new URL(window.location.href).searchParams.get('entry');
        if (!slug) return;
        setActive(slug, false);
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(html body.theater-page[data-theme='archive']) {
    --tone-bg: #181110;
    --tone-bg-deep: #0d0909;
    --tone-surface: rgba(33, 24, 23, 0.9);
    --tone-surface-strong: rgba(20, 14, 14, 0.97);
    --tone-text: rgba(245, 236, 223, 0.96);
    --tone-muted: rgba(213, 195, 174, 0.76);
    --tone-line: rgba(235, 215, 189, 0.13);
    --line2: rgba(235, 215, 189, 0.1);
    --reading-plane: rgba(25, 18, 18, 0.9);
    --reading-plane-strong: rgba(16, 12, 12, 0.96);
    --reading-plane-line: rgba(235, 215, 189, 0.08);
    --reading-plane-shadow: 0 28px 78px rgba(0, 0, 0, 0.42);
    --theater-gold: var(--tone-accent-glow);
    --theater-cream: var(--tone-text);
    --theater-red: color-mix(in srgb, var(--tone-accent) 52%, #341715);
    --theater-red-soft: color-mix(in srgb, var(--tone-accent) 38%, rgba(36, 16, 18, 0.9));
    --theater-panel: color-mix(in srgb, var(--tone-surface) 94%, rgba(0, 0, 0, 0.22));
    --theater-border: color-mix(in srgb, var(--tone-line) 98%, rgba(255, 255, 255, 0.03));
    --theater-copy: var(--tone-muted);
    background:
      radial-gradient(60rem 34rem at 50% 8%, color-mix(in srgb, var(--tone-accent) 18%, transparent), transparent 58%),
      radial-gradient(42rem 28rem at 82% 12%, color-mix(in srgb, var(--tone-sky) 14%, transparent), transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--tone-bg-deep) 94%, black), var(--tone-bg) 48%, color-mix(in srgb, var(--tone-bg) 90%, black));
    color: var(--tone-text);
  }

  :global(html body.theater-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(0, 0, 0, 0.22), transparent 26%),
      linear-gradient(to left, rgba(0, 0, 0, 0.22), transparent 26%),
      radial-gradient(64rem 34rem at 50% 4%, rgba(255, 214, 154, 0.06), transparent 54%),
      radial-gradient(52rem 28rem at 82% 12%, rgba(92, 58, 45, 0.12), transparent 66%),
      linear-gradient(180deg, rgba(10, 7, 8, 0.28), rgba(15, 10, 11, 0.18) 42%, rgba(10, 8, 10, 0.42));
  }

  :global(body.theater-page .site-content-stage::before) {
    border-color: color-mix(in srgb, var(--reading-plane-line) 94%, rgba(255, 255, 255, 0.03));
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--reading-plane) 94%, rgba(10, 12, 18, 0.08)),
        color-mix(in srgb, var(--reading-plane-strong) 98%, rgba(7, 9, 14, 0.08))
      );
    box-shadow: 0 24px 74px rgba(0, 0, 0, 0.24);
  }

  :global(.light body.theater-page .site-header) {
    background:
      linear-gradient(180deg, rgba(22, 16, 15, 0.95), rgba(18, 13, 13, 0.84)),
      linear-gradient(90deg, rgba(255, 214, 154, 0.05), transparent 24%, transparent 76%, rgba(143, 94, 71, 0.06));
    border-bottom-color: color-mix(in srgb, var(--tone-accent) 24%, rgba(255, 244, 223, 0.1));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  :global(.light body.theater-page .site-header .header-brand),
  :global(.light body.theater-page .site-header nav a) {
    color: var(--tone-text) !important;
  }

  :global(.light body.theater-page .site-header .header-link) {
    border-color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 24%, rgba(255, 244, 223, 0.1));
    background: linear-gradient(180deg, rgba(46, 33, 31, 0.88), rgba(27, 20, 19, 0.76));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.02);
    color: color-mix(in srgb, var(--tone-text) 84%, var(--link-accent, var(--tone-accent)) 16%);
  }

  :global(.light body.theater-page .site-header .header-link:hover),
  :global(.light body.theater-page .site-header .header-link:focus-visible),
  :global(.light body.theater-page .site-header .header-link[aria-current='page']) {
    border-color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 44%, rgba(255, 244, 223, 0.1));
    background: linear-gradient(180deg, rgba(56, 40, 37, 0.94), rgba(35, 25, 23, 0.82));
    color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 58%, var(--tone-text) 42%);
  }

  .theater-shell {
    position: relative;
    display: grid;
    gap: clamp(4rem, 7vw, 6rem);
    width: min(100%, var(--measure));
    margin-inline: auto;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .theater-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--tone-accent) 14%, transparent), transparent 34%),
      linear-gradient(90deg, rgba(0, 0, 0, 0.18) 0%, transparent 18%, transparent 82%, rgba(0, 0, 0, 0.18) 100%);
    opacity: 0.78;
  }

  .theater-hero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: calc(100svh - 5rem);
    padding:
      clamp(7rem, 14vw, 10rem)
      clamp(1.4rem, 4vw, 4rem)
      clamp(2.8rem, 7vw, 4.8rem);
    overflow: hidden;
    background:
      radial-gradient(42rem 22rem at 50% 68%, rgba(255, 214, 154, 0.08), transparent 54%),
      linear-gradient(180deg, rgba(8, 6, 7, 0.36), rgba(8, 6, 7, 0.14) 24%, rgba(8, 6, 7, 0.52) 100%);
  }

  .theater-hero::before,
  .theater-hero::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: min(22vw, 17rem);
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--tone-accent) 44%, #2d1814),
        color-mix(in srgb, var(--tone-bg-deep) 86%, #130d10)
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.035) 0,
        rgba(255, 255, 255, 0.035) 8px,
        rgba(0, 0, 0, 0.05) 8px,
        rgba(0, 0, 0, 0.05) 18px
      );
    box-shadow: inset -22px 0 34px rgba(0, 0, 0, 0.25);
    opacity: 0.94;
  }

  .theater-hero::before {
    left: 0;
    border-right: 1px solid rgba(255, 224, 190, 0.08);
  }

  .theater-hero::after {
    right: 0;
    transform: scaleX(-1);
    border-right: 1px solid rgba(255, 224, 190, 0.08);
  }

  .theater-hero__copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }

  .theater-hero__eyebrow,
  .theater-stage__eyebrow,
  .theater-rail__head p,
  .theater-screening__marquee p,
  .theater-exit p {
    margin: 0;
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(244, 230, 204, 0.62);
  }

  .theater-hero h1,
  .theater-stage__intro h2,
  .theater-screening__marquee h2,
  .theater-exit h2 {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 0.96;
    text-wrap: balance;
  }

  .theater-hero h1 {
    font-size: clamp(3.2rem, 8vw, 6.8rem);
  }

  .theater-hero__lede,
  .theater-stage__intro p,
  .theater-exit p {
    margin: 0;
    color: var(--theater-copy);
    line-height: 1.7;
  }

  .theater-hero__lede {
    max-width: 35rem;
    margin-inline: auto;
    font-size: 1rem;
  }

  .theater-hero__actions,
  .theater-exit__actions,
  .theater-panel__footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .theater-hero__actions,
  .theater-exit__actions {
    justify-content: center;
  }

  .theater-hero__actions a,
  .theater-exit__actions a,
  .theater-panel__footer a,
  .theater-rail__head a {
    color: var(--theater-cream);
    text-decoration: none;
  }

  .theater-hero__actions a,
  .theater-exit__actions a {
    border: 1px solid rgba(244, 230, 204, 0.16);
    border-radius: 999px;
    padding: 0.9rem 1.25rem;
    background: linear-gradient(180deg, rgba(45, 33, 31, 0.9), rgba(24, 18, 17, 0.82));
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .theater-hero__actions a:hover,
  .theater-exit__actions a:hover {
    transform: translateY(-2px);
    background: linear-gradient(180deg, rgba(58, 42, 39, 0.96), rgba(31, 23, 21, 0.88));
    border-color: rgba(244, 230, 204, 0.28);
  }

  .theater-stage,
  .theater-exit {
    padding-inline: clamp(1.1rem, 4vw, 3rem);
  }

  .theater-stage__intro,
  .theater-exit {
    display: grid;
    gap: 0.75rem;
    max-width: 48rem;
    margin: 0 auto clamp(1.4rem, 4vw, 2.25rem);
    text-align: center;
  }

  .theater-stage__intro h2,
  .theater-exit h2 {
    font-size: clamp(2rem, 4.2vw, 3.6rem);
  }

  .theater-room {
    display: grid;
    grid-template-columns: minmax(14rem, 0.58fr) minmax(0, 1.86fr) minmax(12rem, 0.48fr);
    gap: clamp(1rem, 2vw, 1.25rem);
    align-items: start;
  }

  .theater-rail {
    position: sticky;
    top: clamp(1rem, 4vw, 2.5rem);
    display: grid;
    gap: 1rem;
    align-content: start;
    max-height: calc(100svh - 6rem);
    padding: 1rem;
    overflow: auto;
    border: 1px solid var(--theater-border);
    border-radius: 1.5rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--theater-panel) 96%, rgba(255, 255, 255, 0.02)), color-mix(in srgb, var(--tone-surface-strong) 88%, rgba(7, 8, 10, 0.2)));
    box-shadow:
      0 18px 60px rgba(0, 0, 0, 0.26),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(14px);
  }

  .theater-rail__head,
  .theater-panel__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
  }

  .theater-picker {
    display: grid;
    gap: 0.8rem;
  }

  .theater-picker__item {
    display: grid;
    grid-template-columns: 6.8rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: center;
    width: 100%;
    padding: 0.72rem;
    border: 1px solid color-mix(in srgb, var(--tone-line) 88%, rgba(255, 255, 255, 0.03));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .theater-picker__item:hover,
  .theater-picker__item.is-active {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--theater-gold) 34%, var(--tone-line));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--theater-gold) 10%, rgba(255, 255, 255, 0.02)), rgba(255, 255, 255, 0.01)),
      color-mix(in srgb, var(--theater-gold) 12%, var(--tone-surface));
  }

  .theater-picker__item span {
    display: grid;
    gap: 0.25rem;
  }

  .theater-picker__item strong {
    font-size: 0.95rem;
    color: var(--theater-cream);
  }

  .theater-picker__item small {
    color: rgba(244, 230, 204, 0.56);
    line-height: 1.45;
  }

  .theater-picker__pill {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--tone-line) 88%, rgba(255, 255, 255, 0.03));
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(244, 230, 204, 0.74);
  }

  .theater-screening {
    display: grid;
    gap: 1.1rem;
    position: sticky;
    top: clamp(1rem, 4vw, 2.5rem);
    align-self: start;
  }

  .theater-screening__marquee {
    display: grid;
    gap: 0.4rem;
    align-items: end;
    padding-inline: 0.2rem;
  }

  .theater-screening__marquee h2 {
    font-size: clamp(1.8rem, 4vw, 3.2rem);
  }

  .theater-screening__marquee span {
    color: rgba(244, 230, 204, 0.62);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .theater-screen {
    position: relative;
    display: grid;
    min-height: min(76svh, 58rem);
    padding: clamp(1rem, 2vw, 1.35rem);
    border-radius: 1.8rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 14%, color-mix(in srgb, var(--tone-accent-glow) 18%, transparent), transparent 25%),
      linear-gradient(180deg, color-mix(in srgb, var(--tone-bg-deep) 78%, black), color-mix(in srgb, var(--tone-bg-deep) 96%, black));
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.04),
      0 24px 40px rgba(0, 0, 0, 0.35);
  }

  .theater-screen::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 12%, rgba(255, 220, 156, 0.15), transparent 30%),
      radial-gradient(circle at 50% 102%, rgba(94, 49, 38, 0.2), transparent 28%);
    opacity: 0.9;
