---
import EntryMediaBlock from '../components/EntryMediaBlock.astro';
import CrossRouteResume from '../components/CrossRouteResume.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';
import { formatLongArchiveUtcDate, formatShortArchiveUtcDate } from '../lib/date-formatting';
import type { ArchiveEntry } from '../lib/archive-entries';
import {
  ARCHIVE_MEDIUMS,
  getArchiveMediumHref,
  getEntryDisplayMedium,
  getEntryDisplaySource,
  getEntryDisplayStatus,
  getEntryHref,
  getEntryVoiceExcerpt,
  shouldShowEntryStatus,
  sortEntriesByDate
} from '../lib/archive-entries';
import { getAllEntries } from '../lib/site-collections';
import '../styles/pages/theater.css';

const archiveEntries = sortEntriesByDate(await getAllEntries());
const requestedSlug = Astro.url.searchParams.get('entry') ?? '';
const requestedEntry = archiveEntries.find((entry) => entry.slug === requestedSlug) ?? null;
const featuredEntries = ARCHIVE_MEDIUMS
  .map((medium) => archiveEntries.find((entry) => entry.data.medium === medium))
  .filter((entry): entry is ArchiveEntry => Boolean(entry));
const stageSeedEntries = [requestedEntry, ...featuredEntries, ...archiveEntries.slice(0, 6)].filter(
  (entry): entry is ArchiveEntry => Boolean(entry)
);
const stageEntries = Array.from(
  new Map(stageSeedEntries.map((entry) => [entry.slug, entry])).values()
).slice(0, requestedEntry ? 9 : 8);
const renderedPanels = await Promise.all(
  stageEntries.map(async (entry) => {
    const { Content } = await entry.render();
    return { entry, Content };
  })
);
const activeEntry = requestedEntry ?? null;
const activeEntryVoice = activeEntry ? getEntryVoiceExcerpt(activeEntry, 180) : '';
const theaterQuickStats = [
  { label: 'Queue', value: String(stageEntries.length) },
  { label: 'Medium lanes', value: String(featuredEntries.length) },
  { label: 'Total archive', value: String(archiveEntries.length) }
];
const theaterShelves = ARCHIVE_MEDIUMS
  .map((medium) => ({
    medium,
    label: getEntryDisplayMedium(medium),
    items: stageEntries.filter((entry) => entry.data.medium === medium).slice(0, 4)
  }))
  .filter((shelf) => shelf.items.length > 0);
---

<BaseLayout
  title="The Theater — A Path Toward Life"
  description={`An archive screening room for ${profile.name}'s entries.`}
  theme="archive"
  bodyClass="theater-page"
  fullBleed={true}
  ambientEffects={false}
>
  <main class="theater-shell">
    <section class="theater-hero">
      <div class="theater-hero__copy">
        <p class="theater-hero__eyebrow">Archive screening room</p>
        <div class="theater-hero__marquee">
          <span class="theater-hero__label">Now on screen</span>
          <div class="theater-hero__facts">
            <span data-theater-hero-medium>{activeEntry ? getEntryDisplayMedium(activeEntry.data.medium) : 'Archive'}</span>
            <span data-theater-hero-source>{activeEntry ? getEntryDisplaySource(activeEntry.data.source) : 'Ready'}</span>
            <span data-theater-hero-date>{activeEntry ? formatShortArchiveUtcDate(activeEntry.data.date) : 'No selection'}</span>
          </div>
        </div>
        <h1 data-theater-hero-title>{activeEntry ? activeEntry.data.title : 'Center stage for the archive.'}</h1>
        <p class="theater-hero__lede" data-theater-hero-summary>
          {activeEntry
            ? activeEntryVoice
            : 'Choose a record from the queue. The stage will load one entry at a time while the rest of the room stays quiet.'}
        </p>
        <ul class="theater-hero__stats" aria-label="Theater quick stats">
          {theaterQuickStats.map((stat) => (
            <li>
              <span>{stat.label}</span>
              <strong>{stat.value}</strong>
            </li>
          ))}
        </ul>
        <div class="theater-hero__actions">
          <a href="#stage">Enter the room</a>
          {activeEntry ? <a href={getEntryHref(activeEntry)} data-theater-hero-link>Open selected entry</a> : <a href="/archive" data-theater-hero-link>Browse archive</a>}
        </div>
      </div>
    </section>

    <section class="theater-stage" id="stage" aria-labelledby="theater-stage-heading">
      <div class="theater-stage__intro">
        <p class="theater-stage__eyebrow">Projection room</p>
        <h2 id="theater-stage-heading">A readable program rail, one dominant screen, and quiet notes at the edge.</h2>
      </div>

      <div class="theater-room">
        <aside class="theater-rail theater-rail--archive" aria-label="Archive queue">
          <div class="theater-rail__head">
            <p>Archive queue</p>
            <a href="/archive">All archive</a>
          </div>

          <div class="theater-picker theater-picker--archive">
            {renderedPanels.map(({ entry }) => {
              const entryVoice = getEntryVoiceExcerpt(entry, 150);
              return (
                <a
                  href={`?entry=${entry.slug}#stage`}
                  role="button"
                  class:list={['theater-picker__item', activeEntry && entry.slug === activeEntry.slug && 'is-active']}
                  data-theater-item
                  data-entry-slug={entry.slug}
                  data-entry-medium={getEntryDisplayMedium(entry.data.medium)}
                  data-entry-source={getEntryDisplaySource(entry.data.source)}
                  data-entry-status={shouldShowEntryStatus(entry.data.status) ? getEntryDisplayStatus(entry.data.status) : 'Published'}
                  data-entry-href={getEntryHref(entry)}
                  data-entry-title={entry.data.title}
                  data-entry-summary={entryVoice}
                  data-entry-date={formatShortArchiveUtcDate(entry.data.date)}
                  aria-pressed={activeEntry && entry.slug === activeEntry.slug ? 'true' : 'false'}
                  aria-controls={`theater-panel-${entry.slug}`}
                >
                  <span class="theater-picker__top">
                    <span class="theater-picker__pill">{getEntryDisplayMedium(entry.data.medium)}</span>
                    <small class="theater-picker__source">
                      {getEntryDisplaySource(entry.data.source)} · {formatShortArchiveUtcDate(entry.data.date)}
                    </small>
                  </span>
                  <span class="theater-picker__body">
                    <strong>{entry.data.title}</strong>
                    <small>{entryVoice}</small>
                  </span>
                </a>
              );
            })}
          </div>
        </aside>

        <div class="theater-screening">
          <div class="theater-screening__marquee">
            <p>Center stage</p>
            <div>
              <h2 data-theater-stage-heading>
                {activeEntry ? 'The real archive entry stays on the screen.' : 'Select a card to load the projection.'}
              </h2>
              <span data-theater-stage-copy>
                {activeEntry ? 'Click a record from the queue to change the projection.' : 'The screen stays empty until a record is chosen.'}
              </span>
            </div>
            <div class="theater-screening__controls" aria-label="Queue navigation">
              <button type="button" class="theater-screening__button" data-theater-prev>
                Previous in queue
              </button>
              <button type="button" class="theater-screening__button" data-theater-next>
                Next in queue
              </button>
            </div>
          </div>

          <div class="theater-screen" aria-live="polite">
            <article class:list={['theater-panel', 'theater-panel--empty']} data-theater-placeholder hidden={Boolean(activeEntry)}>
              <header class="theater-panel__header">
                <p class="theater-panel__meta">
                  <span>Archive</span>
                  <span>Theater</span>
                </p>
                <div class="theater-panel__heading">
                  <h3>Select a record to start the projection.</h3>
                </div>
                <p class="theater-panel__summary">
                  The queue is ready. Pick one card and the screen will load that single entry while everything else
                  stays out of the way.
                </p>
              </header>

              <footer class="theater-panel__footer">
                <a href="/archive">Open archive</a>
              </footer>
            </article>

            {renderedPanels.map(({ entry, Content }) => {
              const showStatus = shouldShowEntryStatus(entry.data.status);
              const isActive = Boolean(activeEntry && entry.slug === activeEntry.slug);
              const sameMedium = stageEntries.filter((candidate) => candidate.data.medium === entry.data.medium);
              const mediumIndex = sameMedium.findIndex((candidate) => candidate.slug === entry.slug);
              const previousInLane = mediumIndex > 0 ? sameMedium[mediumIndex - 1] : null;
              const nextInLane = mediumIndex >= 0 && mediumIndex < sameMedium.length - 1 ? sameMedium[mediumIndex + 1] : null;

              return (
                <article
                  id={`theater-panel-${entry.slug}`}
                  class:list={['theater-panel', isActive && 'is-active']}
                  data-theater-panel
                  data-entry-slug={entry.slug}
                  hidden={!isActive}
                >
                <header class="theater-panel__header">
                  <p class="theater-panel__meta">
                    <span>Archive</span>
                    <span>Theater</span>
                  </p>
                  <div class="theater-panel__heading">
                    <h3>{entry.data.title}</h3>
                    {showStatus ? <span class="theater-panel__status">{getEntryDisplayStatus(entry.data.status)}</span> : null}
                  </div>

                  <p class="theater-panel__summary">{getEntryVoiceExcerpt(entry, 180)}</p>

                  <div class="theater-panel__tags" aria-label="Entry tags">
                    {entry.data.tags.map((tag) => <span>#{tag}</span>)}
                  </div>
                </header>

                <div class="theater-panel__media">
                  <EntryMediaBlock entry={entry} compact={false} />
                </div>

                <section class="reading-prose theater-panel__body">
                  <Content />
                </section>

                <footer class="theater-panel__footer">
                  <a href={getEntryHref(entry)}>Open archive entry</a>
                  <a href={getArchiveMediumHref(entry.data.medium)}>
                    Browse {getEntryDisplayMedium(entry.data.medium).toLowerCase()}
                  </a>
                  {previousInLane && (
                    <a href={`?entry=${previousInLane.slug}#stage`}>
                      Previous in {getEntryDisplayMedium(entry.data.medium).toLowerCase()}
                    </a>
                  )}
                  {nextInLane && (
                    <a href={`?entry=${nextInLane.slug}#stage`}>
                      Next in {getEntryDisplayMedium(entry.data.medium).toLowerCase()}
                    </a>
                  )}
                </footer>
              </article>
              );
            })}
          </div>
        </div>

        <aside class="theater-rail theater-rail--notes" aria-label="House notes">
          <div class="theater-rail__head">
            <p>House notes</p>
            {activeEntry ? <a href={getEntryHref(activeEntry)} data-theater-notes-link>Open entry</a> : <a href="/archive" data-theater-notes-link>Open archive</a>}
          </div>

          <div class="theater-notes">
            <p class="theater-notes__eyebrow">Selected record</p>
            <h3 class="theater-notes__title" data-theater-notes-title>
              {activeEntry ? activeEntry.data.title : 'No entry selected'}
            </h3>

            <div class="theater-notes__stack">
              <div>
                <span>Primary medium</span>
                <strong data-theater-notes-medium>{activeEntry ? getEntryDisplayMedium(activeEntry.data.medium) : 'Archive'}</strong>
              </div>
              <div>
                <span>Source</span>
                <strong data-theater-notes-source>{activeEntry ? getEntryDisplaySource(activeEntry.data.source) : 'Waiting'}</strong>
              </div>
              <div>
                <span>Status</span>
                <strong data-theater-notes-status>
                  {activeEntry
                    ? shouldShowEntryStatus(activeEntry.data.status)
                      ? getEntryDisplayStatus(activeEntry.data.status)
                      : 'Published'
                    : 'No entry selected'}
                </strong>
              </div>
            </div>

            <div class="theater-notes__links">
              <a href="/archive/video">Video archive</a>
              <a href="/archive/music">Music archive</a>
              <a href="/archive/writing">Writing archive</a>
              <a href="/archive">Full archive</a>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <section class="theater-shelves" aria-labelledby="theater-shelves-heading">
      <header class="theater-shelves__head">
        <p class="theater-stage__eyebrow">Program shelves</p>
        <h2 id="theater-shelves-heading">Grouped runs for deliberate viewing</h2>
      </header>
      <div class="theater-shelves__grid">
        {theaterShelves.map((shelf) => (
          <article class="theater-shelf">
            <header>
              <h3>{shelf.label}</h3>
              <a href={getArchiveMediumHref(shelf.medium)}>Open lane archive</a>
            </header>
            <ol>
              {shelf.items.map((item) => (
                <li>
                  <a href={`?entry=${item.slug}#stage`}>{item.data.title}</a>
                  <span>{formatShortArchiveUtcDate(item.data.date)}</span>
                </li>
              ))}
            </ol>
          </article>
        ))}
      </div>
    </section>

    <section class="theater-resume-wrap" aria-label="Cross-route resume paths">
      <CrossRouteResume current="theater" className="theater-resume" heading="Resume your other lanes" />
    </section>

    <section class="theater-exit" aria-labelledby="theater-exit-heading">
      <p>The room stays open.</p>
      <h2 id="theater-exit-heading">Move back to the archive or out to the rest of the site.</h2>
      <div class="theater-exit__actions">
        <a href="/archive">Full archive</a>
        <a href="/map?view=unfurling">Maps</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const items = Array.from(document.querySelectorAll('[data-theater-item]'));
      const panels = Array.from(document.querySelectorAll('[data-theater-panel]'));
      const notesLink = document.querySelector('[data-theater-notes-link]');
      const notesTitle = document.querySelector('[data-theater-notes-title]');
      const notesMedium = document.querySelector('[data-theater-notes-medium]');
      const notesSource = document.querySelector('[data-theater-notes-source]');
      const notesStatus = document.querySelector('[data-theater-notes-status]');
      const heroLink = document.querySelector('[data-theater-hero-link]');
      const heroTitle = document.querySelector('[data-theater-hero-title]');
      const heroSummary = document.querySelector('[data-theater-hero-summary]');
      const heroMedium = document.querySelector('[data-theater-hero-medium]');
      const heroSource = document.querySelector('[data-theater-hero-source]');
      const heroDate = document.querySelector('[data-theater-hero-date]');
      const stageHeading = document.querySelector('[data-theater-stage-heading]');
      const stageCopy = document.querySelector('[data-theater-stage-copy]');
      const placeholder = document.querySelector('[data-theater-placeholder]');
      const stageSection = document.getElementById('stage');
      const previousButton = document.querySelector('[data-theater-prev]');
      const nextButton = document.querySelector('[data-theater-next]');
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const STORAGE_KEY = 'theater-last-entry-v1';
      const saveLastEntry = (slug) => {
        try {
          window.localStorage.setItem(STORAGE_KEY, slug);
        } catch {
          // Ignore storage write issues and keep theater functional.
        }
      };
      const readLastEntry = () => {
        try {
          return window.localStorage.getItem(STORAGE_KEY) || '';
        } catch {
          return '';
        }
      };
      const findSlug = (candidate) =>
        items.find((item) => item instanceof HTMLElement && item.dataset.entrySlug === candidate)?.dataset.entrySlug || null;
      const getIndexForSlug = (slug) =>
        items.findIndex((item) => item instanceof HTMLElement && item.dataset.entrySlug === slug);
      const updateQueueControls = (activeSlug) => {
        if (!(previousButton instanceof HTMLButtonElement) || !(nextButton instanceof HTMLButtonElement)) return;
        const activeIndex = activeSlug ? getIndexForSlug(activeSlug) : -1;
        if (activeIndex < 0) {
          previousButton.disabled = items.length === 0;
          nextButton.disabled = items.length === 0;
          return;
        }
        previousButton.disabled = activeIndex <= 0;
        nextButton.disabled = activeIndex >= items.length - 1;
      };
      const scrollStageIntoView = () => {
        if (!(stageSection instanceof HTMLElement)) return;
        stageSection.scrollIntoView({
          behavior: prefersReducedMotion ? 'auto' : 'smooth',
          block: 'start',
        });
      };
      const clearSelection = () => {
        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = true;
          panel.classList.remove('is-active');
        });

        items.forEach((item) => {
          if (!(item instanceof HTMLAnchorElement)) return;
          item.classList.remove('is-active');
          item.setAttribute('aria-pressed', 'false');
        });

        if (placeholder instanceof HTMLElement) {
          placeholder.hidden = false;
        }

        if (heroLink instanceof HTMLAnchorElement) {
          heroLink.href = '/archive';
          heroLink.textContent = 'Browse archive';
        }

        if (heroTitle instanceof HTMLElement) {
          heroTitle.textContent = 'Center stage for the archive.';
        }

        if (heroSummary instanceof HTMLElement) {
          heroSummary.textContent =
            'Choose a record from the queue. The stage will load one entry at a time while the rest of the room stays quiet.';
        }

        if (heroMedium instanceof HTMLElement) {
          heroMedium.textContent = 'Archive';
        }

        if (heroSource instanceof HTMLElement) {
          heroSource.textContent = 'Ready';
        }

        if (heroDate instanceof HTMLElement) {
          heroDate.textContent = 'No selection';
        }

        if (notesLink instanceof HTMLAnchorElement) {
          notesLink.href = '/archive';
          notesLink.textContent = 'Open archive';
        }

        if (notesTitle instanceof HTMLElement) {
          notesTitle.textContent = 'No entry selected';
        }

        if (notesMedium instanceof HTMLElement) {
          notesMedium.textContent = 'Archive';
        }

        if (notesSource instanceof HTMLElement) {
          notesSource.textContent = 'Waiting';
        }

        if (notesStatus instanceof HTMLElement) {
          notesStatus.textContent = 'No entry selected';
        }

        if (stageHeading instanceof HTMLElement) {
          stageHeading.textContent = 'Select a card to load the projection.';
        }

        if (stageCopy instanceof HTMLElement) {
          stageCopy.textContent = 'The screen stays empty until a record is chosen.';
        }

        updateQueueControls(null);
      };

      if (!items.length || !panels.length) {
        return;
      }

      const setActive = (slug, pushState, replaceState = false) => {
        const nextSlug = slug ? findSlug(slug) : null;

        if (!nextSlug) {
          clearSelection();
          if (pushState || replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.delete('entry');
            history[replaceState ? 'replaceState' : 'pushState']({ entry: null }, '', url);
          }
          return;
        }

        saveLastEntry(nextSlug);

        panels.forEach((panel) => {
          if (!(panel instanceof HTMLElement)) return;
          panel.hidden = panel.dataset.entrySlug !== nextSlug;
          panel.classList.toggle('is-active', panel.dataset.entrySlug === nextSlug);
        });

        items.forEach((item) => {
          if (!(item instanceof HTMLAnchorElement)) return;
          const isActive = item.dataset.entrySlug === nextSlug;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-pressed', String(isActive));

          if (isActive) {
            if (placeholder instanceof HTMLElement) {
              placeholder.hidden = true;
            }

            if (heroLink instanceof HTMLAnchorElement) {
              heroLink.href = item.dataset.entryHref || '/archive';
              heroLink.textContent = item.dataset.entryHref ? 'Open selected entry' : 'Browse archive';
            }

            if (heroTitle instanceof HTMLElement) {
              heroTitle.textContent = item.dataset.entryTitle || 'Center stage for the archive.';
            }

            if (heroSummary instanceof HTMLElement) {
              heroSummary.textContent =
                item.dataset.entrySummary ||
                'Choose a record from the queue. The stage holds the full archive entry while the rest of the room stays in support.';
            }

            if (heroMedium instanceof HTMLElement) {
              heroMedium.textContent = item.dataset.entryMedium || 'Archive';
            }

            if (heroSource instanceof HTMLElement) {
              heroSource.textContent = item.dataset.entrySource || 'Ready';
            }

            if (heroDate instanceof HTMLElement) {
              heroDate.textContent = item.dataset.entryDate || 'No selection';
            }

            if (stageHeading instanceof HTMLElement) {
              stageHeading.textContent = 'The real archive entry stays on the screen.';
            }

            if (stageCopy instanceof HTMLElement) {
              stageCopy.textContent = 'Click a record from the queue to change the projection.';
            }

            if (notesLink instanceof HTMLAnchorElement) {
              notesLink.href = item.dataset.entryHref || '/archive';
              notesLink.textContent = item.dataset.entryHref ? 'Open entry' : 'Open archive';
            }

            if (notesTitle instanceof HTMLElement) {
              notesTitle.textContent = item.dataset.entryTitle || 'No entry selected';
            }

            if (notesMedium instanceof HTMLElement) {
              notesMedium.textContent = item.dataset.entryMedium || 'Archive';
            }

            if (notesSource instanceof HTMLElement) {
              notesSource.textContent = item.dataset.entrySource || 'Waiting';
            }

            if (notesStatus instanceof HTMLElement) {
              notesStatus.textContent = item.dataset.entryStatus || 'No entry selected';
            }
          }
        });

        if (pushState) {
          const url = new URL(window.location.href);
          url.searchParams.set('entry', nextSlug);
          history.pushState({ entry: nextSlug }, '', url);
        } else if (replaceState) {
          const url = new URL(window.location.href);
          url.searchParams.set('entry', nextSlug);
          history.replaceState({ entry: nextSlug }, '', url);
        }

        updateQueueControls(nextSlug);
      };

      const requested = new URL(window.location.href).searchParams.get('entry');
      const initialSlug = findSlug(requested || '') || findSlug(readLastEntry()) || null;
      setActive(initialSlug, false, true);

      items.forEach((item) => {
        if (!(item instanceof HTMLAnchorElement)) return;
        item.addEventListener('click', (event) => {
          event.preventDefault();
          const slug = item.dataset.entrySlug;
          if (!slug) return;
          setActive(slug, true);
          scrollStageIntoView();
        });
      });

      window.addEventListener('popstate', () => {
        setActive(new URL(window.location.href).searchParams.get('entry'), false, true);
      });

      const stepQueue = (direction) => {
        const activeItem = items.find((item) => item instanceof HTMLElement && item.classList.contains('is-active'));
        const activeSlug = activeItem instanceof HTMLElement ? activeItem.dataset.entrySlug || '' : '';
        const activeIndex = activeSlug ? getIndexForSlug(activeSlug) : -1;
        let targetIndex = activeIndex + direction;
        if (activeIndex < 0) {
          targetIndex = direction >= 0 ? 0 : items.length - 1;
        }
        if (targetIndex < 0 || targetIndex >= items.length) return;
        const targetItem = items[targetIndex];
        if (!(targetItem instanceof HTMLElement)) return;
        const targetSlug = targetItem.dataset.entrySlug;
        if (!targetSlug) return;
        setActive(targetSlug, true);
        scrollStageIntoView();
      };

      if (previousButton instanceof HTMLButtonElement) {
        previousButton.addEventListener('click', () => stepQueue(-1));
      }
      if (nextButton instanceof HTMLButtonElement) {
        nextButton.addEventListener('click', () => stepQueue(1));
      }
    })();
  </script>
</BaseLayout>

