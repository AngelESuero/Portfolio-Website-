---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';
import youtubeData from '../data/youtube.json';
import { MUSIC_URLS, SOCIAL_URLS } from '../data/site-refs';

const spotifyVol4EmbedUrl = 'https://open.spotify.com/embed/playlist/1aeafuJB347VmKXu4jvaTO';
const soundcloudVol4Url = 'https://soundcloud.com/aesuero/sets/volume-4-angel-sueros-top-50';

type VideoFeature = {
  title: string;
  videoId: string;
  href: string;
  publishedAt: string;
  thumbnailUrl: string;
};

type AudioFeature = {
  title: string;
  source: string;
  href: string;
  linkLabel: string;
  note: string;
  presentation: 'embed' | 'handoff';
  embedUrl?: string;
  secondaryHref?: string;
  secondaryLabel?: string;
  handoffCopy?: string;
};

type ClipFeature = {
  title: string;
  kind: string;
  year: string;
  src: string;
  poster: string;
  note: string;
};

const recentVideos: VideoFeature[] = youtubeData.items.slice(0, 5).map((item) => ({
  title: item.title,
  videoId: item.videoId,
  href: item.url,
  publishedAt: new Date(item.publishedAt).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric'
  }),
  thumbnailUrl: item.thumbnailUrl
}));

const listeningRoom: AudioFeature[] = [
  {
    title: 'My First Beat Tape',
    source: 'Untitled',
    presentation: 'embed',
    embedUrl: MUSIC_URLS.untitledMyFirstBeatTape,
    href: '/archive/music/my-first-beat-tape',
    linkLabel: 'Open archive entry',
    secondaryHref: MUSIC_URLS.untitledMyFirstBeatTape,
    secondaryLabel: 'Listen on Untitled',
    note: 'The tape sitting closest to the room, ready to start the night.'
  },
  {
    title: 'Queries (The Beat Tape): Family... Love?',
    source: 'Untitled',
    presentation: 'handoff',
    href: '/archive/music/queries-the-beat-tape-family-love',
    linkLabel: 'Open archive entry',
    secondaryHref: MUSIC_URLS.untitledQueriesBeatTape,
    secondaryLabel: 'Listen on Untitled',
    note: 'Family and love held together as one long question.',
    handoffCopy: 'Untitled keeps this record off the in-room screen, so the archive entry and source link carry the handoff instead.'
  },
  {
    title: 'The Every Day Soundscape',
    source: 'Untitled',
    presentation: 'handoff',
    href: '/archive/music/the-every-day-soundscape',
    linkLabel: 'Open archive entry',
    secondaryHref: MUSIC_URLS.untitledEveryDaySoundscape,
    secondaryLabel: 'Listen on Untitled',
    note: 'An atmospheric lane for the quieter hours in the room.',
    handoffCopy: 'This listening lane opens more reliably through the archive and the original Untitled page than it does inside an iframe.'
  },
  {
    title: 'Now Listening (Vol 4)',
    source: 'Spotify',
    presentation: 'embed',
    embedUrl: spotifyVol4EmbedUrl,
    href: MUSIC_URLS.spotifyVol4,
    linkLabel: 'Open source',
    note: 'Current reference pressure and playlist motion.'
  },
  {
    title: 'Volume 4',
    source: 'SoundCloud',
    presentation: 'embed',
    embedUrl: `https://w.soundcloud.com/player/?url=${encodeURIComponent(soundcloudVol4Url)}&color=%23b97a2d&auto_play=false&hide_related=true&show_comments=false&show_user=true&show_reposts=false&show_teaser=false`,
    href: soundcloudVol4Url,
    linkLabel: 'Open source',
    note: 'A looser route through the same energy.'
  }
];

const projectorClips: ClipFeature[] = [
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/2CKfTl0scAf.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/2CKfTl0scAf-poster.png',
    note: 'A direct cut from the archive, kept loose and physical.'
  },
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/2ycBgc6PYPZ.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/2ycBgc6PYPZ-poster.png',
    note: 'Different frame, same pressure.'
  },
  {
    title: 'SCRAPS After Heartbreaks',
    year: '2023',
    kind: 'Music video clip',
    src: '/media/work/scraps/scraps-after-heartbreaks-musicvideo/7e3ZWjDFxaL.mp4',
    poster: '/images/work/scraps/scraps-after-heartbreaks-musicvideo/7e3ZWjDFxaL-poster.png',
    note: 'Another angle for the same emotional weather.'
  },
  {
    title: 'Death of My Feminine',
    year: '2022',
    kind: 'Demo clip',
    src: '/media/work/scraps/death-of-my-feminine-demos-2022/5MYgthfeSOc.mp4',
    poster: '/images/work/scraps/death-of-my-feminine-demos-2022/5MYgthfeSOc-poster.png',
    note: 'An earlier demo lane, kept close for mood and movement.'
  }
];

const boothTape = {
  title: 'SCRAPS AFTER HEARTBREAKS',
  source: 'Native audio',
  href: '/archive/music/scraps-after-heartbreaks',
  note: 'A direct playable file from the archive, left on in the booth.',
  src: 'https://pub-cc1abfe7e4f342ddb929a047f6d5b3f3.r2.dev/studio/music/2026-02-01/scraps-after-heartbreaks-3c977bc4.mp3',
  mime: 'audio/mpeg',
  duration: '2:11'
};

const defaultVideo = recentVideos[0];
const defaultFeatureSrc = `https://www.youtube-nocookie.com/embed/${defaultVideo?.videoId}?autoplay=0&rel=0&modestbranding=1`;
---

<BaseLayout
  title="The Theater - a_e.s_"
  description={`A screening-room presentation page for ${profile.name}'s music and YouTube archive.`}
  theme="archive"
  bodyClass="theater-page"
  fullBleed={true}
  ambientEffects={true}
>
  <main class="theater-shell">
    <section class="theater-hero">
      <div class="theater-hero__copy">
        <p class="theater-hero__eyebrow">Screening room</p>
        <h1>Walk into the room where the music and the videos stay on display.</h1>
        <p class="theater-hero__lede">
          A digital theater for the work: latest uploads on the screen, listening sessions on deck, and side reels
          glowing in the dark.
        </p>
        <div class="theater-hero__actions">
          <a href="#stage">Enter the room</a>
          <a href="#repertoire">Browse the repertoire</a>
        </div>
      </div>
    </section>

    <section class="theater-stage" id="stage" aria-labelledby="theater-stage-heading">
      <div class="theater-stage__intro">
        <p class="theater-stage__eyebrow">Center screen</p>
        <h2 id="theater-stage-heading">One room, two kinds of projection.</h2>
        <p>
          Pick a recent upload from the left wall or a listening lane from the right. The screen changes with the room.
        </p>
      </div>

      <div class="theater-room">
        <aside class="theater-rail theater-rail--videos" aria-label="Recent YouTube videos">
          <div class="theater-rail__head">
            <p>Now screening</p>
            <a href={SOCIAL_URLS.youtube} target="_blank" rel="noopener noreferrer">Full channel</a>
          </div>

          <div class="theater-picker">
            {recentVideos.map((video, index) => (
              <button
                type="button"
                class:list={['theater-picker__item', index === 0 && 'is-active']}
                data-theater-item
                data-mode="video"
                data-kicker="Now screening"
                data-type={`YouTube • ${video.publishedAt}`}
                data-title={video.title}
                data-note="Fresh from the channel and ready for the main screen."
                data-presentation="embed"
                data-src={`https://www.youtube-nocookie.com/embed/${video.videoId}?autoplay=0&rel=0&modestbranding=1`}
                data-href={video.href}
                data-link-label="Open on YouTube"
                data-secondary-href=""
                data-secondary-label=""
                data-handoff-copy=""
              >
                <img src={video.thumbnailUrl} alt="" loading="lazy" />
                <span>
                  <strong>{video.title}</strong>
                  <small>{video.publishedAt}</small>
                </span>
              </button>
            ))}
          </div>
        </aside>

        <div class="theater-screening">
          <div class="theater-screening__marquee">
            <p data-theater-kicker>Now screening</p>
            <div>
              <h3 data-theater-title>{defaultVideo?.title}</h3>
              <span data-theater-type>{`YouTube • ${defaultVideo?.publishedAt ?? ''}`}</span>
            </div>
          </div>

          <div class="theater-screen">
            <div class="theater-screen__frame">
              <iframe
                data-theater-iframe
                src={defaultFeatureSrc}
                title={defaultVideo?.title ?? 'Theater screen'}
                loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                allowFullScreen
                referrerpolicy="strict-origin-when-cross-origin"
              ></iframe>
              <div class="theater-screen__handoff" data-theater-handoff hidden>
                <p>Archive handoff</p>
                <h4 data-theater-handoff-title>Open this record from the archive.</h4>
                <p data-theater-handoff-copy>
                  This selection opens more reliably through the archive and source links than it does inside the room.
                </p>
              </div>
            </div>
          </div>

          <div class="theater-screening__foot">
            <p data-theater-note>Fresh from the channel and ready for the main screen.</p>
            <div class="theater-screening__actions">
              <a data-theater-link href={defaultVideo?.href} target="_blank" rel="noopener noreferrer">Open on YouTube</a>
              <a data-theater-secondary-link href="" hidden></a>
            </div>
          </div>
        </div>

        <aside class="theater-rail theater-rail--music" aria-label="Music selections">
          <div class="theater-rail__head">
            <p>On the speakers</p>
            <a href="/archive/music">Music archive</a>
          </div>

          <div class="theater-picker theater-picker--audio">
            {listeningRoom.map((item, index) => (
              <button
                type="button"
                class:list={['theater-picker__item', 'theater-picker__item--audio', index === 0 && 'is-priority']}
                data-theater-item
                data-mode="music"
                data-kicker="On the speakers"
                data-type={item.presentation === 'embed' ? `${item.source} embed` : `${item.source} archive handoff`}
                data-title={item.title}
                data-note={item.note}
                data-presentation={item.presentation}
                data-src={item.embedUrl ?? ''}
                data-href={item.href}
                data-link-label={item.linkLabel}
                data-secondary-href={item.secondaryHref ?? ''}
                data-secondary-label={item.secondaryLabel ?? ''}
                data-handoff-copy={item.handoffCopy ?? ''}
              >
                <span class="theater-picker__pill">{item.source}</span>
                <span>
                  <strong>{item.title}</strong>
                  <small>{item.note}</small>
                </span>
              </button>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="theater-reels" id="reels" aria-labelledby="theater-reels-heading">
      <div class="theater-section-head">
        <p>Side reels</p>
        <h2 id="theater-reels-heading">Native clips and booth audio, still close to the projector.</h2>
      </div>

      <div class="theater-reels__grid">
        <div class="theater-clip-grid">
          {projectorClips.map((clip) => (
            <article class="theater-clip">
              <div class="theater-clip__meta">
                <span>{clip.kind}</span>
                <span>{clip.year}</span>
              </div>
              <h3>{clip.title}</h3>
              <video controls preload="metadata" playsinline poster={clip.poster}>
                <source src={clip.src} type="video/mp4" />
              </video>
              <p>{clip.note}</p>
            </article>
          ))}
        </div>

        <article class="theater-booth">
          <p class="theater-booth__eyebrow">Projection booth</p>
          <h3>{boothTape.title}</h3>
          <p>{boothTape.note}</p>
          <audio controls preload="metadata">
            <source src={boothTape.src} type={boothTape.mime} />
          </audio>
          <div class="theater-booth__foot">
            <span>{boothTape.duration}</span>
            <a href={boothTape.href}>Open archive entry</a>
          </div>
        </article>
      </div>
    </section>

    <section class="theater-repertoire" id="repertoire" aria-labelledby="theater-repertoire-heading">
      <div class="theater-section-head">
        <p>Repertoire</p>
        <h2 id="theater-repertoire-heading">The posters on the wall and the listening routes underneath them.</h2>
      </div>

      <div class="theater-repertoire__grid">
        <div class="theater-posters">
          {recentVideos.map((video) => (
            <a class="theater-poster" href={video.href} target="_blank" rel="noopener noreferrer">
              <img src={video.thumbnailUrl} alt={video.title} loading="lazy" />
              <span>
                <strong>{video.title}</strong>
                <small>{video.publishedAt}</small>
              </span>
            </a>
          ))}
        </div>

        <div class="theater-listens">
          {listeningRoom.map((item) => (
            <article class="theater-listens__item">
              <div class="theater-listens__head">
                <p>{item.source}</p>
                <a href={item.href} {...(/^https?:\/\//i.test(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                  Open
                </a>
              </div>
              <h3>{item.title}</h3>
              {item.presentation === 'embed' && item.embedUrl ? (
                <iframe
                  src={item.embedUrl}
                  title={`${item.title} embed`}
                  loading="lazy"
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  allowFullScreen
                  frameborder="0"
                ></iframe>
              ) : (
                <div class="theater-listens__fallback">
                  <p>{item.handoffCopy ?? 'This piece opens more reliably through the archive and source link.'}</p>
                  <div class="theater-listens__actions">
                    <a href={item.href} {...(/^https?:\/\//i.test(item.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                      {item.linkLabel}
                    </a>
                    {item.secondaryHref && item.secondaryLabel ? (
                      <a href={item.secondaryHref} target="_blank" rel="noopener noreferrer">
                        {item.secondaryLabel}
                      </a>
                    ) : null}
                  </div>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="theater-exit" aria-labelledby="theater-exit-heading">
      <p>The room stays open.</p>
      <h2 id="theater-exit-heading">Move between the screen, the archive, and the channel without losing the mood.</h2>
      <div class="theater-exit__actions">
        <a href="/music">Music inspiration</a>
        <a href="/map?view=unfurling">Map #2</a>
        <a href={SOCIAL_URLS.youtube} target="_blank" rel="noopener noreferrer">YouTube channel</a>
      </div>
    </section>
  </main>

  <script is:inline>
    (() => {
      const items = Array.from(document.querySelectorAll('[data-theater-item]'));
      const frame = document.querySelector('[data-theater-iframe]');
      const handoff = document.querySelector('[data-theater-handoff]');
      const handoffTitle = document.querySelector('[data-theater-handoff-title]');
      const handoffCopy = document.querySelector('[data-theater-handoff-copy]');
      const title = document.querySelector('[data-theater-title]');
      const kicker = document.querySelector('[data-theater-kicker]');
      const type = document.querySelector('[data-theater-type]');
      const note = document.querySelector('[data-theater-note]');
      const link = document.querySelector('[data-theater-link]');
      const secondaryLink = document.querySelector('[data-theater-secondary-link]');

      if (
        !(frame instanceof HTMLIFrameElement) ||
        !(handoff instanceof HTMLElement) ||
        !(handoffTitle instanceof HTMLElement) ||
        !(handoffCopy instanceof HTMLElement) ||
        !(title instanceof HTMLElement) ||
        !(kicker instanceof HTMLElement) ||
        !(type instanceof HTMLElement) ||
        !(note instanceof HTMLElement) ||
        !(link instanceof HTMLAnchorElement) ||
        !(secondaryLink instanceof HTMLAnchorElement)
      ) {
        return;
      }

      const activate = (button) => {
        const src = button.getAttribute('data-src');
        const presentation = button.getAttribute('data-presentation') || 'embed';
        const nextTitle = button.getAttribute('data-title');
        const nextKicker = button.getAttribute('data-kicker');
        const nextType = button.getAttribute('data-type');
        const nextNote = button.getAttribute('data-note');
        const nextHref = button.getAttribute('data-href');
        const nextLabel = button.getAttribute('data-link-label');
        const nextSecondaryHref = button.getAttribute('data-secondary-href');
        const nextSecondaryLabel = button.getAttribute('data-secondary-label');
        const nextHandoffCopy = button.getAttribute('data-handoff-copy');

        if (!nextTitle || !nextKicker || !nextType || !nextNote || !nextHref || !nextLabel) {
          return;
        }

        if (presentation === 'embed' && src) {
          frame.hidden = false;
          frame.src = src;
          frame.title = nextTitle;
          handoff.hidden = true;
        } else {
          frame.hidden = true;
          frame.src = 'about:blank';
          frame.title = '';
          handoff.hidden = false;
          handoffTitle.textContent = nextTitle;
          handoffCopy.textContent =
            nextHandoffCopy || 'This piece opens more reliably through the archive and source links than it does inline.';
        }

        title.textContent = nextTitle;
        kicker.textContent = nextKicker;
        type.textContent = nextType;
        note.textContent = nextNote;
        link.href = nextHref;
        link.textContent = nextLabel;
        if (/^https?:\/\//i.test(nextHref)) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        } else {
          link.removeAttribute('target');
          link.removeAttribute('rel');
        }

        if (nextSecondaryHref && nextSecondaryLabel) {
          secondaryLink.hidden = false;
          secondaryLink.href = nextSecondaryHref;
          secondaryLink.textContent = nextSecondaryLabel;
          if (/^https?:\/\//i.test(nextSecondaryHref)) {
            secondaryLink.target = '_blank';
            secondaryLink.rel = 'noopener noreferrer';
          } else {
            secondaryLink.removeAttribute('target');
            secondaryLink.removeAttribute('rel');
          }
        } else {
          secondaryLink.hidden = true;
          secondaryLink.removeAttribute('href');
          secondaryLink.textContent = '';
          secondaryLink.removeAttribute('target');
          secondaryLink.removeAttribute('rel');
        }

        items.forEach((item) => item.classList.remove('is-active'));
        button.classList.add('is-active');
      };

      items.forEach((item) => {
        item.addEventListener('click', () => activate(item));
      });
    })();
  </script>
</BaseLayout>

<style>
  :global(html body.theater-page[data-theme='archive']) {
    --tone-bg: #181110;
    --tone-bg-deep: #0d0909;
    --tone-surface: rgba(33, 24, 23, 0.9);
    --tone-surface-strong: rgba(20, 14, 14, 0.97);
    --tone-text: rgba(245, 236, 223, 0.96);
    --tone-muted: rgba(213, 195, 174, 0.76);
    --tone-line: rgba(235, 215, 189, 0.13);
    --line2: rgba(235, 215, 189, 0.1);
    --reading-plane: rgba(25, 18, 18, 0.9);
    --reading-plane-strong: rgba(16, 12, 12, 0.96);
    --reading-plane-line: rgba(235, 215, 189, 0.08);
    --reading-plane-shadow: 0 28px 78px rgba(0, 0, 0, 0.42);
    --theater-gold: var(--tone-accent-glow);
    --theater-cream: var(--tone-text);
    --theater-red: color-mix(in srgb, var(--tone-accent) 52%, #341715);
    --theater-red-soft: color-mix(in srgb, var(--tone-accent) 38%, rgba(36, 16, 18, 0.9));
    --theater-panel: color-mix(in srgb, var(--tone-surface) 94%, rgba(0, 0, 0, 0.22));
    --theater-border: color-mix(in srgb, var(--tone-line) 98%, rgba(255,255,255,0.03));
    --theater-copy: var(--tone-muted);
    background:
      radial-gradient(60rem 34rem at 50% 8%, color-mix(in srgb, var(--tone-accent) 18%, transparent), transparent 58%),
      radial-gradient(42rem 28rem at 82% 12%, color-mix(in srgb, var(--tone-sky) 14%, transparent), transparent 68%),
      linear-gradient(180deg, color-mix(in srgb, var(--tone-bg-deep) 94%, black), var(--tone-bg) 48%, color-mix(in srgb, var(--tone-bg) 90%, black));
    color: var(--tone-text);
  }

  :global(html body.theater-page .site-overlay) {
    background:
      linear-gradient(to right, rgba(0, 0, 0, 0.22), transparent 26%),
      linear-gradient(to left, rgba(0, 0, 0, 0.22), transparent 26%),
      radial-gradient(64rem 34rem at 50% 4%, rgba(255, 214, 154, 0.06), transparent 54%),
      radial-gradient(52rem 28rem at 82% 12%, rgba(92, 58, 45, 0.12), transparent 66%),
      linear-gradient(180deg, rgba(10, 7, 8, 0.28), rgba(15, 10, 11, 0.18) 42%, rgba(10, 8, 10, 0.42));
  }

  :global(body.theater-page .site-content-stage::before) {
    border-color: color-mix(in srgb, var(--reading-plane-line) 94%, rgba(255,255,255,0.03));
    background:
      linear-gradient(
        180deg,
        color-mix(in srgb, var(--reading-plane) 94%, rgba(10, 12, 18, 0.08)),
        color-mix(in srgb, var(--reading-plane-strong) 98%, rgba(7, 9, 14, 0.08))
      );
    box-shadow: 0 24px 74px rgba(0, 0, 0, 0.24);
  }

  :global(.light body.theater-page .site-header) {
    background:
      linear-gradient(180deg, rgba(22, 16, 15, 0.95), rgba(18, 13, 13, 0.84)),
      linear-gradient(90deg, rgba(255, 214, 154, 0.05), transparent 24%, transparent 76%, rgba(143, 94, 71, 0.06));
    border-bottom-color: color-mix(in srgb, var(--tone-accent) 24%, rgba(255, 244, 223, 0.1));
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.3);
  }

  :global(.light body.theater-page .site-header .header-brand),
  :global(.light body.theater-page .site-header nav a) {
    color: var(--tone-text) !important;
  }

  :global(.light body.theater-page .site-header .header-link) {
    border-color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 24%, rgba(255, 244, 223, 0.1));
    background:
      linear-gradient(180deg, rgba(46, 33, 31, 0.88), rgba(27, 20, 19, 0.76));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 0 0 1px rgba(255, 255, 255, 0.02);
    color: color-mix(in srgb, var(--tone-text) 84%, var(--link-accent, var(--tone-accent)) 16%);
  }

  :global(.light body.theater-page .site-header .header-link:hover),
  :global(.light body.theater-page .site-header .header-link:focus-visible),
  :global(.light body.theater-page .site-header .header-link[aria-current='page']) {
    border-color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 44%, rgba(255, 244, 223, 0.1));
    background:
      linear-gradient(180deg, rgba(56, 40, 37, 0.94), rgba(35, 25, 23, 0.82));
    color: color-mix(in srgb, var(--link-accent, var(--tone-accent)) 58%, var(--tone-text) 42%);
  }

  .theater-shell {
    position: relative;
    display: grid;
    gap: clamp(4rem, 7vw, 7rem);
    width: min(100%, var(--measure));
    margin-inline: auto;
    padding-bottom: clamp(4rem, 8vw, 7rem);
  }

  .theater-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
