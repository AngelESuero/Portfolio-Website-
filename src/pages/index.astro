---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeTimeline from '../components/LifeTimeline';
import profile from '../data/profile';
import '../styles/homepage.css';
import {
  aiPledgeCommitments,
  geometricPortraits,
  heroActions,
  homeRoutes,
  timelinePreview,
} from '../data/homepage';

const heroFacts = [
  { label: 'Base', value: profile.location },
  { label: 'Practice', value: profile.roles.join(' / ') },
  { label: 'Mode', value: profile.mottos[0] },
] as const;
---

<BaseLayout
  title="Angel Suero | A Path Toward Life"
  description={profile.short_bio}
  theme="archive"
  forceThemeMode="dark"
  bodyClass="home-page"
  flatSurface={true}
  showHeader={true}
  ambientEffects={false}
  fullBleed={true}
>
  <div class="home-shell">
    <section class="home-hero" aria-labelledby="home-hero-heading">
      <div class="home-hero__copy">
        <p class="home-hero__eyebrow">aes's path toward life</p>
        <h1 id="home-hero-heading" class="home-hero__title">Angel Suero</h1>
        <p class="home-hero__lede home-read-cue">
          Music production, visual storytelling, and Newark-rooted community work in one frame.
        </p>

        <div class="home-hero__actions" aria-label="Primary routes">
          {heroActions.map((action, index) => (
            <a
              href={action.href}
              class={`home-hero__action${index === 0 ? ' home-hero__action--primary' : ''}`}
            >
              {action.label}
            </a>
          ))}
        </div>

        <dl class="home-hero__facts" aria-label="Quick context">
          {heroFacts.map((fact) => (
            <div class="home-hero__fact">
              <dt class="home-hero__fact-label">{fact.label}</dt>
              <dd class="home-hero__fact-value">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="home-hero__figure">
        <img
          class="home-hero__image"
          src="/images/timeline-preview/download-7.jpg"
          alt="Angel Suero smiling against a neutral wall"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="home-hero__figure-caption">
          <span class="home-hero__figure-kicker">Present tense archive</span>
          <span class="home-hero__figure-copy home-read-cue home-read-cue--inline">A portrait of the archive, still in motion.</span>
        </figcaption>

        <div class="home-hero__collage" aria-label="Geometric portrait collage">
          <p class="home-hero__collage-label">Visual language</p>
          <ul class="home-hero__collage-grid" role="list">
            {geometricPortraits.map((portrait, index) => (
              <li class={`home-portrait-card home-portrait-card--${portrait.shape}`}>
                <figure class="home-portrait-card__figure">
                  <img
                    src={portrait.src}
                    alt={portrait.alt}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="home-portrait-card__image"
                    style={`--portrait-focus:${portrait.focus};`}
                  />
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </figure>
    </section>

    <section class="home-timeline" aria-labelledby="home-timeline-heading" id="home-timeline">
      <details class="home-timeline__details">
        <summary class="home-timeline__summary">
          <div class="home-timeline__summaryCopy">
            <p class="home-timeline__kicker">Life timeline</p>
            <h2 id="home-timeline-heading" class="home-timeline__title">
              Open an era. See what came out of it.
            </h2>
            <p class="home-timeline__lede home-read-cue">
              A compact view first. Expand for the full sequence, context, and branches.
            </p>
          </div>

          <div class="home-timeline__summaryMeta">
            <div class="home-timeline__chips" aria-hidden="true">
              {timelinePreview.map((item) => (
                <span class="home-timeline__chip">
                  <span class="home-timeline__chipLabel">{item.label}</span>
                  <span class="home-timeline__chipValue">{item.value}</span>
                </span>
              ))}
            </div>
            <span class="home-timeline__summaryAction" aria-hidden="true">
              <span class="home-timeline__summaryActionLabel home-timeline__summaryActionLabel--open">
                Expand timeline →
              </span>
              <span class="home-timeline__summaryActionLabel home-timeline__summaryActionLabel--close">
                Collapse timeline ←
              </span>
            </span>
          </div>
        </summary>

        <div class="home-timeline__body">
          <LifeTimeline layout="fullBleed" />
        </div>
      </details>
    </section>

    <div class="home-content">
      <section class="home-routes" aria-labelledby="home-routes-heading">
        <div class="home-section-head">
          <div class="home-section-head__stack">
            <p class="home-section-head__kicker">Site index</p>
            <h2 id="home-routes-heading" class="home-section-head__title">
              Full route rail.
            </h2>
          </div>
          <p class="home-section-head__aside home-read-cue home-read-cue--inline">Every major room is listed as its own card.</p>
        </div>

        <div class="home-route-model" aria-label="How to read route cards">
          <p class="home-route-model__label">Card model</p>
          <div class="home-route-model__grid">
            <div class="home-route-model__preview" role="img" aria-label="Sample card with labeled parts">
              <span class="home-route-model__pin home-route-model__pin--meta">A</span>
              <span class="home-route-model__pin home-route-model__pin--title">B</span>
              <span class="home-route-model__pin home-route-model__pin--desc">C</span>
              <span class="home-route-model__pin home-route-model__pin--cta">D</span>

              <div class="home-route-model__meta">
                <span class="home-route__group">Research & AI</span>
                <span class="home-route__platform">YouTube</span>
              </div>
              <p class="home-route-model__title">AI</p>
              <p class="home-route-model__desc">
                Applied AI work, notes, and public experiments.
              </p>
              <p class="home-route-model__cta">Open →</p>
            </div>

            <ul class="home-route-model__keys" role="list">
              <li>
                <span class="home-route-model__key-dot">A</span>
                Tags = room group + platform cue
              </li>
              <li>
                <span class="home-route-model__key-dot">B</span>
                Title = the room name
              </li>
              <li>
                <span class="home-route-model__key-dot">C</span>
                Description = what to expect before opening
              </li>
              <li>
                <span class="home-route-model__key-dot">D</span>
                Open = direct route into that room
              </li>
            </ul>
          </div>
        </div>

        <ul class="home-routes__list" role="list">
          {homeRoutes.map((route) => (
            <li class="home-route__item">
              <a class="home-route" href={route.href}>
                <span class="home-route__meta">
                  <span class="home-route__group">{route.group}</span>
                  {route.cue ? <span class="home-route__platform">{route.cue}</span> : null}
                </span>
                <span class="home-route__title">{route.title}</span>
                <span class="home-route__description home-read-cue">{route.description}</span>
                <span class="home-route__arrow" aria-hidden="true">Open →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-pledge" aria-labelledby="home-pledge-heading">
        <div class="home-pledge__inner">
          <div class="home-pledge__lead">
            <p class="home-pledge__kicker">Commitment</p>
            <h2 id="home-pledge-heading" class="home-pledge__title">
              AI Accountability Pledge
            </h2>
            <p class="home-pledge__lede home-read-cue">
              Transparent use. Human judgment. Labor dignity. Environmental honesty.
            </p>
            <a class="home-pledge__action" href="/ai-accountability-pledge">
              Read the full pledge
            </a>
          </div>

          <div class="home-pledge__proof">
            <blockquote class="home-pledge__quote">
              AI is a tool, not a replacement for responsibility.
            </blockquote>

            <ol class="home-pledge__list" role="list">
              {aiPledgeCommitments.map((commitment, index) => (
                <li class="home-pledge__item">
                  <span class="home-pledge__item-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="home-pledge__item-text home-read-cue">{commitment}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
