---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';
import { SURVIVAL_OS } from '../data/survival-os';
import { getCollection } from 'astro:content';
import agiTimeline from '../data/agi-curated-timeline.json';

const allEntries = await getCollection('entries');
const allProjects = await getCollection('projects');
const sortedProjects = [...allProjects].sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const featuredProjects = sortedProjects.slice(0, 3);

const entryCountByMedium = allEntries.reduce<Record<string, number>>((acc, e) => {
  const m = e.data.medium;
  acc[m] = (acc[m] || 0) + 1;
  return acc;
}, {});

const archiveStats = [
  { label: 'music', count: entryCountByMedium['music'] || 0, href: '/archive/music' },
  { label: 'video', count: entryCountByMedium['video'] || 0, href: '/archive/video' },
  { label: 'writing', count: entryCountByMedium['writing'] || 0, href: '/archive/writing' },
];
const totalEntries = allEntries.length;
const totalProjects = allProjects.length;

// 3 most recent entries for the recent feed
const recentEntries = [...allEntries]
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);

// 3 most recent writing entries to display on home page
const recentWriting = [...allEntries]
  .filter(e => e.data.medium === 'writing')
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 2);

const mediumIcon: Record<string, string> = { music: '♪', video: '▶', writing: '✦', image: '◈', note: '◦', proposal: '⬡' };

// 3 most recent AGI signals — sorted by wave descending, then year descending
type AgiItem = { id: string; headline: string; wave: string; year?: number; timingLabel: string; public: { summary: string; implication: string }; kind: string };
const agiWaveOrder = new Map(
  (Array.isArray((agiTimeline as any).waves) ? (agiTimeline as any).waves : [])
    .map((wave: any, index: number) => [String(wave.id || index), index])
);
const recentSignals = [...(agiTimeline.items as AgiItem[])]
  .sort((a, b) => {
    const waveDelta = (agiWaveOrder.get(String(b.wave || '')) ?? 0) - (agiWaveOrder.get(String(a.wave || '')) ?? 0);
    if (waveDelta !== 0) return waveDelta;
    return Number(b.year ?? 0) - Number(a.year ?? 0);
  })
  .slice(0, 2);

const waveLabels: Record<string, string> = {
  software_disruption_now: 'Wave 1 · Software',
  broad_labor_stress: 'Wave 2 · Labor',
  physical_economy_disruption: 'Wave 3 · Physical',
  scenario_territory: 'Wave 4 · Scenario',
};

const compactText = (value: string | null | undefined, maxLength = 88): string => {
  if (!value) return '';

  const normalized = String(value).replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLength) return normalized;

  const sentenceEnd = normalized.indexOf('. ');
  const firstSentence = sentenceEnd > 0 ? normalized.slice(0, sentenceEnd + 1).trim() : normalized;
  if (firstSentence.length <= maxLength) return firstSentence;

  const clipped = firstSentence.slice(0, maxLength).replace(/\s+\S*$/, '').trimEnd();
  return `${clipped}…`;
};

const agiUpdatedAt = '2026-03-06';
const agiWaveCount = 4;

const sortedEntries = [...allEntries].sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const latestMusic = sortedEntries.find(e => e.data.medium === 'music');
const latestWriting = sortedEntries.find(e => e.data.medium === 'writing');
const latestProject = featuredProjects[0];
const latestAgi = (agiTimeline.items as AgiItem[])[0];

const encodeSrc = (value: string) => encodeURI(value);

const homePhotos = [
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Creativity_ soundscape visual media/2019-11-18 17 12 14 - Angel - DSC00768.jpeg',
    alt: 'Theatre performance scene',
    label: 'Performance',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Creativity_ Cover Art/24515F9A-5B7C-4285-AD0B-553F994827C3.png',
    alt: 'Blue brain cover art',
    label: 'Cover art',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Google Photos/Well-Being_ Angel/RenderedImage.jpg',
    alt: 'Portrait on a pink background',
    label: 'Portrait',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Instagram Posts(1)/38fim6df1f4.jpg',
    alt: 'DIGGING archive still',
    label: 'Archive still',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/download-2.png',
    alt: 'Snowy street scene',
    label: 'Snow',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Google Photos/Well-Being_ Angel/IMG_0839.JPG',
    alt: 'Group shot with balloons',
    label: 'Community',
  },
  {
    src: '/images/work/art-of-survival/codex-photos/Google Photos/Creativity_ soundscape visual media/IMG_7707.JPG',
    alt: 'Cathedral mural interior',
    label: 'Interior',
  },
  {
    src: '/images/work/art-of-survival/isolation.jpg',
    alt: 'The Art of Survival cover',
    label: 'Survival',
  },
  {
    src: '/images/scraps-cover.png',
    alt: 'Scraps cover art',
    label: 'Scraps',
  },
  {
    src: '/images/nmoa-logo.png',
    alt: 'Museum AV logo',
    label: 'AV',
  },
];

const carouselPhotos = [...homePhotos.slice(0, 8), ...homePhotos.slice(0, 8)];
const backdropPhotos = [
  { ...homePhotos[0], className: 'hi-backdrop__photo--theatre' },
  { ...homePhotos[1], className: 'hi-backdrop__photo--brain' },
  { ...homePhotos[2], className: 'hi-backdrop__photo--portrait' },
  { ...homePhotos[4], className: 'hi-backdrop__photo--snow' },
  { ...homePhotos[5], className: 'hi-backdrop__photo--community' },
];

const offerings = [
  { num: '01', label: 'Work',        desc: latestProject?.data.title ?? 'Projects',               href: '/work' },
  { num: '02', label: 'Sound',       desc: latestMusic?.data.title ?? 'Music archive',            href: '/archive/music' },
  { num: '03', label: 'Writing',     desc: latestWriting?.data.title ?? 'Essays & criticism',     href: '/writing' },
  { num: '04', label: 'AI',          desc: latestAgi?.headline ?? 'AGI tracking',                 href: '/ai' },
  { num: '05', label: 'Survival OS', desc: SURVIVAL_OS.framing.keepAlive,                         href: '/survival-os' },
  { num: '06', label: 'Contact',     desc: 'Reach, collaborate, or correspond.',                  href: '/contact' },
];
const papers = [
  {
    title: 'Acquiring American Happiness in the 21st Century',
    href: '/archive/writing/acquiring-american-happiness-in-the-21st-century',
    tags: ['culture', 'economics', 'well-being'],
  },
  {
    title: 'The Sacrifice of Power: An Analysis of Citizens under Capitalism',
    href: '/archive/writing/the-sacrifice-of-power',
    tags: ['political economy', 'power', 'capitalism'],
  },
  {
    title: 'Following Sound',
    href: '/archive/writing/following-sound',
    tags: ['music', 'field work', 'sound studies'],
  },
  {
    title: 'The Impact of Musical Instruments on Museum Visitation',
    href: '/archive/writing/impact-of-musical-instruments-on-museum-visitation',
    tags: ['museums', 'music', 'community'],
  },
];

const elsewhereCards = [
  {
    href: '/elsewhere',
    label: 'Tinker Space',
    description: 'Experiments, drafts, and open labs'
  },
  {
    href: '/survival-support',
    label: 'Survival Support',
    description: 'Practical support planning and triage'
  },
  {
    href: '/ai-accountability-pledge',
    label: 'AI Accountability Pledge',
    description: 'The commitment, civic and measurable'
  }
];

---

<BaseLayout
  title="A Path Toward Life - Portfolio"
  description={profile.short_bio}
  theme="archive"
  bodyClass="home-page"
>
  <div class="hi-home">
    <div class="hi-backdrop" aria-hidden="true">
      {backdropPhotos.map((photo) => (
        <img
          class={`hi-backdrop__photo ${photo.className}`}
          src={encodeSrc(photo.src)}
          alt=""
          loading="lazy"
          decoding="async"
        />
      ))}
    </div>

    <!-- ── Hero ──────────────────────────────────── -->
    <header class="hi-hero">
      <div class="hi-hero__text">
        <h1 class="hi-name" style="word-spacing:-0.05em">A<span style="font-size:0.2em;vertical-align:-0.6em;letter-spacing:0.03em;opacity:0.75;margin-left:0.1em;margin-right:0.3em">es's</span>Path Toward Life</h1>
        <p class="hi-lede">Music, images, writing, and civic work from Newark.</p>
      </div>
    </header>

    <div class="hi-photos" aria-hidden="true">
      <div class="hi-photos__track">
        {carouselPhotos.map((photo) => (
          <div class="hi-photo" style={`background-image:url('${encodeSrc(photo.src)}')`}></div>
        ))}
      </div>
    </div>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── Work ──────────────────────────────────── -->
    <section class="hi-section" aria-labelledby="hi-work-heading">
      <div class="hi-section__head">
        <p class="hi-kicker">Work</p>
        <a href="/work" class="hi-section__aside">All projects →</a>
      </div>
      <h2 id="hi-work-heading" class="hi-section__title">What I'm making</h2>
      <ul class="hi-rows" role="list">
        {featuredProjects.map((project) => (
          <li>
            <a class="hi-row hi-row--work" href={`/work/${project.slug}`}>
              <span class="hi-row__icon" aria-hidden="true">▸</span>
              <span class="hi-row__title">{project.data.title}</span>
              <span class="hi-row__meta">{project.data.type} · {project.data.year}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── Writing ────────────────────────────────── -->
    <section class="hi-section" aria-labelledby="hi-writing-heading">
      <div class="hi-section__head">
        <p class="hi-kicker">Writing</p>
        <a href="/writing" class="hi-section__aside">All writing →</a>
      </div>
      <h2 id="hi-writing-heading" class="hi-section__title">What I'm writing</h2>
      <ul class="hi-writing-list" role="list">
        {recentWriting.map((entry) => (
          <li class="hi-writing-item">
            <a href={`/archive/writing/${entry.slug.split('/').pop()}`} class="hi-writing-link">
              <span class="hi-writing-title">{entry.data.title}</span>
              {entry.data.summary && <span class="hi-writing-summary">{compactText(entry.data.summary, 72)}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── Archive ───────────────────────────────── -->
    <section class="hi-section" aria-labelledby="hi-archive-heading">
      <div class="hi-section__head">
        <p class="hi-kicker">Archive</p>
        <a href="/archive" class="hi-section__aside">All {totalEntries} entries →</a>
      </div>
      <h2 id="hi-archive-heading" class="hi-section__title">Archive</h2>
      <div class="hi-stats" aria-label="Archive at a glance" style="margin-bottom: 1.2rem;">
        <span class="hi-stats__label" style="margin-right: 0.6rem;">By medium</span>
        {archiveStats.map((s) => (
          <a href={s.href} class="hi-stats__pill">
            <strong>{s.count}</strong> {s.label}
          </a>
        ))}
      </div>
      <ul class="hi-rows" role="list">
        {recentEntries.map((entry) => (
          <li>
            <a class="hi-row" href={`/archive/${entry.data.medium}/${entry.slug.split('/').pop()}`}>
              <span class="hi-row__icon">{mediumIcon[entry.data.medium] ?? '·'}</span>
              <span class="hi-row__medium">{entry.data.medium}</span>
              <span class="hi-row__title">{entry.data.title}</span>
              <span class="hi-row__date">{new Date(entry.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── AGI signals ────────────────────────────── -->
    <section class="hi-section" aria-labelledby="hi-signals-heading">
      <div class="hi-section__head">
        <p class="hi-kicker">AGI Monitor</p>
        <a href="/agi" class="hi-section__aside">Full timeline →</a>
      </div>
      <h2 id="hi-signals-heading" class="hi-section__title">Signals</h2>
      <ul class="hi-signals" role="list">
        {recentSignals.map((item) => (
          <li class="hi-signal">
            <div class="hi-signal__meta">
              <span class="hi-signal__wave">{waveLabels[item.wave] ?? item.wave}</span>
              <span aria-hidden="true">·</span>
              <span class="hi-signal__timing">{item.timingLabel}</span>
            </div>
            <p class="hi-signal__hed">{item.headline}</p>
            <p class="hi-signal__imp">{compactText(item.public.summary, 80)}</p>
          </li>
        ))}
      </ul>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── Papers ─────────────────────────────────── -->
    <section class="hi-section" aria-labelledby="hi-papers-heading">
      <div class="hi-section__head">
        <p class="hi-kicker">Papers</p>
      </div>
      <h2 id="hi-papers-heading" class="hi-section__title">Papers</h2>
      <ul class="hi-rows" role="list">
        {papers.map((paper) => (
          <li>
            <a class="hi-row hi-row--paper" href={paper.href} target="_blank" rel="noopener noreferrer">
              <span class="hi-row__icon" aria-hidden="true">⬡</span>
              <span class="hi-row__title">{paper.title}</span>
              <span class="hi-row__tags">{paper.tags.join(' · ')}</span>
              <span class="hi-row__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <!-- ── Sound + Elsewhere ──────────────────────── -->
    <footer class="hi-footer">
      <div class="hi-footer__col">
        <p class="hi-kicker">Sound</p>
        <p class="hi-footer__copy">{entryCountByMedium['music'] || 0} music entries, from beat tapes to sound studies.</p>
        <div class="hi-footer__links">
          <a href="/archive/music" class="hi-footer__link">Music archive →</a>
          <button class="hi-footer__link" onclick="document.querySelector('[data-music-bar-toggle]')?.click()" type="button">Open player ♪</button>
        </div>
      </div>
      <div class="hi-footer__col">
        <p class="hi-kicker">Elsewhere</p>
        <ul class="hi-elsewhere" role="list">
          {elsewhereCards.map((card) => (
            <li>
              <a href={card.href} class="hi-elsewhere__link">
                {card.label} <span aria-hidden="true">→</span>
              </a>
              <span class="hi-elsewhere__desc">{card.description}</span>
            </li>
          ))}
        </ul>
      </div>
    </footer>

  </div>
</BaseLayout>

<style>
  /* ── Photo carousel ──────────────────────────── */
  .hi-photos {
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow: hidden;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    transition: width 0.6s cubic-bezier(0.4,0,0.2,1),
                margin-left 0.6s cubic-bezier(0.4,0,0.2,1),
                border-radius 0.6s ease;
  }

  .hi-photos.is-contained {
    width: 100%;
    margin-left: 0;
    border-radius: 0.75rem;
  }

  .hi-photos__track {
    display: flex;
    gap: 0.75rem;
    width: max-content;
    animation: hi-photos-scroll 36s linear infinite;
  }

  .hi-photos__track:hover {
    animation-play-state: paused;
  }

  @keyframes hi-photos-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .hi-photo {
    flex-shrink: 0;
    width: clamp(180px, 22vw, 300px);
    aspect-ratio: 4/3;
    background-size: cover;
    background-position: center;
    border-radius: 0.5rem;
    opacity: 0.28;
    filter: saturate(0.5) brightness(0.8);
    transition: opacity 300ms ease, filter 300ms ease;
  }

  .hi-photos__track:hover .hi-photo { opacity: 0.12; filter: saturate(0.3) brightness(0.7); }
  .hi-photo:hover { opacity: 0.55 !important; filter: saturate(0.7) brightness(0.9) !important; animation-play-state: paused; }

  /* ── Layout shell ───────────────────────────── */
  .hi-home {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(2.5rem, 5vw, 4rem) clamp(1.25rem, 4vw, 2rem) clamp(4rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    gap: 0;
    position: relative;
    isolation: isolate;
    overflow: visible;
  }

  .hi-home > :not(.hi-backdrop) {
    position: relative;
    z-index: 1;
  }

  .hi-rule {
    height: 1px;
    margin: clamp(2rem, 4vw, 3rem) 0;
    width: min(100%, 760px);
    margin-inline: auto;
    background: color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
  }

  .hi-backdrop {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
    z-index: 0;
  }

  .hi-backdrop__photo {
    position: absolute;
    width: min(280px, 28vw);
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1.1rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 5%, transparent);
    box-shadow:
      0 18px 44px rgba(0, 0, 0, 0.05),
      0 1px 0 rgba(255, 255, 255, 0.14) inset;
    opacity: 0.08;
    filter: saturate(0.62) contrast(0.94) brightness(0.97);
  }

  .hi-backdrop__photo--theatre {
    top: -1.25rem;
    right: -6rem;
    width: min(300px, 28vw);
    transform: rotate(4deg);
  }

  .hi-backdrop__photo--brain {
    top: 9rem;
    left: -6rem;
    width: min(220px, 20vw);
    transform: rotate(-8deg);
    opacity: 0.06;
  }

  .hi-backdrop__photo--portrait {
    top: 24rem;
    right: -5rem;
    width: min(190px, 18vw);
    transform: rotate(6deg);
    opacity: 0.07;
  }

  .hi-backdrop__photo--snow {
    bottom: 25rem;
    left: -6rem;
    width: min(210px, 20vw);
    transform: rotate(3deg);
    opacity: 0.06;
  }

  .hi-backdrop__photo--community {
    bottom: 10rem;
    right: -6rem;
    width: min(240px, 22vw);
    transform: rotate(-4deg);
    opacity: 0.07;
  }

  /* ── Hero ───────────────────────────────────── */
  .hi-hero {
    width: min(100%, 760px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding-bottom: clamp(0.5rem, 1.25vw, 1rem);
  }

  .hi-hero__text {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    max-width: 42rem;
  }

  .hi-name {
    margin: 0;
    display: block;
    font-size: clamp(2.4rem, 6.8vw, 4.6rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: color-mix(in srgb, var(--tone-accent-glow) 60%, var(--tone-text) 40%);
  }

  .hi-name__lead {
    display: inline-block;
    position: relative;
    vertical-align: bottom;
  }

  .hi-name__letter {
    display: inline;
  }

  .hi-name__micro {
    position: absolute;
    bottom: 0.05em;
    left: calc(100% - 0.05em);
    font-size: 0.2em;
    line-height: 1;
    letter-spacing: 0.03em;
    opacity: 0.75;
    white-space: nowrap;
  }

  .hi-name__rest {
    display: inline-block;
    margin-left: 0.02em;
    vertical-align: bottom;
  }

  .hi-lede {
    margin: 0;
    max-width: 32rem;
    font-size: clamp(0.98rem, 1.7vw, 1.1rem);
    line-height: 1.62;
    color: var(--tone-text);
  }

  .hi-body {
    margin: 0 0 0.85rem;
    max-width: 58ch;
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--tone-muted);
  }

  .hi-roles {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 46%, var(--tone-muted) 54%);
  }

  .hi-context {
    max-width: 68ch;
    display: grid;
    gap: 0.65rem;
  }

  .hi-context__line {
    margin: 0;
    font-size: clamp(0.95rem, 1.8vw, 1.05rem);
    line-height: 1.65;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
  }

  /* ── Section shell ──────────────────────────── */
  .hi-section {
    width: min(100%, 760px);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hi-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }

  .hi-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tone-accent);
  }

  .hi-section__aside {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 70%, transparent);
    text-decoration: none;
    white-space: nowrap;
  }
  .hi-section__aside:hover { text-decoration: underline; }

  .hi-section__title {
    margin: 0 0 clamp(1rem, 2.5vw, 1.5rem);
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  /* ── Photo band ──────────────────────────────── */
  .hi-photo-band {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .hi-photo-band__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: 140px;
    gap: 0.7rem;
  }

  .hi-photo-band__card {
    position: relative;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 72%, transparent);
    min-height: 150px;
  }

  .hi-photo-band__card:nth-child(1) {
    grid-column: span 3;
    grid-row: span 2;
    min-height: 290px;
  }

  .hi-photo-band__card:nth-child(2),
  .hi-photo-band__card:nth-child(3) {
    grid-column: span 3;
    min-height: 140px;
  }

  .hi-photo-band__card:nth-child(4),
  .hi-photo-band__card:nth-child(5),
  .hi-photo-band__card:nth-child(6) {
    grid-column: span 2;
  }

  .hi-photo-band__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease, filter 260ms ease;
    filter: saturate(0.92) contrast(1.02);
  }

  .hi-photo-band__card:hover .hi-photo-band__image {
    transform: scale(1.03);
    filter: saturate(1) contrast(1.05);
  }

  .hi-photo-band__label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.22rem 0.52rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-surface-strong) 80%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, transparent);
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    backdrop-filter: blur(12px);
  }

  /* ── Work cards ─────────────────────────────── */
  .hi-work-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .hi-work-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 76%, transparent);
    text-decoration: none;
    color: inherit;
    transition: transform 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .hi-work-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--tone-accent) 28%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 4%, var(--tone-surface-strong));
  }

  .hi-work-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--tone-surface-strong) 84%, transparent);
  }

  .hi-work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 260ms ease, filter 260ms ease;
    filter: saturate(0.94) contrast(1.02);
  }

  .hi-work-card__image--contain {
    object-fit: contain;
    padding: 0.9rem;
    background: color-mix(in srgb, var(--tone-surface-strong) 86%, transparent);
  }

  .hi-work-card:hover .hi-work-card__image {
    transform: scale(1.03);
    filter: saturate(1) contrast(1.05);
  }

  .hi-work-card__body {
    display: grid;
    gap: 0.25rem;
    padding: 0.9rem 0.95rem 1rem;
  }

  .hi-work-card__type {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--tone-text) 56%, var(--tone-muted) 44%);
  }

  .hi-work-card__title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--tone-text);
  }

  /* ── Offerings list ─────────────────────────── */
  .hi-offerings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-offering {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0 1rem;
    padding: clamp(0.75rem, 1.8vw, 1.05rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-offering:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-offering__num {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--tone-text) 32%, transparent);
    letter-spacing: 0.04em;
  }

  .hi-offering__link {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    text-decoration: none;
    color: inherit;
  }

  .hi-offering__label {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--tone-text);
    transition: color 140ms ease;
  }

  .hi-offering:hover .hi-offering__label {
    color: var(--tone-accent-glow);
  }

  .hi-offering__desc {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--tone-muted);
  }

  .hi-offering__arrow {
    font-size: 1rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 50%, transparent);
    text-decoration: none;
    transition: transform 140ms ease, color 140ms ease;
  }

  .hi-offering:hover .hi-offering__arrow {
    transform: translateX(4px);
    color: var(--tone-accent-glow);
  }

  /* ── Archive stats ───────────────────────────── */
  .hi-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.8rem;
  }

  .hi-stats__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
    margin-right: 0.2rem;
  }

  .hi-stats__pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.22rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 12%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 80%, transparent);
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .hi-stats__pill:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 40%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .hi-stats__pill strong {
    font-family: var(--font-display, sans-serif);
    font-size: 0.86rem;
    color: var(--tone-accent-glow);
    font-weight: 700;
  }

  .hi-stats__pill--total {
    border-color: color-mix(in srgb, var(--tone-accent) 22%, var(--line2));
  }

  .hi-stats__dot {
    color: color-mix(in srgb, var(--tone-text) 30%, transparent);
  }

  /* ── AGI signals ─────────────────────────────── */
  .hi-signals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }

  .hi-signal {
    padding: 0.85rem 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-signal:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-signal__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 50%, var(--tone-muted) 50%);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hi-signal__wave {
    color: var(--tone-accent-glow);
    font-weight: 600;
  }

  .hi-signal__hed {
    margin: 0 0 0.3rem;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--tone-text);
  }

  .hi-signal__imp {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--tone-muted);
  }

  /* ── Threads ─────────────────────────────────── */
  .hi-threads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-thread {
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-thread:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-thread__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    padding: clamp(0.7rem, 1.6vw, 0.95rem) 0;
    text-decoration: none;
    color: inherit;
  }

  .hi-thread__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hi-thread__type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tone-accent);
    font-weight: 600;
  }

  .hi-thread__year {
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
  }

  .hi-thread__title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--tone-text);
    transition: color 140ms ease;
  }

  .hi-thread:hover .hi-thread__title { color: var(--tone-accent-glow); }

  .hi-thread__blurb {
    font-size: 0.83rem;
    line-height: 1.55;
    color: var(--tone-muted);
  }

  /* ── Row lists (recent + papers) ──────────────── */
  .hi-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-row {
    display: grid;
    grid-template-columns: 1.4rem 1fr auto;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 6%, var(--line2));
    text-decoration: none;
    color: inherit;
    transition: color 120ms ease;
  }

  .hi-rows li:last-child .hi-row {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 6%, var(--line2));
  }

  .hi-row:hover .hi-row__title { color: var(--tone-accent-glow); }

  .hi-row__icon {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 60%, transparent);
    text-align: center;
  }

  .hi-row__medium {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--tone-text) 54%, var(--tone-muted) 46%);
  }

  .hi-row__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--tone-text);
    line-height: 1.45;
    margin-bottom: 0.3rem;
    transition: color 120ms ease;
  }

  .hi-row__date,
  .hi-row__arrow {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--tone-text) 48%, var(--tone-muted) 52%);
    white-space: nowrap;
    text-align: right;
  }

  .hi-row__meta {
    grid-column: 2 / -1;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--tone-text) 48%, var(--tone-muted) 52%);
  }

  .hi-row--paper {
    grid-template-columns: 1.4rem 1fr auto 1.4rem;
  }

  .hi-row__tags {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Footer cols ─────────────────────────────── */
  .hi-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hi-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hi-footer__copy {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--tone-muted);
  }

  .hi-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .hi-footer__link {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 80%, transparent);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
  }

  .hi-footer__link:hover { text-decoration: underline; }

  .hi-elsewhere {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hi-elsewhere li {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }

  .hi-elsewhere__link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--tone-text);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .hi-elsewhere__link:hover { color: var(--tone-accent-glow); }

  .hi-elsewhere__desc {
    font-size: 0.76rem;
    color: var(--tone-muted);
  }

  /* ── Mobile ──────────────────────────────────── */
  @media (max-width: 600px) {
    .hi-home {
      padding-top: clamp(1.5rem, 5vw, 2.5rem);
    }

    .hi-hero {
      width: min(100%, 42rem);
    }

    .hi-backdrop__photo {
      opacity: 0.035;
      width: min(150px, 34vw);
    }

    .hi-backdrop__photo--theatre {
      top: -0.5rem;
      right: -2.25rem;
      width: min(180px, 40vw);
    }

    .hi-backdrop__photo--brain,
    .hi-backdrop__photo--archive,
    .hi-backdrop__photo--interior {
      display: none;
    }

    .hi-backdrop__photo--portrait {
      top: 16rem;
      right: -1.5rem;
      width: min(130px, 30vw);
    }

    .hi-backdrop__photo--snow {
      left: -1.75rem;
      bottom: 33rem;
      width: min(140px, 32vw);
    }

    .hi-backdrop__photo--community {
      right: -1.25rem;
      bottom: 18rem;
      width: min(150px, 34vw);
    }

    .hi-row {
      gap: 0.35rem;
    }

    .hi-footer {
      grid-template-columns: 1fr;
    }

    .hi-offering {
      grid-template-columns: 1.6rem 1fr auto;
      gap: 0 0.65rem;
    }
  }

  /* legacy .home-hero placeholder to avoid stray CSS errors */
  .home-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(22rem, 42vw, 32rem);
    display: grid;
    place-items: center;
    overflow: hidden;
    border-radius: clamp(1.6rem, 3vw, 2.8rem);
    margin-bottom: clamp(1rem, 2vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    background:
      linear-gradient(180deg, rgba(5, 9, 17, 0.52), rgba(4, 8, 15, 0.88)),
      radial-gradient(
        120% 110% at 50% 28%,
        rgba(7, 12, 20, 0.12),
        rgba(4, 8, 15, 0.44) 54%,
        rgba(4, 8, 15, 0.74) 100%
      ),
      radial-gradient(
        78% 58% at 50% 4%,
        color-mix(in srgb, var(--tone-accent) 4%, transparent),
        transparent 72%
      ),
      linear-gradient(135deg, rgba(8, 13, 22, 0.44), rgba(4, 8, 15, 0.72)),
      url('/images/bg-station.jpg');
    background-position: center 34%;
    background-size: cover;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.42),
      0 1px 0 rgba(255, 255, 255, 0.03) inset;
  }

  .home-hero::before,
  .home-hero::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .home-hero::before {
    inset: -18% -8% 26%;
    z-index: 0;
    background:
      radial-gradient(
        34% 20% at 50% 22%,
        color-mix(in srgb, var(--tone-accent-bright) 8%, transparent),
        transparent 72%
      ),
      radial-gradient(
        26% 16% at 26% 26%,
        color-mix(in srgb, var(--tone-sky-bright) 6%, transparent),
        transparent 74%
      ),
      radial-gradient(
        26% 16% at 74% 24%,
        color-mix(in srgb, var(--tone-sky-bright) 5%, transparent),
        transparent 74%
      );
    filter: blur(42px);
    opacity: 0.44;
  }

  .home-hero::after {
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(
        115deg,
        transparent 0%,
        transparent 24%,
        rgba(255, 255, 255, 0.025) 34%,
        transparent 46%,
        transparent 100%
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.014) 0 1px,
        transparent 1px 40px
      );
    mix-blend-mode: screen;
    opacity: 0.1;
  }

  .home-hero__content {
    position: relative;
    isolation: isolate;
    z-index: 4;
    width: min(100%, 56rem);
    padding:
      clamp(4.25rem, 8vw, 6.75rem)
      clamp(1.25rem, 5vw, 4rem)
      clamp(3.25rem, 7vw, 5.5rem);
    text-shadow: 0 10px 24px rgba(0, 0, 0, 0.44);
  }

  .home-hero__content::before,
  .home-hero__content::after {
    content: '';
    position: absolute;
    pointer-events: none;
  }

  .home-hero__content::before {
    z-index: 0;
    inset:
      clamp(1.1rem, 3vw, 2.2rem)
      clamp(0.8rem, 4vw, 2.4rem)
      clamp(1rem, 3vw, 2rem);
    border-radius: clamp(1.35rem, 3vw, 2.2rem);
    background:
      radial-gradient(
        68% 54% at 50% 28%,
        rgba(21, 31, 46, 0.16),
        rgba(9, 14, 23, 0.36) 54%,
        rgba(6, 10, 18, 0.64) 100%
      ),
      linear-gradient(
        180deg,
        rgba(9, 14, 23, 0.76),
        rgba(7, 11, 19, 0.82) 44%,
        rgba(4, 8, 15, 0.9)
      );
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px) saturate(0.88);
    box-shadow:
      0 28px 56px rgba(0, 0, 0, 0.34),
      0 1px 0 rgba(255, 255, 255, 0.05) inset,
      0 0 0 1px rgba(4, 8, 15, 0.16);
  }

  .home-hero__content::after {
    z-index: 2;
    inset:
      clamp(1.45rem, 3.4vw, 2.5rem)
      clamp(1.1rem, 4.6vw, 2.8rem)
      clamp(1.35rem, 3.4vw, 2.3rem);
    border-radius: clamp(1.1rem, 2.7vw, 2rem);
    border: 1px solid rgba(255, 255, 255, 0.035);
    background:
      linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.02),
        transparent 22%,
        transparent 74%,
        rgba(242, 184, 75, 0.02)
      );
  }

  .home-hero__content > :not(.home-hero__ivy) {
    position: relative;
    z-index: 3;
  }

  .home-hero__eyebrow,
  .home-hero__lede,
  .home-hero__body,
  .home-hero__roles,
  .home-hero__lead-note {
    margin: 0;
  }

  .home-hero__eyebrow {
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(229, 216, 197, 0.72);
  }

  .home-hero h1 {
    color: color-mix(in srgb, var(--tone-accent-glow) 70%, white 30%);
    text-shadow:
      0 14px 34px rgba(0, 0, 0, 0.34),
      0 0 18px rgba(231, 179, 109, 0.1);
  }

  .home-hero__lede {
    max-width: 42rem;
    margin-inline: auto;
    font-size: clamp(1.03rem, 1.7vw, 1.18rem);
    line-height: 1.6;
    color: rgba(245, 238, 227, 0.92);
  }

  .home-hero__body {
    max-width: 38rem;
    margin-inline: auto;
    font-size: 0.98rem;
    line-height: 1.68;
    color: rgba(231, 221, 207, 0.82);
  }

  .home-hero__roles {
    max-width: 34rem;
    margin-inline: auto;
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(218, 201, 177, 0.62);
  }

  .home-hero__lead-note {
    max-width: 36rem;
    margin-inline: auto;
    font-size: 0.98rem;
    line-height: 1.72;
    color: rgba(241, 213, 164, 0.92);
  }

  .home-hero__paths {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
  }

  .home-hero__path {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.6rem 0.95rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 28%, rgba(255, 255, 255, 0.08));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), rgba(255, 255, 255, 0.012)),
      rgba(9, 14, 22, 0.78);
    color: rgba(243, 236, 226, 0.9);
    text-decoration: none;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .home-hero__path.is-primary {
    color: rgba(247, 227, 190, 0.96);
    border-color: color-mix(in srgb, var(--tone-accent) 42%, rgba(255, 255, 255, 0.08));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 18%, transparent), transparent 72%),
      rgba(10, 15, 24, 0.92);
  }

  .home-hero__path:hover,
  .home-hero__path:focus-visible {
    color: var(--tone-accent-glow);
    border-color: color-mix(in srgb, var(--tone-accent) 54%, rgba(255, 255, 255, 0.08));
  }

  .home-hero__ivy {
    position: absolute;
    top: clamp(0.2rem, 1vw, 0.9rem);
    z-index: 1;
    width: clamp(104px, 14%, 148px);
    height: clamp(136px, 23%, 196px);
    pointer-events: none;
    background-repeat: no-repeat;
    background-size: contain;
    opacity: 0.52;
    filter: saturate(0.6) brightness(0.66) contrast(0.9) drop-shadow(0 10px 14px rgba(0, 0, 0, 0.16));
  }

  .home-hero__ivy--left {
    left: clamp(0.8rem, 2.4vw, 1.6rem);
    background-image: url('/images/garland/left-vine.png');
    background-position: left top;
    transform: rotate(-4deg);
    -webkit-mask-image: linear-gradient(160deg, rgba(0, 0, 0, 0.96) 18%, rgba(0, 0, 0, 0.9) 54%, transparent 100%);
    mask-image: linear-gradient(160deg, rgba(0, 0, 0, 0.96) 18%, rgba(0, 0, 0, 0.9) 54%, transparent 100%);
  }

  .home-hero__ivy--right {
    right: clamp(0.8rem, 2.4vw, 1.6rem);
    background-image: url('/images/garland/right-vine.png');
    background-position: right top;
    transform: rotate(4deg);
    -webkit-mask-image: linear-gradient(200deg, rgba(0, 0, 0, 0.96) 18%, rgba(0, 0, 0, 0.9) 54%, transparent 100%);
    mask-image: linear-gradient(200deg, rgba(0, 0, 0, 0.96) 18%, rgba(0, 0, 0, 0.9) 54%, transparent 100%);
  }

  .home-start-kicker,
  .home-start-title,
  .home-ai-callout__kicker,
  .home-ai-callout__title,
  .home-ai-callout__copy {
    margin: 0;
  }

  .home-start-kicker,
  .home-ai-callout__kicker {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .home-start-title,
  .home-ai-callout__title {
    margin-top: 0.35rem;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.15;
  }

  .home-start-grid {
    margin-top: 0.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .home-start-card {
    border: 1px solid color-mix(in srgb, var(--tone-accent) 16%, var(--line2));
    border-radius: 999px;
    padding: 0.58rem 0.85rem;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.45rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 8%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .home-start-card span {
    font-family: var(--font-display);
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .home-start-card small {
    color: color-mix(in srgb, var(--tone-text) 80%, var(--tone-muted) 20%);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .home-start-card:hover,
  .home-start-card:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 40%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .home-elsewhere {
    padding: 0.95rem 1rem 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-sky) 18%, var(--line2));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 10%, transparent), transparent 66%),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .home-start-card--secondary {
    border-color: color-mix(in srgb, var(--tone-sky) 22%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 14%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
  }

  .home-start-card--secondary:hover,
  .home-start-card--secondary:focus-visible {
    border-color: color-mix(in srgb, var(--tone-sky) 48%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 82%, white 18%);
  }

  .home-ai-callout__card {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid color-mix(in srgb, #c57d66 36%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 14%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-ai-callout__copy {
    max-width: 42rem;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
  }

  .home-ai-callout__link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #c57d66 46%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 18%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 92%, transparent);
    color: color-mix(in srgb, #f3d8cf 82%, white 18%);
    text-decoration: none;
    transition:
      transform 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .home-ai-callout__link:hover,
  .home-ai-callout__link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, #c57d66 76%, var(--line2));
    color: #f6e1da;
  }

  /* Archive stats strip */
  .home-archive-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .home-archive-stats__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--tone-text) 68%, var(--tone-muted) 32%);
    padding-right: 0.2rem;
  }

  .home-archive-stats__pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 12%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 80%, transparent);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .home-archive-stats__pill:hover,
  .home-archive-stats__pill:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 38%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .home-archive-stats__pill--total {
    border-color: color-mix(in srgb, var(--tone-accent) 22%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 6%, var(--tone-surface-strong));
  }

  .home-archive-stats__count {
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--tone-accent-glow);
  }

  .home-archive-stats__divider {
    color: color-mix(in srgb, var(--tone-text) 36%, transparent);
    font-size: 0.78rem;
  }

  /* Research + Systems grid */
  .home-research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .home-research-card {
    display: grid;
    gap: 0.65rem;
    padding: clamp(1rem, 2vw, 1.3rem);
  }

  .home-research-card--agi {
    border: 1px solid color-mix(in srgb, var(--tone-sky) 30%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 12%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-research-card--survival {
    border: 1px solid color-mix(in srgb, #c57d66 28%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 10%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-research-card__kicker,
  .home-research-card__title,
  .home-research-card__copy {
    margin: 0;
  }

  .home-research-card__kicker {
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  .home-research-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
  }

  .home-research-card__copy {
    font-size: 0.9rem;
    line-height: 1.52;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
  }

  .home-research-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .home-research-card__badge {
    display: inline-block;
    padding: 0.15rem 0.52rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
    background: color-mix(in srgb, var(--tone-surface) 80%, transparent);
  }

  .home-research-card--agi .home-research-card__badge {
    border-color: color-mix(in srgb, var(--tone-sky) 30%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 76%, white 24%);
  }

  .home-research-card__link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 28%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 8%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
    color: color-mix(in srgb, var(--tone-text) 92%, var(--tone-muted) 8%);
    font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .home-research-card--agi .home-research-card__link {
    border-color: color-mix(in srgb, var(--tone-sky) 36%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 82%, white 18%);
  }

  .home-research-card--survival .home-research-card__link {
    border-color: color-mix(in srgb, #c57d66 42%, var(--line2));
    color: color-mix(in srgb, #f3d8cf 82%, white 18%);
  }

  .home-research-card__link:hover,
  .home-research-card__link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tone-accent) 60%, var(--line2));
    color: var(--tone-accent-glow);
  }

  /* Map section */
  .home-map-section {
    display: grid;
    gap: 0.75rem;
  }

  .home-map-section__header {
    display: grid;
    gap: 0.3rem;
  }

  @media (max-width: 860px) {
    .desktop-home {
      display: grid;
      gap: 0.9rem;
    }

    .desktop-home > :where(.home-showcase-block, .home-research-grid, .home-map-section, .home-elsewhere) {
      margin-top: 0 !important;
    }

    .home-research-grid {
      grid-template-columns: 1fr;
    }

    .home-archive-stats {
      border-radius: 1rem;
    }

    .home-hero {
      min-height: 19.5rem;
      border-radius: 1.35rem;
      margin-top: 0;
      margin-bottom: 0;
      background-position: center 22%;
    }

    .home-hero::before {
      opacity: 0.32;
      filter: blur(38px);
    }

    .home-hero__content {
      width: min(100%, 38rem);
      padding:
        clamp(2.6rem, 9.5vw, 3.4rem)
        clamp(1rem, 5vw, 1.4rem)
        clamp(1.9rem, 7vw, 2.5rem);
    }

    .home-hero__content > :not(.home-hero__ivy) + :not(.home-hero__ivy) {
      margin-top: clamp(0.8rem, 3.6vw, 0.95rem);
    }

    .home-hero__content::before {
      inset:
        0.72rem
        0.4rem
        0.45rem;
      border-radius: 1.1rem;
      background:
        radial-gradient(
          90% 64% at 50% 22%,
          rgba(18, 29, 44, 0.12),
          rgba(7, 12, 21, 0.42) 46%,
          rgba(4, 8, 15, 0.72) 100%
        ),
        linear-gradient(
          180deg,
          rgba(7, 12, 21, 0.9),
          rgba(5, 9, 17, 0.93) 42%,
          rgba(4, 8, 15, 0.98)
        );
      border: 1px solid rgba(255, 255, 255, 0.07);
      backdrop-filter: blur(20px) saturate(0.82);
      box-shadow:
        0 22px 42px rgba(0, 0, 0, 0.36),
        0 1px 0 rgba(255, 255, 255, 0.05) inset;
    }

    .home-hero__content::after {
      inset:
        1.25rem
        0.8rem
        1rem;
      border-radius: 0.95rem;
      background:
        linear-gradient(
          180deg,
          rgba(255, 255, 255, 0.012),
          transparent 24%,
          transparent 74%,
          rgba(242, 184, 75, 0.014)
        );
    }

    .home-hero h1 {
      font-size: clamp(2.2rem, 8.8vw, 2.9rem);
      line-height: 0.96;
      text-wrap: balance;
    }

    .home-hero__ivy {
      top: 0.3rem;
      width: clamp(72px, 18vw, 104px);
      height: clamp(94px, 24vw, 136px);
      opacity: 0.2;
    }

    .home-hero__ivy--left {
      left: 0.5rem;
    }

    .home-hero__ivy--right {
      right: 0.5rem;
    }

    .home-hero__paths {
      gap: 0.55rem;
    }

    .home-hero__path {
      width: 100%;
      min-height: 2.9rem;
      padding: 0.7rem 1rem;
      background:
        linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.014)),
        rgba(7, 12, 21, 0.88);
      color: rgba(246, 239, 229, 0.95);
    }

    .home-hero__path.is-primary {
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 22%, transparent), transparent 72%),
        rgba(7, 12, 21, 0.95);
      color: rgba(249, 230, 194, 0.98);
    }

    .home-hero__lede {
      font-size: 1.03rem;
      line-height: 1.54;
      color: rgba(248, 241, 232, 0.96);
    }

    .home-hero__body,
    .home-hero__lead-note {
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .home-hero__body {
      color: rgba(234, 224, 211, 0.9);
    }

    .home-hero__roles {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      color: rgba(220, 207, 189, 0.74);
    }

    .home-hero__lead-note {
      color: rgba(245, 219, 175, 0.96);
    }

    .home-hero::after {
      opacity: 0.025;
    }

    .home-start-grid {
      margin-top: 0.2rem;
      gap: 0.5rem;
    }
  }

  /* ─── Atlas mini ────────────────────────────── */
  .home-atlas-mini__header {
    margin-bottom: 0.6rem;
  }

  /* ─── AGI signals ───────────────────────────── */
  .home-signals__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .home-signals__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .home-signal {
    padding: 0.85rem 1rem;
    border-radius: 0.7rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 55%, transparent);
  }

  .home-signal__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .home-signal__wave {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 22%, transparent);
    color: color-mix(in srgb, var(--tone-accent-glow) 90%, white 10%);
  }

  .home-signal__kind,
  .home-signal__timing {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--tone-text) 50%, var(--tone-muted) 50%);
  }

  .home-signal__kind::before { content: '·'; margin-right: 0.4rem; }

  .home-signal__headline {
    margin: 0 0 0.3rem;
    font-size: 0.88rem;
    font-weight: 600;
    color: color-mix(in srgb, var(--tone-text) 92%, white 8%);
    line-height: 1.4;
  }

  .home-signal__implication {
    margin: 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tone-text) 68%, var(--tone-muted) 32%);
    line-height: 1.5;
  }

  /* ─── Threads ────────────────────────────────── */
  .home-threads__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0.5rem;
  }

  .home-thread-card {
    display: grid;
    grid-template-rows: auto auto 1fr;
    gap: 0.25rem;
    padding: 0.9rem 1rem;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 60%, transparent);
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease;
  }

  .home-thread-card:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 32%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 6%, var(--tone-surface));
  }

  .home-thread-card__type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--tone-accent-glow) 80%, transparent);
  }

  .home-thread-card__year {
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
    float: right;
    margin-top: -1.1rem;
  }

  .home-thread-card__title {
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--tone-text);
    display: block;
    margin-top: 0.2rem;
  }

  .home-thread-card__blurb {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tone-text) 66%, var(--tone-muted) 34%);
    line-height: 1.5;
  }

  /* ─── Recent entries ─────────────────────────── */
  .home-recent__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .home-recent__all-link {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 80%, transparent);
    text-decoration: none;
    white-space: nowrap;
  }

  .home-recent__all-link:hover { text-decoration: underline; }

  .home-recent__grid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .home-recent__card {
    display: grid;
    grid-template-columns: 1.4rem 4.5rem 1fr auto;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 60%, transparent);
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease;
  }

  .home-recent__card:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 28%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 5%, var(--tone-surface));
  }

  .home-recent__icon {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 70%, transparent);
    text-align: center;
  }

  .home-recent__medium {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--tone-text) 56%, var(--tone-muted) 44%);
  }

  .home-recent__title {
    font-size: 0.88rem;
    color: color-mix(in srgb, var(--tone-text) 90%, white 10%);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .home-recent__date {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--tone-text) 48%, var(--tone-muted) 52%);
    white-space: nowrap;
  }

  /* ─── Papers ────────────────────────────────── */
  .home-papers__grid {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .home-paper-card {
    display: grid;
    grid-template-columns: 1.4rem 1fr auto 1.2rem;
    align-items: center;
    gap: 0.6rem;
    padding: 0.65rem 0.9rem;
    border-radius: 0.6rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 60%, transparent);
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease;
  }

  .home-paper-card:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 30%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 5%, var(--tone-surface));
  }

  .home-paper-card__icon {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 60%, transparent);
