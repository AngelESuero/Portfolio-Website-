---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeTimeline from '../components/LifeTimeline';
import profile from '../data/profile';
const heroParticles = Array.from({ length: 24 }, (_, index) => {
  const lanes = [
    { left: 7, size: 2.5, duration: 12.5, delay: -0.5, drift: -16, blur: 0.4, alpha: 0.14, bottom: -18 },
    { left: 15, size: 2.0, duration: 14.2, delay: -3.1, drift: -10, blur: 0.55, alpha: 0.16, bottom: -14 },
    { left: 24, size: 2.9, duration: 13.4, delay: -1.8, drift: -4, blur: 0.45, alpha: 0.18, bottom: -16 },
    { left: 33, size: 2.1, duration: 15.8, delay: -4.7, drift: 6, blur: 0.7, alpha: 0.15, bottom: -12 },
    { left: 42, size: 3.4, duration: 12.9, delay: -2.4, drift: 12, blur: 0.5, alpha: 0.22, bottom: -15 },
    { left: 51, size: 2.3, duration: 16.6, delay: -5.5, drift: 18, blur: 0.85, alpha: 0.14, bottom: -19 },
    { left: 60, size: 3.0, duration: 13.7, delay: -0.9, drift: 24, blur: 0.48, alpha: 0.2, bottom: -13 },
    { left: 69, size: 1.9, duration: 15.1, delay: -3.8, drift: 30, blur: 0.78, alpha: 0.16, bottom: -17 }
  ];

  const lane = lanes[index % lanes.length];
  const wave = Math.floor(index / lanes.length);

  return {
    left: `${lane.left + wave * 4}%`,
    size: `${lane.size + (wave % 2) * 0.35}px`,
    duration: `${lane.duration + wave * 0.55}s`,
    delay: `${lane.delay - wave * 1.2}s`,
    drift: `${lane.drift + (wave % 3 - 1) * 10}px`,
    blur: `${lane.blur + (wave % 2) * 0.1}px`,
    alpha: lane.alpha + (wave % 3) * 0.01,
    bottom: `${lane.bottom - wave * 2}%`,
  };
});

const showcaseStripPhotos = [
  '/photos/download.jpg',
  '/images/home-collage/collage-2.jpg',
  '/photos/download-1.jpg',
  '/images/home-collage/collage-4.jpg',
  '/photos/download-3.jpg',
  '/images/home-collage/collage-5.jpg',
  '/photos/download-5.jpg',
  '/images/home-collage/collage-6.jpg',
  '/photos/download-7.jpg',
  '/images/home-collage/collage-7.jpg',
  '/photos/download-2.jpg',
  '/images/home-collage/collage-3.jpg',
  '/photos/download.jpg',
  '/images/home-collage/collage-2.jpg',
  '/photos/download-1.jpg',
  '/images/home-collage/collage-4.jpg',
  '/photos/download-3.jpg',
  '/images/home-collage/collage-5.jpg',
  '/photos/download-5.jpg',
  '/images/home-collage/collage-6.jpg',
  '/photos/download-7.jpg',
  '/images/home-collage/collage-7.jpg',
  '/photos/download-2.jpg',
  '/images/home-collage/collage-3.jpg',
];


---

<BaseLayout
  title="A Path Toward Life - Portfolio"
  description={profile.short_bio}
  theme="archive"
  forceThemeMode="dark"
  bodyClass="home-page"
  flatSurface={true}
  showHeader={true}
  ambientEffects={false}
>
  <div class="hi-home">
    <section class="home-hero">
      <div class="home-hero__content text-center">
        <div class="home-particles" aria-hidden="true">
          {heroParticles.map((particle) => (
            <span
              class="home-particle"
              style={`--particle-left:${particle.left};--particle-size:${particle.size};--particle-duration:${particle.duration};--particle-delay:${particle.delay};--particle-drift:${particle.drift};--particle-blur:${particle.blur};--particle-alpha:${particle.alpha};--particle-bottom:${particle.bottom};`}
            />
          ))}
        </div>
        <p class="home-hero__eyebrow">Angel Suero</p>
        <h1 class="home-hero__title"><span class="home-hero__word">A<span class="home-hero__micro">es&apos;s</span></span><span class="home-hero__word">Path Toward Life</span></h1>
        <p class="home-hero__roles">Music, writing, visuals, archive, and Newark held in one place.</p>
      </div>
    </section>

    <section class="home-showcase" aria-label="Open showcase">
      <section class="home-showcase__panel">
        <p class="home-showcase__label">Present day</p>
        <p>
          The site holds music, writing, visuals, and active archive threads as a living record: quieter than a
          dashboard, more open than a finished portfolio shell.
        </p>
      </section>

      <div class="home-showcase__photos" aria-hidden="true">
        <div class="home-showcase__photos-track">
          {showcaseStripPhotos.map((src) => (
            <div class="home-showcase__photo" style={`background-image:url('${src}')`}></div>
          ))}
        </div>
      </div>

      <section class="home-showcase__panel">
        <p class="home-showcase__label">Still current</p>
        <p>
          The present-tense throughline stays the same: music, study, Newark, and archive practice feeding one another
          rather than sitting in separate categories.
        </p>
      </section>
    </section>

    <div class="hi-rule" aria-hidden="true"></div>

    <section class="hi-life-timeline" aria-label="Life timeline">
      <div class="hi-life-timeline__intro">
        <p class="hi-life-timeline__kicker">Life timeline</p>
        <p class="hi-life-timeline__copy">Open an era. See what came out of it.</p>
      </div>
      <LifeTimeline client:load layout="fullBleed" />
    </section>

  </div>
</BaseLayout>

<style>
  :global(body.home-page) {
    background:
      radial-gradient(78rem 46rem at 50% -8%, rgba(179, 132, 68, 0.18), transparent 62%),
      radial-gradient(54rem 34rem at 18% 12%, rgba(94, 125, 155, 0.12), transparent 68%),
      linear-gradient(180deg, rgba(12, 16, 24, 0.98), rgba(8, 11, 17, 1));
    background-color: #080b11;
    color: rgba(245, 238, 227, 0.96);
  }

  :global(body.home-page .site-content-stage) {
    background: transparent;
  }

  :global(body.home-page .page-shell) {
    padding-top: 0;
  }

  /* ── Layout shell ───────────────────────────── */
  .hi-home {
    max-width: 1040px;
    margin: 0 auto;
    padding: clamp(0.5rem, 1.2vw, 0.85rem) clamp(1rem, 3vw, 1.6rem) clamp(3rem, 6vw, 4.5rem);
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .home-showcase {
    width: calc(100% + 2 * clamp(1rem, 3vw, 1.6rem));
    max-width: 1020px;
    margin-left: calc(-1 * clamp(1rem, 3vw, 1.6rem));
    margin-right: calc(-1 * clamp(1rem, 3vw, 1.6rem));
    margin-bottom: clamp(1.2rem, 3vw, 2rem);
    padding: clamp(1rem, 2vw, 1.25rem) 0;
    background: rgba(248, 244, 236, 0.9);
    border: 1px solid rgba(214, 198, 175, 0.62);
    border-radius: 1.6rem;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.12);
    display: grid;
    justify-items: center;
    gap: clamp(0.75rem, 1.7vw, 1.15rem);
    overflow: visible;
    --home-showcase-inset: clamp(0.85rem, 2vw, 1.25rem);
  }

  .home-showcase__panel {
    width: min(62ch, calc(100% - (var(--home-showcase-inset) * 2)));
    margin-inline: auto;
    border: 1px solid rgba(214, 198, 175, 0.7);
    border-radius: 1.05rem;
    background: rgba(249, 244, 235, 0.96);
    padding: clamp(0.95rem, 2.2vw, 1.2rem);
  }

  .home-showcase__panel p {
    margin: 0;
  }

  .home-showcase__panel p:last-child {
    margin-top: 0.6rem;
    color: rgba(64, 52, 42, 0.88);
  }

  .home-showcase__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(202, 177, 139, 0.95);
  }

  .home-showcase__photos {
    width: 100dvw;
    margin: 0 calc(50% - 50dvw);
    padding-block: 0.35rem;
    overflow: hidden;
    position: relative;
    isolation: isolate;
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0%, #000 10%, #000 90%, transparent 100%);
  }

  .home-showcase__photos::before,
  .home-showcase__photos::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: clamp(1rem, 5vw, 4rem);
    pointer-events: none;
    z-index: 1;
  }

  .home-showcase__photos::before {
    left: 0;
    background: linear-gradient(90deg, rgba(248, 244, 236, 0.95), rgba(248, 244, 236, 0));
  }

  .home-showcase__photos::after {
    right: 0;
    background: linear-gradient(270deg, rgba(248, 244, 236, 0.95), rgba(248, 244, 236, 0));
  }

  .home-showcase__photos-track {
    display: flex;
    gap: 0.38rem;
    width: max-content;
    animation: home-showcase-scroll 36s linear infinite;
    padding-inline: clamp(0.6rem, 2vw, 1.1rem);
    opacity: 0.88;
    will-change: transform;
  }

  @keyframes home-showcase-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  .home-showcase__photo {
    width: clamp(96px, 13vw, 150px);
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    flex-shrink: 0;
    border-radius: 0.55rem;
    border: 1px solid rgba(214, 198, 175, 0.45);
    filter: saturate(0.72) brightness(0.88) contrast(0.95);
    box-shadow: 0 8px 18px rgba(26, 18, 12, 0.08);
    opacity: 0.96;
    transition: filter 0.3s ease;
  }

  .home-showcase__photo:hover {
    filter: saturate(0.84) brightness(0.94) contrast(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-showcase__photos-track {
      animation: none;
    }
  }

  .hi-rule {
    height: 1px;
    width: 100dvw;
    margin: 0;
    margin-left: calc(50% - 50dvw);
    background: color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
  }

  .hi-life-timeline {
    --lt-top-extend: 0px;
    padding: 0 0 clamp(0.6rem, 1.6vw, 1rem);
  }

  .hi-life-timeline__intro {
    width: min(100%, 44rem);
    margin: clamp(0.6rem, 1.2vw, 0.85rem) auto clamp(0.5rem, 1vw, 0.7rem);
    padding: 0 clamp(1rem, 3vw, 2.75rem);
    text-align: center;
  }

  .hi-life-timeline__kicker,
  .hi-life-timeline__copy {
    margin: 0;
  }

  .hi-life-timeline__kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(230, 214, 191, 0.72);
  }

  .hi-life-timeline__copy {
    margin-top: 0.42rem;
    font-size: 0.94rem;
    line-height: 1.55;
    color: rgba(236, 227, 214, 0.78);
  }

  .home-storyline {
    position: relative;
    display: grid;
    gap: 0;
    margin-top: clamp(0.2rem, 1vw, 0.6rem);
    padding-top: clamp(0.4rem, 1.4vw, 0.8rem);
  }

  .home-storyline__rail {
    position: absolute;
    inset: 0 auto 0 50%;
    width: 1px;
    transform: translateX(-0.5px);
    background:
      linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--tone-accent) 18%, var(--line2)) 12%,
        color-mix(in srgb, var(--tone-accent) 12%, var(--line2)) 88%,
        transparent
      );
    pointer-events: none;
    opacity: 0.78;
  }

  .home-storyline > .hi-rule {
    grid-column: 1 / -1;
    width: 100%;
  }

  .home-storyline__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1rem minmax(0, 1fr);
    align-items: start;
    gap: 0;
  }

  .home-storyline__row::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0.95rem;
    width: 6px;
    height: 6px;
    border-radius: 999px;
    transform: translateX(-50%);
    background: var(--tone-surface);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--tone-accent) 8%, transparent);
    z-index: 2;
  }

  .home-storyline__row > * {
    min-width: 0;
  }

  .home-storyline__row--left > *,
  .home-storyline__row--right > * {
    width: min(100%, 30rem);
  }

  .home-storyline__row--left > * {
    grid-column: 1;
    justify-self: end;
    padding-right: clamp(0.35rem, 1vw, 0.8rem);
    text-align: right;
  }

  .home-storyline__row--right > * {
    grid-column: 3;
    justify-self: start;
    padding-left: clamp(0.35rem, 1vw, 0.8rem);
    text-align: left;
  }

  /* ── Section shell ──────────────────────────── */
  .hi-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .hi-section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.3rem;
  }

  .hi-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--tone-accent);
  }

  .hi-section__aside {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 70%, transparent);
    text-decoration: none;
    white-space: nowrap;
  }
  .hi-section__aside:hover { text-decoration: underline; }

  .hi-section__title {
    margin: 0 0 clamp(1rem, 2.5vw, 1.5rem);
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    line-height: 1.12;
    letter-spacing: -0.02em;
  }

  /* ── Offerings list ─────────────────────────── */
  .hi-offerings {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-offering {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    gap: 0 1rem;
    padding: clamp(0.75rem, 1.8vw, 1.05rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-offering:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-offering__num {
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--tone-text) 32%, transparent);
    letter-spacing: 0.04em;
  }

  .hi-offering__link {
    display: flex;
    flex-direction: column;
    gap: 0.12rem;
    text-decoration: none;
    color: inherit;
  }

  .hi-offering__label {
    font-family: var(--font-display, sans-serif);
    font-size: clamp(1rem, 2.2vw, 1.2rem);
    font-weight: 600;
    line-height: 1.2;
    color: var(--tone-text);
    transition: color 140ms ease;
  }

  .hi-offering:hover .hi-offering__label {
    color: var(--tone-accent-glow);
  }

  .hi-offering__desc {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--tone-muted);
  }

  .hi-offering__arrow {
    font-size: 1rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 50%, transparent);
    text-decoration: none;
    transition: transform 140ms ease, color 140ms ease;
  }

  .hi-offering:hover .hi-offering__arrow {
    transform: translateX(4px);
    color: var(--tone-accent-glow);
  }

  /* ── Archive stats ───────────────────────────── */
  .hi-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    font-size: 0.8rem;
  }

  .hi-stats__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
    margin-right: 0.2rem;
  }

  .hi-stats__pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.22rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 12%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface) 80%, transparent);
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .hi-stats__pill:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 40%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .hi-stats__pill strong {
    font-family: var(--font-display, sans-serif);
    font-size: 0.86rem;
    color: var(--tone-accent-glow);
    font-weight: 700;
  }

  .hi-stats__pill--total {
    border-color: color-mix(in srgb, var(--tone-accent) 22%, var(--line2));
  }

  .hi-stats__dot {
    color: color-mix(in srgb, var(--tone-text) 30%, transparent);
  }

  /* ── AGI signals ─────────────────────────────── */
  .hi-signals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-signal {
    padding: clamp(0.7rem, 1.6vw, 0.95rem) 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-signal:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-signal__meta {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 50%, var(--tone-muted) 50%);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .hi-signal__wave {
    color: var(--tone-accent-glow);
    font-weight: 600;
  }

  .hi-signal__hed {
    margin: 0 0 0.3rem;
    font-size: 0.96rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--tone-text);
  }

  .hi-signal__imp {
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--tone-muted);
  }

  /* ── Threads ─────────────────────────────────── */
  .hi-threads {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-thread {
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-thread:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 8%, var(--line2));
  }

  .hi-thread__link {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.2rem;
    padding: clamp(0.7rem, 1.6vw, 0.95rem) 0;
    text-decoration: none;
    color: inherit;
  }

  .hi-thread__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .hi-thread__type {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--tone-accent);
    font-weight: 600;
  }

  .hi-thread__year {
    font-size: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
  }

  .hi-thread__title {
    font-size: 0.98rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--tone-text);
    transition: color 140ms ease;
  }

  .hi-thread:hover .hi-thread__title { color: var(--tone-accent-glow); }

  .hi-thread__blurb {
    font-size: 0.83rem;
    line-height: 1.55;
    color: var(--tone-muted);
  }

  /* ── Row lists (recent + papers) ──────────────── */
  .hi-rows {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .hi-row {
    display: grid;
    grid-template-columns: 1.4rem 1fr auto;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.9rem 0;
    border-top: 1px solid color-mix(in srgb, var(--tone-accent) 6%, var(--line2));
    text-decoration: none;
    color: inherit;
    transition: color 120ms ease;
  }

  .hi-rows li:last-child .hi-row {
    border-bottom: 1px solid color-mix(in srgb, var(--tone-accent) 6%, var(--line2));
  }

  .hi-row:hover .hi-row__title { color: var(--tone-accent-glow); }

  .hi-row__icon {
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 60%, transparent);
    text-align: center;
  }

  .hi-row__medium {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in srgb, var(--tone-text) 54%, var(--tone-muted) 46%);
  }

  .hi-row__title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--tone-text);
    line-height: 1.45;
    margin-bottom: 0.3rem;
    transition: color 120ms ease;
  }

  .hi-row__date,
  .hi-row__arrow {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--tone-text) 48%, var(--tone-muted) 52%);
    white-space: nowrap;
    text-align: right;
  }

  .hi-row__meta {
    grid-column: 2 / -1;
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--tone-text) 48%, var(--tone-muted) 52%);
  }

  .hi-row--paper {
    grid-template-columns: 1.4rem 1fr auto 1.4rem;
  }

  .hi-row__tags {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--tone-text) 44%, var(--tone-muted) 56%);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── Footer cols ─────────────────────────────── */
  .hi-footer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
  }

  .hi-footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .hi-footer__copy {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--tone-muted);
  }

  .hi-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
  }

  .hi-footer__link {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--tone-accent-glow) 80%, transparent);
    text-decoration: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    font-family: inherit;
  }

  .hi-footer__link:hover { text-decoration: underline; }

  .hi-elsewhere {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .hi-elsewhere li {
    display: flex;
    flex-direction: column;
    gap: 0.08rem;
  }

  .hi-elsewhere__link {
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--tone-text);
    text-decoration: none;
    transition: color 120ms ease;
  }

  .hi-elsewhere__link:hover { color: var(--tone-accent-glow); }

  .hi-elsewhere__desc {
    font-size: 0.76rem;
    color: var(--tone-muted);
  }

  /* ── Mobile ──────────────────────────────────── */
  @media (max-width: 600px) {
    .hi-home {
      padding-top: clamp(1.5rem, 5vw, 2.5rem);
    }

    .home-showcase {
      width: calc(100% + 2 * clamp(1rem, 3vw, 1.6rem));
      padding: 0.8rem 0 0.9rem;
      gap: 0.5rem;
      border-radius: 1.35rem;
    }

    .home-showcase__panel {
      width: calc(100% - 0.7rem);
      padding: 0.8rem;
      border-radius: 0.92rem;
    }

    .home-showcase__panel p:last-child {
      margin-top: 0.45rem;
      line-height: 1.5;
    }

    .home-showcase__photos {
      padding-block: 0.15rem;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 6%, #000 94%, transparent 100%);
    }

    .home-showcase__photos::before,
    .home-showcase__photos::after {
      width: 0.8rem;
      opacity: 0.85;
    }

    .home-showcase__photos-track {
      gap: 0.28rem;
      animation-duration: 52s;
      padding-inline: 0.3rem;
      opacity: 0.74;
    }

    .home-showcase__photo {
      width: clamp(76px, 21vw, 96px);
      border-radius: 0.42rem;
      filter: saturate(0.64) brightness(0.82) contrast(0.92);
    }

    .hi-row {
      grid-template-columns: 1.2rem 3.5rem 1fr auto;
      gap: 0.4rem;
    }

    .hi-row--paper {
      grid-template-columns: 1.2rem 1fr 1.2rem;
    }

    .hi-row__tags { display: none; }

    .hi-footer {
      grid-template-columns: 1fr;
    }

    .hi-offering {
      grid-template-columns: 1.6rem 1fr auto;
      gap: 0 0.65rem;
    }
  }

  /* Home hero */
  .home-hero {
    position: relative;
    isolation: isolate;
    min-height: clamp(11rem, 18vw, 14rem);
    padding: clamp(1.35rem, 3vw, 2rem) 0 clamp(0.9rem, 2vw, 1.2rem);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: clamp(0.95rem, 2vw, 1.25rem);
    overflow: hidden;
    margin-bottom: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: -12% -8% 24% -8%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(60% 64% at 50% 18%, rgba(232, 207, 179, 0.22), transparent 70%),
      radial-gradient(46% 38% at 50% 58%, rgba(95, 122, 160, 0.12), transparent 74%),
      linear-gradient(180deg, rgba(4, 8, 14, 0.08), transparent 58%);
  }

  .home-hero__content {
    position: relative;
    isolation: isolate;
    z-index: 4;
    width: 100%;
    padding: 0;
    text-shadow: 0 10px 22px rgba(0, 0, 0, 0.42);
  }

  .home-hero__controls {
    position: relative;
    z-index: 5;
    display: flex;
    justify-content: flex-end;
    width: 100%;
    margin-bottom: clamp(0.45rem, 1.2vw, 0.75rem);
    pointer-events: none;
  }

  .home-view-toggle {
    pointer-events: auto;
    min-height: 2rem;
    padding: 0.42rem 0.72rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(241, 230, 212, 0.92);
    border: 1px solid color-mix(in srgb, var(--tone-accent) 26%, var(--line2));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02)),
      rgba(20, 24, 34, 0.88);
    box-shadow:
      0 10px 22px rgba(0, 0, 0, 0.22),
      0 1px 0 rgba(255, 255, 255, 0.05) inset;
  }

  .home-view-toggle:hover {
    border-color: color-mix(in srgb, var(--tone-accent) 46%, var(--line2));
    color: #fff3dd;
  }

  .home-particles {
    position: absolute;
    inset: 0;
    z-index: 1;
    overflow: hidden;
    pointer-events: none;
    border-radius: inherit;
    mix-blend-mode: screen;
    mask-image: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.12) 0%,
      rgba(0, 0, 0, 0.7) 16%,
      rgba(0, 0, 0, 1) 40%,
      rgba(0, 0, 0, 1) 78%,
      rgba(0, 0, 0, 0.16) 100%
    );
  }

  .home-particle {
    position: absolute;
    left: var(--particle-left);
    bottom: var(--particle-bottom);
    width: var(--particle-size);
    height: var(--particle-size);
    border-radius: 999px;
    background:
      radial-gradient(circle, rgba(255, 251, 242, 0.98) 0%, rgba(248, 230, 195, 0.9) 22%, rgba(242, 184, 75, 0.42) 54%, transparent 78%);
    box-shadow:
      0 0 12px rgba(255, 248, 232, 0.34),
      0 0 30px rgba(242, 184, 75, 0.2);
    filter: blur(var(--particle-blur));
    opacity: 0;
    transform: translate3d(0, 18px, 0) scale(0.55);
    animation: home-particle-rise var(--particle-duration) linear infinite;
    animation-delay: var(--particle-delay);
    will-change: transform, opacity;
  }

  @keyframes home-particle-rise {
    0% {
      transform: translate3d(0, 20px, 0) scale(0.55);
      opacity: 0;
    }

    12% {
      opacity: var(--particle-alpha);
    }

    65% {
      opacity: calc(var(--particle-alpha) * 0.9);
    }

    100% {
      transform: translate3d(var(--particle-drift), -82vh, 0) scale(1.28);
      opacity: 0;
    }
  }

  .home-hero__eyebrow,
  .home-hero__title,
  .home-hero__lede,
  .home-hero__body,
  .home-hero__roles,
  .home-hero__lead-note {
    margin: 0;
  }

  .home-hero__eyebrow {
    margin-bottom: 0.32rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 216, 193, 0.82);
  }

  .home-hero__title {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.12em;
    flex-wrap: wrap;
    letter-spacing: -0.01em;
    font-family: var(--font-display, sans-serif);
    font-size: clamp(2.3rem, 5.8vw, 4.85rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--tone-accent-glow) 58%, white 42%);
    text-shadow:
      0 16px 40px rgba(0, 0, 0, 0.42),
      0 0 18px rgba(231, 179, 109, 0.14);
  }

  .home-hero__word {
    white-space: nowrap;
  }

  /* "es's" — the artist name suffix on the "A".
     Smaller size = annotation. Gold = identity marker.
     Raised above baseline = superscript, clearly read as part of "aes's". */
  .home-hero__micro {
    display: inline-block;
    font-size: 0.24em;
    font-weight: 600;
    letter-spacing: 0.05em;
    position: relative;
    bottom: 0.34em;
    color: var(--tone-accent-glow, #e8b96a);
    text-shadow: 0 0 10px rgba(232, 185, 106, 0.28);
    opacity: 1;
  }

  .home-hero__lede {
    max-width: 42rem;
    margin-inline: auto;
    font-size: clamp(1.03rem, 1.7vw, 1.18rem);
    line-height: 1.6;
    color: rgba(245, 238, 227, 0.92);
  }

  .home-hero__body {
    max-width: 38rem;
    margin-inline: auto;
    font-size: 0.98rem;
    line-height: 1.68;
    color: rgba(231, 221, 207, 0.82);
  }

  .home-hero__roles {
    max-width: 38rem;
    margin-top: 0.48rem;
    margin-inline: auto;
    font-size: 0.92rem;
    line-height: 1.5;
    letter-spacing: 0.015em;
    text-transform: none;
    color: rgba(236, 227, 214, 0.88);
  }

  .home-hero__lead-note {
    max-width: 36rem;
    margin-inline: auto;
    font-size: 0.98rem;
    line-height: 1.72;
    color: rgba(241, 213, 164, 0.92);
  }

  .home-start-kicker,
  .home-start-title,
  .home-ai-callout__kicker,
  .home-ai-callout__title,
  .home-ai-callout__copy {
    margin: 0;
  }

  .home-start-kicker,
  .home-ai-callout__kicker {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .home-start-title,
  .home-ai-callout__title {
    margin-top: 0.35rem;
    font-size: clamp(1.2rem, 2vw, 1.6rem);
    line-height: 1.15;
  }

  .home-start-grid {
    margin-top: 0.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .home-start-card {
    border: 1px solid color-mix(in srgb, var(--tone-accent) 16%, var(--line2));
    border-radius: 999px;
    padding: 0.58rem 0.85rem;
    display: inline-flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.2rem 0.45rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 8%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
    transition:
      border-color 140ms ease,
      color 140ms ease;
  }

  .home-start-card span {
    font-family: var(--font-display);
    font-size: 0.94rem;
    line-height: 1.2;
  }

  .home-start-card small {
    color: color-mix(in srgb, var(--tone-text) 80%, var(--tone-muted) 20%);
    font-size: 0.74rem;
    line-height: 1.4;
  }

  .home-start-card:hover,
  .home-start-card:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 40%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .home-elsewhere {
    padding: 0.95rem 1rem 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-sky) 18%, var(--line2));
    border-radius: 1rem;
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 10%, transparent), transparent 66%),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .home-start-card--secondary {
    border-color: color-mix(in srgb, var(--tone-sky) 22%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 14%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
  }

  .home-start-card--secondary:hover,
  .home-start-card--secondary:focus-visible {
    border-color: color-mix(in srgb, var(--tone-sky) 48%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 82%, white 18%);
  }

  .home-ai-callout__card {
    display: grid;
    gap: 0.75rem;
    padding: clamp(1rem, 2vw, 1.35rem);
    border: 1px solid color-mix(in srgb, #c57d66 36%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 14%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-ai-callout__copy {
    max-width: 42rem;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
  }

  .home-ai-callout__link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, #c57d66 46%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 18%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 92%, transparent);
    color: color-mix(in srgb, #f3d8cf 82%, white 18%);
    text-decoration: none;
    transition:
      transform 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .home-ai-callout__link:hover,
  .home-ai-callout__link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, #c57d66 76%, var(--line2));
    color: #f6e1da;
  }

  /* Archive stats strip */
  .home-archive-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.55rem;
    padding: 0.6rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 10%, var(--line2));
    border-radius: 999px;
    background: color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .home-archive-stats__label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: color-mix(in srgb, var(--tone-text) 68%, var(--tone-muted) 32%);
    padding-right: 0.2rem;
  }

  .home-archive-stats__pill {
    display: inline-flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.22rem 0.6rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 12%, var(--line2));
    background: color-mix(in srgb, var(--tone-surface-strong) 80%, transparent);
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .home-archive-stats__pill:hover,
  .home-archive-stats__pill:focus-visible {
    border-color: color-mix(in srgb, var(--tone-accent) 38%, var(--line2));
    color: var(--tone-accent-glow);
  }

  .home-archive-stats__pill--total {
    border-color: color-mix(in srgb, var(--tone-accent) 22%, var(--line2));
    background: color-mix(in srgb, var(--tone-accent) 6%, var(--tone-surface-strong));
  }

  .home-archive-stats__count {
    font-family: var(--font-display);
    font-size: 0.88rem;
    color: var(--tone-accent-glow);
  }

  .home-archive-stats__divider {
    color: color-mix(in srgb, var(--tone-text) 36%, transparent);
    font-size: 0.78rem;
  }

  /* Research + Systems grid */
  .home-research-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem;
  }

  .home-research-card {
    display: grid;
    gap: 0.65rem;
    padding: clamp(1rem, 2vw, 1.3rem);
  }

  .home-research-card--agi {
    border: 1px solid color-mix(in srgb, var(--tone-sky) 30%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-sky) 12%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-research-card--survival {
    border: 1px solid color-mix(in srgb, #c57d66 28%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, #c57d66 10%, transparent), transparent 68%),
      color-mix(in srgb, var(--tone-surface-strong) 90%, transparent);
  }

  .home-research-card__kicker,
  .home-research-card__title,
  .home-research-card__copy {
    margin: 0;
  }

  .home-research-card__kicker {
    font-size: 0.69rem;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  .home-research-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1.8vw, 1.4rem);
    line-height: 1.1;
  }

  .home-research-card__copy {
    font-size: 0.9rem;
    line-height: 1.52;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
  }

  .home-research-card__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .home-research-card__badge {
    display: inline-block;
    padding: 0.15rem 0.52rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 18%, var(--line2));
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
    background: color-mix(in srgb, var(--tone-surface) 80%, transparent);
  }

  .home-research-card--agi .home-research-card__badge {
    border-color: color-mix(in srgb, var(--tone-sky) 30%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 76%, white 24%);
  }

  .home-research-card__link {
    width: fit-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 36px;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 28%, var(--line2));
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--tone-accent) 8%, transparent), transparent 70%),
      color-mix(in srgb, var(--tone-surface) 90%, transparent);
    color: color-mix(in srgb, var(--tone-text) 92%, var(--tone-muted) 8%);
    font-size: 0.88rem;
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .home-research-card--agi .home-research-card__link {
    border-color: color-mix(in srgb, var(--tone-sky) 36%, var(--line2));
    color: color-mix(in srgb, var(--tone-sky-bright) 82%, white 18%);
  }

  .home-research-card--survival .home-research-card__link {
    border-color: color-mix(in srgb, #c57d66 42%, var(--line2));
    color: color-mix(in srgb, #f3d8cf 82%, white 18%);
  }

  .home-research-card__link:hover,
  .home-research-card__link:focus-visible {
    transform: translateY(-1px);
    border-color: color-mix(in srgb, var(--tone-accent) 60%, var(--line2));
    color: var(--tone-accent-glow);
  }

  /* Map section */
  .home-map-section {
    display: grid;
    gap: 0.75rem;
  }

  .home-map-section__header {
    display: grid;
    gap: 0.3rem;
  }

  @media (max-width: 860px) {
    .desktop-home {
      display: grid;
      gap: 0.9rem;
    }

    .desktop-home > :where(.home-showcase-block, .home-research-grid, .home-map-section, .home-elsewhere) {
      margin-top: 0 !important;
    }

    .home-research-grid {
      grid-template-columns: 1fr;
    }

    .home-archive-stats {
      border-radius: 1rem;
    }

    .home-hero {
      min-height: 12rem;
      border-radius: 0;
      margin-top: 0;
      margin-bottom: 0;
    }

    .home-hero__content {
      width: 100%;
      padding: 0;
    }

    .home-hero h1 {
      font-size: clamp(2rem, 8.4vw, 2.8rem);
      line-height: 0.96;
      text-wrap: balance;
    }

    .home-hero__lede {
      font-size: 1.03rem;
      line-height: 1.54;
      color: rgba(248, 241, 232, 0.96);
    }

    .home-hero__body,
    .home-hero__lead-note {
      font-size: 0.98rem;
      line-height: 1.58;
    }

    .home-hero__body {
      color: rgba(234, 224, 211, 0.9);
    }

    .home-hero__roles {
      font-size: 0.8rem;
      letter-spacing: 0.1em;
      color: rgba(220, 207, 189, 0.74);
    }

    .home-hero__lead-note {
      color: rgba(245, 219, 175, 0.96);
    }

    .home-start-grid {
      margin-top: 0.2rem;
      gap: 0.5rem;
    }

    .home-storyline {
      margin-top: 0.1rem;
      padding-top: 0.25rem;
    }

    .home-storyline__rail {
      left: 0.85rem;
      transform: none;
      opacity: 0.34;
    }

    .home-storyline__row {
      grid-template-columns: 1rem minmax(0, 1fr);
    }

    .home-storyline__row::before {
      left: 0.6rem;
      top: 0.9rem;
      transform: translateX(-50%);
    }

    .home-storyline__row--left > *,
    .home-storyline__row--right > * {
      grid-column: 2;
      justify-self: stretch;
      width: 100%;
      text-align: left;
      padding-left: 0;
      padding-right: 0;
    }
  }

  /* ─── Atlas mini ────────────────────────────── */
  .home-atlas-mini__header {
    margin-bottom: 0.6rem;
  }

  /* ─── AGI signals ───────────────────────────── */
  .home-signals__header {
    display: flex;
    align-items: flex-end;
