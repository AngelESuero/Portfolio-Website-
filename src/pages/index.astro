---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeTimeline from '../components/LifeTimeline';
import profile from '../data/profile';

const heroActions = [
  { href: '#home-timeline', label: 'View timeline' },
  { href: '/work', label: 'Work' },
  { href: '/contact', label: 'Contact' },
] as const;

const heroFacts = [
  { label: 'Base', value: profile.location },
  { label: 'Practice', value: profile.roles.join(' / ') },
  { label: 'Mode', value: profile.mottos[0] },
] as const;

const homeRoutes = [
  {
    href: '/work',
    title: 'Work',
    description: 'Selected projects, systems, and outcomes.',
  },
  {
    href: '/writing',
    title: 'Writing',
    description: 'Essays, notes, and source voice.',
  },
  {
    href: '/archive',
    title: 'Archive',
    description: 'Music, video, and process fragments.',
  },
  {
    href: '/about',
    title: 'About',
    description: 'Context and continuity.',
  },
  {
    href: '/contact',
    title: 'Contact',
    description: 'Commissions, collaborations, direct notes.',
  },
] as const;

const aiPledgeCommitments = [
  'Say when AI shapes the language, structure, or output.',
  'Keep human judgment with the person, not the machine.',
  'Protect labor dignity and environmental cost as visible parts of the work.',
] as const;

const timelinePreview = [
  { label: 'Youth', value: '2000–2009' },
  { label: 'College', value: '2019–2023' },
  { label: 'Current', value: '2024–Now' },
] as const;
---

<BaseLayout
  title="Angel Suero | A Path Toward Life"
  description={profile.short_bio}
  theme="archive"
  forceThemeMode="dark"
  bodyClass="home-page"
  flatSurface={true}
  showHeader={true}
  ambientEffects={false}
  fullBleed={true}
>
  <div class="home-shell">
    <section class="home-hero" aria-labelledby="home-hero-heading">
      <div class="home-hero__copy">
        <p class="home-hero__eyebrow">A Path Toward Life</p>
        <h1 id="home-hero-heading" class="home-hero__title">Angel Suero</h1>
        <p class="home-hero__lede">
          Music, writing, visuals, and Newark held in one frame.
        </p>

        <div class="home-hero__actions" aria-label="Primary routes">
          {heroActions.map((action, index) => (
            <a
              href={action.href}
              class={`home-hero__action${index === 0 ? ' home-hero__action--primary' : ''}`}
            >
              {action.label}
            </a>
          ))}
        </div>

        <dl class="home-hero__facts" aria-label="Quick context">
          {heroFacts.map((fact) => (
            <div class="home-hero__fact">
              <dt class="home-hero__fact-label">{fact.label}</dt>
              <dd class="home-hero__fact-value">{fact.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="home-hero__figure">
        <img
          class="home-hero__image"
          src="/images/home-preview/download.jpg"
          alt="Angel Suero under a bright streetlight at night"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
        <figcaption class="home-hero__figure-caption">
          <span class="home-hero__figure-kicker">Present tense archive</span>
          <span class="home-hero__figure-copy">Newark at night, with the work still unfolding.</span>
        </figcaption>
      </figure>
    </section>

    <section class="home-timeline" aria-labelledby="home-timeline-heading" id="home-timeline">
      <details class="home-timeline__details">
        <summary class="home-timeline__summary">
          <div class="home-timeline__summaryCopy">
            <p class="home-timeline__kicker">Life timeline</p>
            <h2 id="home-timeline-heading" class="home-timeline__title">
              Open an era. See what came out of it.
            </h2>
            <p class="home-timeline__lede">
              A compact view first. Expand for the full sequence, context, and branches.
            </p>
          </div>

          <div class="home-timeline__summaryMeta">
            <div class="home-timeline__chips" aria-hidden="true">
              {timelinePreview.map((item) => (
                <span class="home-timeline__chip">
                  <span class="home-timeline__chipLabel">{item.label}</span>
                  <span class="home-timeline__chipValue">{item.value}</span>
                </span>
              ))}
            </div>
            <span class="home-timeline__summaryAction" aria-hidden="true">
              <span class="home-timeline__summaryActionLabel home-timeline__summaryActionLabel--open">
                Expand timeline →
              </span>
              <span class="home-timeline__summaryActionLabel home-timeline__summaryActionLabel--close">
                Collapse timeline ←
              </span>
            </span>
          </div>
        </summary>

        <div class="home-timeline__body">
          <LifeTimeline layout="fullBleed" />
        </div>
      </details>
    </section>

    <div class="home-content">
      <section class="home-routes" aria-labelledby="home-routes-heading">
        <div class="home-section-head">
          <div class="home-section-head__stack">
            <p class="home-section-head__kicker">Site index</p>
            <h2 id="home-routes-heading" class="home-section-head__title">
              The rest of the site, in five routes.
            </h2>
          </div>
          <p class="home-section-head__aside">Start wherever you need to.</p>
        </div>

        <ul class="home-routes__list" role="list">
          {homeRoutes.map((route) => (
            <li class="home-route__item">
              <a class="home-route" href={route.href}>
                <span class="home-route__title">{route.title}</span>
                <span class="home-route__description">{route.description}</span>
                <span class="home-route__arrow" aria-hidden="true">Open →</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="home-pledge" aria-labelledby="home-pledge-heading">
        <div class="home-pledge__inner">
          <div class="home-pledge__lead">
            <p class="home-pledge__kicker">Commitment</p>
            <h2 id="home-pledge-heading" class="home-pledge__title">
              AI Accountability Pledge
            </h2>
            <p class="home-pledge__lede">
              Transparent use. Human judgment. Labor dignity. Environmental honesty.
            </p>
            <a class="home-pledge__action" href="/ai-accountability-pledge">
              Read the full pledge
            </a>
          </div>

          <div class="home-pledge__proof">
            <blockquote class="home-pledge__quote">
              AI is a tool, not a replacement for responsibility.
            </blockquote>

            <ol class="home-pledge__list" role="list">
              {aiPledgeCommitments.map((commitment, index) => (
                <li class="home-pledge__item">
                  <span class="home-pledge__item-num">{String(index + 1).padStart(2, '0')}</span>
                  <span class="home-pledge__item-text">{commitment}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  :global(body.home-page) {
    background:
      radial-gradient(72rem 42rem at 56% 12%, rgba(182, 132, 72, 0.22), transparent 58%),
      radial-gradient(60rem 36rem at 18% 18%, rgba(91, 121, 152, 0.14), transparent 60%),
      linear-gradient(180deg, rgba(7, 10, 16, 0.98), rgba(6, 8, 12, 1));
    background-color: #06080c;
    color: rgba(245, 239, 230, 0.96);
  }

  :global(body.home-page .page-shell) {
    padding: 0;
  }

  :global(body.home-page .mode-normal) {
    max-width: none;
    margin: 0;
    width: 100%;
  }

  :global(body.home-page .site-content-stage) {
    background: transparent;
  }

  :global(body.home-page .site-content-stage::before) {
    display: none;
  }

  .home-shell {
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    width: min(1360px, calc(100% - clamp(1rem, 3vw, 1.75rem) * 2));
    margin: 0 auto;
    padding: clamp(0.75rem, 1.6vw, 1.25rem) 0 clamp(1.5rem, 3vw, 2.25rem);
  }

  .home-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(0.9rem, 2.1vw, 1.9rem);
    align-items: stretch;
    min-height: min(78svh, 50rem);
    padding: clamp(0.85rem, 1.8vw, 1.25rem);
    overflow: hidden;
  }

  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(54rem 30rem at 20% 28%, rgba(228, 190, 131, 0.16), transparent 56%),
      linear-gradient(180deg, rgba(5, 7, 11, 0.18), rgba(5, 7, 11, 0.48) 62%, rgba(5, 7, 11, 0.78));
  }

  .home-hero__copy,
  .home-hero__figure {
    position: relative;
    z-index: 1;
  }

  .home-hero__copy {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(0.85rem, 2vw, 1.15rem);
    padding: clamp(1.1rem, 4vw, 4rem) clamp(0.25rem, 1.25vw, 0.75rem) clamp(0.9rem, 2vw, 1.75rem);
    animation: home-rise 520ms var(--ease-emphasized, ease-out) both;
  }

  .home-hero__eyebrow {
    margin: 0;
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(234, 219, 196, 0.76);
  }

  .home-hero__title {
    margin: 0;
    max-width: 8ch;
    font-family: var(--font-display, serif);
    font-size: clamp(3.5rem, 8.8vw, 7.6rem);
    line-height: 0.88;
    letter-spacing: -0.06em;
    text-wrap: balance;
    color: rgba(250, 245, 237, 0.98);
    text-shadow: 0 18px 30px rgba(0, 0, 0, 0.32);
  }

  .home-hero__lede {
    margin: 0;
    max-width: 30ch;
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.58;
    color: rgba(239, 230, 217, 0.82);
  }

  .home-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.15rem;
  }

  .home-hero__action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.8rem;
    padding: 0.68rem 1rem;
    border-radius: 999px;
    border: 1px solid rgba(236, 225, 208, 0.18);
    background: rgba(255, 255, 255, 0.04);
    color: rgba(248, 244, 236, 0.94);
    text-decoration: none;
    font-size: 0.88rem;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      color 160ms ease;
  }

  .home-hero__action--primary {
    background: linear-gradient(180deg, rgba(225, 173, 103, 0.95), rgba(185, 122, 45, 0.9));
    color: #120d08;
    border-color: rgba(255, 215, 168, 0.32);
  }

  .home-hero__action:hover,
  .home-hero__action:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(236, 225, 208, 0.34);
    color: #fff7ee;
  }

  .home-hero__action--primary:hover,
  .home-hero__action--primary:focus-visible {
    color: #120d08;
    border-color: rgba(255, 229, 194, 0.55);
  }

  .home-hero__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
    margin: 0.35rem 0 0;
    padding: 0;
  }

  .home-hero__fact {
    min-width: 0;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(236, 225, 208, 0.14);
  }

  .home-hero__fact-label {
    margin: 0 0 0.25rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(233, 219, 197, 0.6);
  }

  .home-hero__fact-value {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.45;
    color: rgba(247, 240, 230, 0.88);
  }

  .home-hero__figure {
    display: flex;
    align-self: stretch;
    min-height: 100%;
    border-radius: 1.9rem;
    overflow: hidden;
    border: 1px solid rgba(236, 225, 208, 0.12);
    background: rgba(10, 12, 18, 0.9);
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.34),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    animation: home-rise 600ms 60ms var(--ease-emphasized, ease-out) both;
  }

  .home-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    opacity: 0.98;
    transform: scale(1.01);
    transition: transform 320ms ease;
  }

  .home-hero__figure:hover .home-hero__image {
    transform: scale(1.03);
  }

  .home-hero__figure-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: grid;
    gap: 0.25rem;
    padding: clamp(1rem, 2vw, 1.3rem);
    background: linear-gradient(180deg, rgba(5, 7, 11, 0), rgba(5, 7, 11, 0.82) 52%, rgba(5, 7, 11, 0.98));
    color: rgba(247, 240, 230, 0.94);
  }

  .home-hero__figure-kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(233, 219, 197, 0.72);
  }

  .home-hero__figure-copy {
    margin: 0;
    max-width: 18ch;
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .home-timeline {
    display: grid;
    gap: 0.5rem;
    padding: clamp(0.35rem, 1.1vw, 0.9rem) 0 clamp(0.2rem, 0.8vw, 0.5rem);
    scroll-margin-top: calc(var(--site-header-size, 64px) + 1rem);
  }

  .home-timeline__details {
    display: grid;
    gap: clamp(0.7rem, 1.7vw, 1.15rem);
  }

  .home-timeline__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: center;
    width: 100%;
    padding: clamp(1rem, 2.1vw, 1.45rem) clamp(1rem, 2.2vw, 1.45rem);
    border: 1px solid rgba(236, 225, 208, 0.12);
    border-radius: 1.5rem;
    background:
      radial-gradient(80% 120% at 0% 0%, rgba(225, 173, 103, 0.08), transparent 58%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.02));
    box-shadow:
      0 18px 44px rgba(0, 0, 0, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    cursor: pointer;
    list-style: none;
    transition:
      transform 160ms ease,
      border-color 160ms ease,
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .home-timeline__summary::-webkit-details-marker {
    display: none;
  }

  .home-timeline__summary::marker {
    content: '';
  }

  .home-timeline__summary:hover,
  .home-timeline__summary:focus-visible {
    transform: translateY(-1px);
    border-color: rgba(236, 225, 208, 0.22);
    box-shadow:
      0 22px 52px rgba(0, 0, 0, 0.22),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  .home-timeline__summary:focus-visible {
    outline: 2px solid rgba(225, 173, 103, 0.8);
    outline-offset: 4px;
  }

  .home-timeline__summaryCopy {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .home-timeline__kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(233, 219, 197, 0.68);
  }

  .home-timeline__title {
    margin: 0;
    max-width: 16ch;
    font-family: var(--font-display, serif);
    font-size: clamp(1.35rem, 2.3vw, 2.1rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    text-wrap: balance;
    color: rgba(248, 244, 237, 0.98);
  }

  .home-timeline__lede {
    margin: 0;
    max-width: 34ch;
    font-size: clamp(0.94rem, 1.22vw, 1.06rem);
    line-height: 1.55;
    color: rgba(231, 221, 206, 0.76);
  }

  .home-timeline__summaryMeta {
    display: grid;
    gap: 0.7rem;
    justify-items: end;
  }

  .home-timeline__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.48rem;
    max-width: 32rem;
  }

  .home-timeline__chip {
    display: grid;
    gap: 0.12rem;
    min-width: 7.1rem;
    padding: 0.58rem 0.72rem 0.62rem;
    border: 1px solid rgba(236, 225, 208, 0.14);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.03);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .home-timeline__chipLabel {
    font-size: 0.64rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(233, 219, 197, 0.62);
  }

  .home-timeline__chipValue {
    font-size: 0.9rem;
    line-height: 1.2;
    color: rgba(247, 240, 230, 0.92);
  }

  .home-timeline__summaryAction {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.55rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(236, 225, 208, 0.16);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(248, 244, 236, 0.9);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home-timeline__summaryActionLabel--close {
    display: none;
  }

  .home-timeline__body {
    display: block;
    padding-top: clamp(0.15rem, 0.8vw, 0.4rem);
  }

  .home-timeline__details:not([open]) .home-timeline__body {
    display: none;
  }

  .home-timeline__details[open] .home-timeline__body {
    animation: home-timeline-expand 160ms var(--ease-emphasized, ease-out) both;
  }

  .home-timeline__details[open] .home-timeline__summary {
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.75rem 1rem;
    align-items: center;
    padding: 0.8rem 1rem;
    border-bottom-left-radius: 0.95rem;
    border-bottom-right-radius: 0.95rem;
  }

  .home-timeline__details[open] .home-timeline__title {
    font-size: clamp(1.08rem, 1.8vw, 1.55rem);
  }

  .home-timeline__details[open] .home-timeline__lede,
  .home-timeline__details[open] .home-timeline__chips {
    display: none;
  }

  .home-timeline__details[open] .home-timeline__summaryMeta {
    justify-items: end;
  }

  .home-timeline__details[open] .home-timeline__summaryActionLabel--open {
    display: none;
  }

  .home-timeline__details[open] .home-timeline__summaryActionLabel--close {
    display: inline;
  }

  @keyframes home-timeline-expand {
    from {
      opacity: 0;
      transform: translateY(-0.35rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .home-content {
    width: min(1040px, 100%);
    margin: 0 auto;
    padding: clamp(1.75rem, 4vw, 3rem) 0 clamp(3rem, 6vw, 4.5rem);
    display: grid;
    gap: clamp(2rem, 4vw, 3.25rem);
  }

  .home-section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(1rem, 2vw, 1.35rem);
  }

  .home-section-head__stack {
    display: grid;
    gap: 0.32rem;
    min-width: 0;
  }

  .home-section-head__kicker {
    margin: 0;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: rgba(233, 219, 197, 0.68);
  }

  .home-section-head__title {
    margin: 0;
    font-family: var(--font-display, serif);
    font-size: clamp(1.6rem, 3vw, 2.35rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
    color: rgba(248, 244, 237, 0.98);
  }

  .home-section-head__aside {
    margin: 0;
    max-width: 23ch;
    font-size: 0.84rem;
    line-height: 1.5;
    color: rgba(231, 221, 206, 0.7);
    text-align: right;
  }

  .home-routes__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  .home-route__item {
    margin: 0;
  }

  .home-route {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'title arrow'
      'description arrow';
    gap: 0.3rem 1rem;
    padding: 1rem 0;
    border-top: 1px solid rgba(236, 225, 208, 0.12);
    color: inherit;
    text-decoration: none;
    transition:
      transform 150ms ease,
      border-color 150ms ease,
      color 150ms ease;
  }

  .home-route__item:last-child .home-route {
    border-bottom: 1px solid rgba(236, 225, 208, 0.12);
  }

  .home-route:hover,
  .home-route:focus-visible {
    transform: translateX(2px);
    color: #fff7ee;
  }

  .home-route__title {
    grid-area: title;
    font-family: var(--font-display, serif);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1.18;
    color: rgba(249, 244, 238, 0.98);
    transition: color 150ms ease;
  }

  .home-route:hover .home-route__title,
  .home-route:focus-visible .home-route__title {
    color: rgba(255, 224, 183, 0.98);
  }

  .home-route__description {
    grid-area: description;
    max-width: 44ch;
    font-size: 0.9rem;
    line-height: 1.55;
    color: rgba(231, 221, 206, 0.72);
  }

  .home-route__arrow {
    grid-area: arrow;
    align-self: start;
    font-size: 0.85rem;
    color: rgba(240, 205, 153, 0.82);
    transition: transform 150ms ease, color 150ms ease;
  }

  .home-route:hover .home-route__arrow,
  .home-route:focus-visible .home-route__arrow {
    transform: translateX(4px);
    color: rgba(255, 224, 183, 0.98);
  }

  .home-pledge {
    position: relative;
    width: 100dvw;
    margin: 0 calc(50% - 50dvw);
    padding: clamp(1.75rem, 4vw, 3rem) 0;
    border-top: 1px solid rgba(236, 225, 208, 0.12);
