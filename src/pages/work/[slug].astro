---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoiceExcerpt from '../../components/VoiceExcerpt.astro';
import { resolveProjectTimeline } from '../../data/linktree-timeline';
import { getAllProjects } from '../../lib/site-collections';
import { getContentVoiceExcerpt } from '../../lib/content-excerpts';

export async function getStaticPaths() {
  const projects = await getAllProjects();
  return projects
    .filter((project) => project.slug !== 'the-art-of-survival')
    .map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await project.render();
const timeline = resolveProjectTimeline(project.data);
const linkLabels: Record<string, string> = {
  confluence: 'Publication',
  untitled: 'Untitled',
  youtube: 'YouTube',
  instagram: 'Instagram',
  linktree: 'Linktree',
  github: 'GitHub'
};
const projectLinks = Object.entries(project.data.links)
  .map(([key, value]) => {
    const url = typeof value === 'string' ? value.trim() : '';
    if (!url) return null;
    const label = linkLabels[key] || key;
    const isExternal = /^https?:\/\//i.test(url);
    return { key, label, url, isExternal };
  })
  .filter((entry): entry is { key: string; label: string; url: string; isExternal: boolean } => Boolean(entry));
const projectMedia = Array.isArray(project.data.media) ? project.data.media : [];
const isVideoMedia = (src: string) => /\.(mp4|mov|webm)$/i.test(src);
const voiceExcerpt = getContentVoiceExcerpt(project, 220);

const backdropImagePaths = project.data.photo_backdrop ? [
  "/images/work/art-of-survival/isolation.jpg",
  "/images/site-selects/march-1-car-portrait.png",
  "/images/site-selects/march-17-tropical-fit.png",
  "/images/site-selects/march-20-portrait.png"
] : [];

const backdropCards = backdropImagePaths.map((src, idx) => ({
  src,
  style: [
    `position:absolute`,
    `left:${(Math.sin(idx * 39.346 + 7) * 43758.5453 % 1) * 95}%`,
    `top:${(idx / backdropImagePaths.length) * 110 + (Math.cos(idx * 53.12) * 43758.5453 % 1) * 18 - 9}%`,
    `width:160px`,
    `height:200px`,
    `object-fit:cover`,
    `transform:rotate(${(Math.sin(idx * 12.9898 + 47) * 43758.5453 % 1) * 30 - 15}deg) scale(${0.7 + (Math.cos(idx * 78.233 + 13) * 43758.5453 % 1) * 0.4})`,
    `opacity:${0.2 + (Math.sin(idx * 91.22) * 43758.5453 % 1) * 0.3}`,
    `border-radius:6px`,
    `box-shadow:0 4px 24px rgba(0,0,0,0.45)`,
    `pointer-events:none`
  ].join(';')
}));
---
<BaseLayout title={`${project.data.title} — Work`} theme="work">
  {backdropCards.length > 0 && (
    <div class="slug-photo-backdrop">
      {backdropCards.map(card => (
        <img src={card.src} alt="" aria-hidden="true" loading="lazy" decoding="async" style={card.style} />
      ))}
    </div>
  )}
  <div class="work-entry">
    <a href="/work" class="text-sm underline">← Back to Work</a>
    <h1 class="mt-2 font-display text-4xl">{project.data.title}</h1>
    <p class="mt-1 text-zinc-600 dark:text-zinc-300">{timeline.yearLabel} · {project.data.status}</p>
    <img src={project.data.cover_image} alt={project.data.title} class="mt-6 h-72 w-full rounded object-cover" width="1200" height="288" />
    <VoiceExcerpt text={voiceExcerpt} label="From the work" variant="feature" />
    <p class="mt-4">{project.data.description}</p>
    <div class="mt-4 flex flex-wrap gap-2">
      {project.data.tools.map((tool) => <span class="rounded border px-2 py-1 text-sm">{tool}</span>)}
    </div>
    {projectLinks.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-2">
        {projectLinks.map((link) => (
          <a
            href={link.url}
            class="rounded border px-3 py-1 text-sm underline"
            {...(link.isExternal ? { target: '_blank', rel: 'noopener' } : {})}
          >
            Open {link.label}
          </a>
        ))}
      </div>
    )}
    <article class="reading-prose mt-8"><Content /></article>
    {projectMedia.length > 0 && (
      <section class="project-media" aria-label="Selected media">
        <p class="project-media__eyebrow">Selected media</p>
        <div class="project-media__grid">
          {projectMedia.map((item) => (
            <figure class="project-media__item">
              {isVideoMedia(item.src) ? (
                <video src={item.src} aria-label={item.alt} controls preload="metadata" playsinline />
              ) : (
                <img src={item.src} alt={item.alt} loading="lazy" decoding="async" />
              )}
              {item.caption && <figcaption>{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .slug-photo-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
    clip-path: polygon(0 40%, 100% 40%, 100% 100%, 0 100%);
  }

  .work-entry {
    position: relative;
    isolation: isolate;
    z-index: 10;
  }

  .work-entry::before {
    content: '';
    position: absolute;
    inset: -0.95rem -1rem -1rem;
    z-index: -1;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--tone-surface) 12%, transparent);
    pointer-events: none;
  }

  .project-media {
    margin-top: 2rem;
  }

  .project-media__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.76rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--tone-text) 72%, var(--tone-muted) 28%);
  }

  .project-media__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 0.75rem;
  }

  .project-media__item {
    margin: 0;
  }

  .project-media__item img,
  .project-media__item video {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 14px;
  }

  .project-media__item video {
    background: color-mix(in srgb, var(--tone-surface) 82%, black 18%);
  }

  .project-media__item figcaption {
    margin-top: 0.45rem;
    font-size: 0.82rem;
    line-height: 1.4;
    color: color-mix(in srgb, var(--tone-text) 78%, var(--tone-muted) 22%);
  }

  @media (max-width: 480px) {
    .project-media__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
