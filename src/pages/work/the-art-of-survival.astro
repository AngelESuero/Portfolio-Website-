      ];

      return imagePaths.map((src, idx) => {
        const rotation = (Math.sin(idx * 12.9898) * 43758.5453 % 1) * 30 - 15;
        const scale = 0.7 + (Math.cos(idx * 78.233) * 43758.5453 % 1) * 0.4;
        const xPercent = (Math.sin(idx * 23.456) * 43758.5453 % 1) * 85;
        const yPercent = 35 + (Math.cos(idx * 67.890) * 43758.5453 % 1) * 50;
        const duration = 6 + (Math.sin(idx * 34.567) * 43758.5453 % 1) * 4;
        const delay = (Math.cos(idx * 56.789) * 43758.5453 % 1) * 3;

        return (
          <div
            class="photo-card"
            style={{
              left: `${xPercent}%`,
              top: `${yPercent}%`,
              transform: `rotate(${rotation}deg) scale(${scale}) translate(-50%, -50%)`,
              animationDuration: `${duration}s`,
              animationDelay: `${delay}s`
            }}
          >
            <img
              src={src}
              alt=""
              loading="lazy"
              decoding="async"
            />
          </div>
        );
      });
    })()}
  </div>

  <div class="falling-line"></div>

  <script>
    const updateLineHeight = () => {
      const pageHeight = document.documentElement.scrollHeight;
      document.documentElement.style.setProperty('--page-height', `${pageHeight}px`);
    };

    const syncLineWithScroll = () => {
      const line = document.querySelector('.falling-line');
      if (!line) return;

      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      const scrollProgress = scrollHeight > 0 ? window.scrollY / scrollHeight : 0;

      // Position the line based on scroll progress
      const scrollDistance = scrollProgress * (document.documentElement.scrollHeight - window.innerHeight);
      line.style.transform = `translateX(-50%) translateY(${scrollDistance}px)`;
    };

    updateLineHeight();
    window.addEventListener('resize', updateLineHeight);
    window.addEventListener('scroll', syncLineWithScroll, { passive: true });
  </script>
</BaseLayout>

