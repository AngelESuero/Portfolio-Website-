---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';
import CopyButton from '../components/CopyButton.astro';
import '../styles/pages/contact.css';

const sent = Astro.url.searchParams.get('sent') === '1';
const error = Astro.url.searchParams.get('error');
const deliveryUnavailable = error === 'unavailable';
const deliveryFailed = error === 'failed';

const channels = [
  {
    title: 'Instagram',
    handle: '@a_e.s_',
    href: profile.social_links.instagram,
    note: 'Fastest for direct creative reach-outs, visuals, and ongoing contact.'
  },
  {
    title: 'YouTube',
    handle: '@a_e.s_4',
    href: profile.social_links.youtube,
    note: 'Best for the public work trail, channel context, and recent uploads.'
  },
  {
    title: 'Discord',
    handle: 'Creators Corner',
    href: profile.social_links.discord_creators,
    note: 'Best for work-in-progress conversation, shared references, and faster back-and-forth.'
  },
  {
    title: 'Link hub',
    handle: 'All current routes',
    href: profile.link_hub_url,
    note: 'Use this when you want the broader map of platforms and active links.'
  }
];
---

<BaseLayout title="Contact - a_e.s_" theme="contact" bodyClass="contact-page">
  <main class="contact-shell">
    <section class="contact-hero">
      <div class="contact-hero__copy">
        <p class="contact-hero__kicker">Direct outreach</p>
        <h1>Contact</h1>
        <p class="contact-hero__lede">
          Use the verified channels below to reach Angel directly. The goal here is clarity: where to go, what it is
          for, and what is most likely to get seen.
        </p>
      </div>

      <div class="contact-hero__aside">
        <p class="contact-hero__aside-label">Fastest path</p>
        <p class="contact-hero__aside-copy">
          Instagram, YouTube, Discord, or the full link hub depending on how direct you want the contact to be.
        </p>
      </div>
    </section>

    {sent && !error && (
      <p class="contact-status contact-status--success" role="status">
        Message sent. Thank you.
      </p>
    )}

    {(deliveryUnavailable || deliveryFailed) && (
      <>
        <p class="contact-status contact-status--warning viewer-only" role="alert">
          Messaging portal is temporarily paused. Please use one of the direct links below.
        </p>
        <p class="contact-status contact-status--warning lab-only" role="alert">
          {deliveryUnavailable
            ? 'Form delivery is currently unavailable. Please use one of the direct links below.'
            : 'Contact delivery failed. Please try again later or use one of the direct links below.'}
        </p>
      </>
    )}

    <section class="contact-grid" aria-label="Verified outreach channels">
      {channels.map((channel) => (
        <article class="contact-card">
          <div class="contact-card__head">
            <div>
              <p class="contact-card__label">{channel.title}</p>
              <h2>{channel.handle}</h2>
            </div>
            <CopyButton value={channel.href} />
          </div>
          <p class="contact-card__note">{channel.note}</p>
          <a href={channel.href} class="contact-card__link" target="_blank" rel="noopener">
            Open {channel.title}
          </a>
        </article>
      ))}
    </section>

    <details class="contact-lab lab-only">
      <summary>Form testing</summary>
      <div class="contact-lab__body">
        <p>Use this form to verify delivery when lab access is enabled.</p>
        <form class="contact-form" method="post" action="/contact">
          <label>
            <span>Name</span>
            <input required name="name" />
          </label>
          <label>
            <span>Email</span>
            <input required type="email" name="email" />
          </label>
          <label>
            <span>Message</span>
            <textarea required name="message" rows="5"></textarea>
          </label>
          <button type="submit">Send</button>
        </form>
      </div>
    </details>
  </main>
</BaseLayout>

