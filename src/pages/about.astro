---
import BaseLayout from '../layouts/BaseLayout.astro';
import profile from '../data/profile';

const timelineStops = [
  {
    period: '2019–2021',
    title: 'Study: History of survival',
    description: 'Examined how oppressed populations survive across centuries. How does art come from conditions of constraint?'
  },
  {
    period: '2022',
    title: 'Field: Newark Water Coalition',
    description: 'Two years volunteering with a grassroots organization. Structural failures aren\'t abstract — they\'re in my backyard. Healing requires individuals to first heal themselves.'
  },
  {
    period: '2022–Present',
    title: 'The cycle',
    description: 'Study and creation feed each other. Every piece of work connects back to survival: how people, communities, and art persist.'
  }
];
---

<BaseLayout title="About - a_e.s_" theme="archive">
  <section class="view-surface about-page">
    <header class="view-surface-header about-page__header">
      <p class="view-surface-kicker">Profile</p>
      <h1>About</h1>
      <p class="about-page__identity">
        Angel Suero is a Newark-based music producer, visual storyteller, and community builder using sound, writing,
        and civic collaboration to turn lived process into public memory.
      </p>
      <p class="about-page__context">
        This page keeps a brief present-day frame near the top, then moves through a short development timeline kept
        close to Angel&apos;s own language.
      </p>
      <div class="about-page__roles" aria-label="Practice areas">
        {profile.roles.map((role) => <span class="chip rounded-full px-3 py-1 text-xs sm:text-sm">{role}</span>)}
      </div>
    </header>

    <section class="about-page__panel about-page__present-frame" id="current-focus">
      <p class="about-page__label">Present day</p>
      <p>
        The site holds music, writing, visuals, and active archive threads as a living record: quieter than a
        dashboard, more open than a finished portfolio shell.
      </p>
    </section>

    <section class="about-page__timeline" aria-labelledby="about-timeline-heading">
      <div class="about-page__timeline-header">
        <p class="about-page__label">Development timeline</p>
        <p class="about-page__timeline-copy" id="about-timeline-heading">
          Formation over time, with the connective text kept quiet and the record doing most of the speaking.
        </p>
      </div>

      <div class="about-page__timeline-list">
        {timelineStops.map((stop) => (
          <article class="about-page__stop">
            <header class="about-page__stop-header">
              <p class="about-page__stop-period">{stop.period}</p>
              <h2>{stop.title}</h2>
            </header>
            <p class="about-page__stop-description">{stop.description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="about-page__panel about-page__present-frame">
      <p class="about-page__label">Still current</p>
      <p>
        The present-tense throughline stays the same: music, study, Newark, and archive practice feeding one another
        rather than sitting in separate categories.
      </p>
    </section>
  </section>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: clamp(1rem, 2vw, 1.35rem);
  }

  .about-page__header {
    max-width: 68ch;
  }

  .about-page__identity,
  .about-page__context,
  .about-page__timeline-copy,
  .about-page__label,
  .about-page__panel p,
  .about-page__quote p {
    margin: 0;
  }

  .about-page__identity {
    margin-top: 0.6rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: color-mix(in srgb, var(--tone-text) 94%, var(--tone-muted) 6%);
  }

  .about-page__context {
    margin-top: 0.7rem;
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .about-page__roles {
    margin-top: 0.9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .about-page__panel,
  .about-page__stop {
    border: 1px solid var(--line2);
    border-radius: calc(var(--radius) * var(--space-scale));
    background: linear-gradient(180deg, rgba(9, 13, 22, 0.68), rgba(6, 10, 17, 0.58));
    padding: clamp(0.95rem, 2.2vw, 1.2rem);
  }

  .about-page__present-frame {
    max-width: 68ch;
  }

  .about-page__panel p:last-child {
    margin-top: 0.6rem;
    color: color-mix(in srgb, var(--tone-text) 86%, var(--tone-muted) 14%);
  }

  .about-page__timeline {
    display: grid;
    gap: 0.85rem;
  }

  .about-page__timeline-header {
    max-width: 54ch;
    display: grid;
    gap: 0.45rem;
  }

  .about-page__timeline-copy {
    color: color-mix(in srgb, var(--tone-text) 84%, var(--tone-muted) 16%);
  }

  .about-page__timeline-list {
    display: grid;
    gap: 0.9rem;
  }

  .about-page__stop {
    position: relative;
    display: grid;
    gap: 0.85rem;
    overflow: hidden;
  }

  .about-page__stop::before {
    content: '';
    position: absolute;
    inset: 1rem auto 1rem 0.9rem;
    width: 2px;
    border-radius: 999px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--tone-accent-glow) 72%, transparent 28%),
      color-mix(in srgb, var(--tone-accent) 20%, transparent 80%)
    );
    opacity: 0.78;
  }

  .about-page__stop-header {
    padding-left: 1rem;
    display: grid;
    gap: 0.25rem;
  }

  .about-page__stop-period {
    margin: 0;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tone-accent-glow);
  }

  .about-page__stop h2 {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.2;
  }

  .about-page__stop-description {
    margin: 0;
    padding-left: 1rem;
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    line-height: 1.55;
    font-size: 0.93rem;
  }

  .about-page__label {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--tone-accent-glow);
  }

  @media (max-width: 760px) {
    .about-page__stop::before {
      inset: 0.95rem auto 0.95rem 0.8rem;
    }

    .about-page__stop-header,
    .about-page__stop-quotes {
      padding-left: 0.85rem;
    }

    .about-page__quote {
      padding-left: 0.8rem;
    }
  }
</style>
