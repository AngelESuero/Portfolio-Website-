const noteGroups = Object.entries(
  notesTimeline.reduce<Record<string, (typeof notesTimeline)[number][]>>((groups, entry) => {
    const year = entry.sortKey.slice(0, 4);
    const bucket = groups[year] ?? [];
    bucket.push(entry);
    groups[year] = bucket;
    return groups;
  }, {})
).sort(([left], [right]) => left.localeCompare(right));

const noteCount = notesTimeline.length;
---

<BaseLayout
  title="Human Suffering — Problems"
  description={humanSufferingVoice}
  theme="survival"
  bodyClass="human-suffering-page"
  forceThemeMode="dark"
  flatSurface={true}
  ambientEffects={false}
>
  <main class="human-suffering-shell">
    <section class="human-suffering-hero" data-reveal>
      <div class="human-suffering-hero__copy">
        <p class="human-suffering-hero__kicker">Problem record</p>
        <h1>Human Suffering</h1>
        <p class="human-suffering-hero__lede">
          Fear, voice, loneliness, grief, support, and practice. The page keeps listening for the shape of pain and
          the step that can be repeated.
        </p>

        <blockquote class="human-suffering-hero__voice" aria-label="Source voice">
          <p>{humanSufferingVoice}</p>
          <footer>
            <span>Source voice</span>
            <span>{post.data.title}</span>
          </footer>
        </blockquote>

        <div class="human-suffering-hero__links">
          <a href="/work/the-art-of-survival">Connected work</a>
          <a href="/writing/human-suffering-and-practice">Writing record</a>
          <a href="#notes-ledger">Open notes ledger</a>
        </div>
      </div>

      <aside class="human-suffering-route" data-reveal aria-label="Route details">
        <div class="human-suffering-route__intro">
          <p class="human-suffering-route__label">Route</p>
          <p class="human-suffering-route__lede">
            The listening narrows toward practice, not a final answer.
          </p>
        </div>

        <div class="human-suffering-route__section">
          <p class="human-suffering-route__section-label">Earlier stops</p>
          <ul class="human-suffering-route__sites" aria-label="Verified influence sites">
            {earlierStops.map((item) => (
