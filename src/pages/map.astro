---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeMapTabs from '../../app/components/LifeMapTabs';
import '../styles/pages/map.css';
---

<BaseLayout
  title="Organizational Atlas - a_e.s_"
  theme="archive"
  bodyClass="map-page"
  showHeader={true}
  renderHeader={true}
  renderFooter={false}
  fullBleed={true}
  ambientEffects={true}
  viewTransitions={false}
>
  <div class="map-page-intro">
    <p class="map-kicker">Life Map</p>
    <h1 class="map-title">Organizational Atlas</h1>
    <p class="map-dek">A systems view of a life, now with both an atlas view and an unfurling reading view for the same material.</p>
    <div class="map-phase-legend">
      <span class="map-phase map-phase--platform">Platform</span>
      <span class="map-phase-sep">·</span>
      <span class="map-phase map-phase--emergence">Emergence</span>
      <span class="map-phase-sep">·</span>
      <span class="map-phase map-phase--offering">Offering</span>
    </div>
  </div>
  <div class="map-divider" aria-hidden="true"></div>
  <LifeMapTabs client:load />
</BaseLayout>

