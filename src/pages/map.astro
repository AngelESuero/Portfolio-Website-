---
import BaseLayout from '../layouts/BaseLayout.astro';
import LifeMapTabs from '../../app/components/LifeMapTabs';
---

<BaseLayout
  title="Organizational Atlas - a_e.s_"
  theme="archive"
  bodyClass="map-page"
  showHeader={true}
  renderHeader={true}
  renderFooter={false}
  fullBleed={true}
  ambientEffects={true}
  viewTransitions={false}
>
  <div class="map-page-intro">
    <p class="map-kicker">Life Map</p>
    <h1 class="map-title">Organizational Atlas</h1>
    <p class="map-dek">A systems view of a life, now with both an atlas view and an unfurling reading view for the same material.</p>
    <div class="map-phase-legend">
      <span class="map-phase map-phase--platform">Platform</span>
      <span class="map-phase-sep">·</span>
      <span class="map-phase map-phase--emergence">Emergence</span>
      <span class="map-phase-sep">·</span>
      <span class="map-phase map-phase--offering">Offering</span>
    </div>
  </div>
  <div class="map-divider" aria-hidden="true"></div>
  <LifeMapTabs client:only="react" />
</BaseLayout>

<style>
  :global(body.map-page) {
    background:
      radial-gradient(54rem 32rem at 14% 6%, var(--street-warm), transparent 70%),
      radial-gradient(46rem 28rem at 86% 10%, var(--street-cool), transparent 72%),
      linear-gradient(180deg, color-mix(in srgb, var(--tone-bg-deep) 92%, black), var(--tone-bg));
  }

  .map-page-intro {
    max-width: 1440px;
    margin: 0 auto;
    padding: 2rem 1.5rem 0;
  }

  .map-kicker {
    margin: 0 0 0.5rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--tone-accent);
  }

  .map-title {
    margin: 0 0 0.6rem;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .map-dek {
    margin: 0 0 1rem;
    max-width: 56ch;
    font-size: 0.88rem;
    line-height: 1.65;
    color: var(--tone-muted);
  }

  .map-phase-legend {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  .map-phase {
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.22em;
  }

  .map-phase--platform  { color: #d8c18f; }
  .map-phase--emergence { color: #8fbfd8; }
  .map-phase--offering  { color: #a8d8a8; }

  .map-phase-sep {
    font-size: 0.6rem;
    color: var(--tone-muted);
    opacity: 0.4;
  }

  .map-divider {
    max-width: 1440px;
    margin: 1.5rem auto 0;
    padding: 0 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--tone-line) 92%, rgba(255,255,255,0.03));
  }

  @media (max-width: 640px) {
    .map-page-intro {
      padding: 1.25rem 1rem 0;
    }
    .map-divider {
      padding: 0 1rem;
    }
  }
</style>
