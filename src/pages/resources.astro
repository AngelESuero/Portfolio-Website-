---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/pages/resources.css';

const framework = [
  {
    number: 1,
    label: 'Well-Being',
    description: 'Physical and mental health, daily routine, self-care',
  },
  {
    number: 2,
    label: 'Growth',
    description: 'Learning, education, spiritual practice, self-improvement',
  },
  {
    number: 3,
    label: 'Relationships',
    description: 'Family, friends, love, community, emotional connection',
  },
    {
      number: 4,
      label: 'Work',
      description: 'Career, job performance, productivity, skill development',
      files: [
        { label: 'Gallery Host Plus (GH+) Proposal', href: '/documents/gh-plus-proposal.pdf' },
        { label: 'NMOA proposal ecosystem', href: '/resources/nmoa-proposal-ecosystem' },
      ],
    },
  {
    number: 5,
    label: 'Creativity',
    description: 'Artistic projects, music production, writing, design',
    files: [
      { label: 'Cocoa — reference doc', href: '/documents/cocoa.pdf' },
      { label: 'Script End-6', href: '/documents/script-end-6.pdf' },
      { label: 'Script — Night, Mother Project', href: '/documents/script-night-mother-project.pdf' },
      { label: 'Sensitive Child — Graphic Novel Script', href: '/documents/sensitive-child-script.docx' },
      { label: 'Sensitive Child — Presentation', href: '/documents/sensitive-child-presentation.pptx' },
      { label: 'Stranger Things Bible (Montauk)', href: '/documents/stranger-things-bible.docx' },
    ],
  },
  {
    number: 6,
    label: 'Activity',
    description: 'Physical expression, exercise, boxing',
    files: [
      { label: 'Marvel Multiverse Timeline', href: '/documents/marvel_multiverse_timeline_with_tv.pdf' },
    ],
  },
  {
    number: 7,
    label: 'Resources',
    description: 'Finances, housing, material stability, basic needs',
    files: [
      { label: 'Livable Income Levels — Newark, NJ', href: '/documents/livable-income-newark.pdf' },
      { label: 'Graham Stephan YouTube channel', href: 'https://www.youtube.com/@GrahamStephan' },
    ],
  },
  {
    number: 8,
    label: 'Order',
    description: 'Organization, structure, ethics, discipline',
  },
  {
    number: 9,
    label: 'Society',
    description: 'Collective contribution, civic awareness, culture, systems',
    files: [
      { label: 'Retrofitting Bernie\'s GND for the AI Era', href: '/documents/retrofitting-bernie-gnd-ai-era.pdf' },
    ],
  },
];
---

<BaseLayout
  title="Resources — a_e.s_"
  description="A 9-part framework for practical life alignment and balance across all domains."
  theme="archive"
  bodyClass="resources-page"
  flatSurface={true}
  forceThemeMode="dark"
>
  <main class="resources-main">
    <section class="resources-header">
      <p class="resources-eyebrow">Life Alignment Framework</p>
      <h1 class="resources-title">Resources</h1>
      <p class="resources-subtitle">
        A 9-part framework for practical life alignment and balance across all domains.
      </p>
    </section>

    <ol class="resources-list" aria-label="9-part life alignment framework">
      {framework.map((item) => (
        <li class="resources-item">
          <span class="resources-number" aria-hidden="true">{item.number}</span>
          <div class="resources-content">
            <strong class="resources-label">{item.label}</strong>
            <span class="resources-desc">{item.description}</span>
            {item.files && (
              <ul class="resources-files">
                {item.files.map((f) => (
                  <li>
                    <a href={f.href} target="_blank" rel="noopener" class="resources-file-link">{f.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ol>
  </main>
</BaseLayout>

