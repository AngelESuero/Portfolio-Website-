      radial-gradient(54rem 30rem at 84% 2%, rgba(29, 155, 240, 0.12), transparent 64%);
  }

  .signal-desk {
    margin-bottom: 1rem;
    border: 1px solid color-mix(in srgb, var(--tone-accent) 24%, var(--line2));
