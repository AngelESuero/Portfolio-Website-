    padding: 0.95rem 1rem;
    background:
      linear-gradient(180deg, rgba(29, 155, 240, 0.12), rgba(29, 155, 240, 0.02)),
      color-mix(in srgb, var(--tone-surface) 88%, transparent);
  }

  .signal-desk__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
