    display: grid;
    gap: 0.5rem;
  }

  .analyst-filter {
    cursor: pointer;
    transition: border-color 160ms ease, background 160ms ease, transform 140ms ease;
  }

  .analyst-filter.is-active {
    border-color: color-mix(in srgb, var(--tone-accent) 68%, var(--line2));
    background:
      linear-gradient(180deg, rgba(29, 155, 240, 0.26), rgba(29, 155, 240, 0.1)),
      color-mix(in srgb, var(--tone-surface-strong) 80%, transparent);
    transform: translateY(-1px);
  }
</style>
