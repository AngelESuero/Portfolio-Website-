  .signal-desk__lane {
    border: 1px solid color-mix(in srgb, var(--tone-accent) 16%, var(--line2));
    border-radius: 0.82rem;
    padding: 0.65rem 0.7rem;
    background: color-mix(in srgb, var(--tone-surface-strong) 76%, transparent);
  }

  .signal-desk__lane h4 {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.35;
  }

  .signal-desk__lane ul {
    margin: 0.55rem 0 0;
    padding-left: 1rem;
    display: grid;
    gap: 0.36rem;
  }

  .signal-desk__lane li {
    display: grid;
    gap: 0.14rem;
  }

  .signal-desk__lane li a {
    color: color-mix(in srgb, var(--tone-text) 88%, var(--tone-muted) 12%);
    text-decoration: none;
  }

  .signal-desk__lane li span {
    font-size: 0.8rem;
    color: color-mix(in srgb, var(--tone-text) 68%, var(--tone-muted) 32%);
