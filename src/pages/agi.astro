      radial-gradient(46rem 26rem at 18% 10%, rgba(56, 114, 168, 0.12), transparent 62%),
      linear-gradient(180deg, #0a1018 0%, #070c13 48%, #03060a 100%);
    color: var(--tone-text);
  }

  :global(body.agi-x-page .site-overlay) {
